val format = use("../src/lang/format.sx")
val u = use("../src/core/util.sx")

test "formatter normalizes braces, indentation and assignments" {
    trust {
        val src: ref u8 = c"fn main()\n{\n\tx = 1\n\tlonger = 2\n\tsay(\"hi\")\n}\n"
        val want: ref u8 = c"fn main() {\n    x      = 1\n    longer = 2\n    say(\"hi\")\n}\n"
        assert u.s_eq(format.format_text(src), want)
    }
}

test "formatter prefers parenthesized calls" {
    trust {
        val src: ref u8 = c"say \"hello\"\nwhich \"spectre\"\nif not which \"spectre\" {\n    say join(\"/a\", \"b\")\n}\nobj.method(\"x\")\nfn f(a) { return a }\n"
        val want: ref u8 = c"say(\"hello\")\nwhich(\"spectre\")\nif not which(\"spectre\") {\n    say(join(\"/a\", \"b\"))\n}\nobj.method(\"x\")\nfn f(a) { return a }\n"
        assert u.s_eq(format.format_text(src), want)
    }
}

test "formatter joins allman else with closing braces" {
    trust {
        val src: ref u8 = c"if true\n{\n    say(\"a\")\n}\nelse\n{\n    say(\"b\")\n}\n"
        val want: ref u8 = c"if true {\n    say(\"a\")\n} else {\n    say(\"b\")\n}\n"
        assert u.s_eq(format.format_text(src), want)
    }
}

test "formatter preserves comments and raw strings" {
    trust {
        val src: ref u8 = c"# top\nx = r\"a\\{b}\" # keep\n\nsay(x)\n"
        val want: ref u8 = c"# top\nx = r\"a\\{b}\" # keep\n\nsay(x)\n"
        assert u.s_eq(format.format_text(src), want)
    }
}

test "formatter keeps shell commands unparenthesized" {
    trust {
        val src: ref u8 = c"echo \"hi\"\ngit status --short\n"
        assert u.s_eq(format.format_text(src), src)
    }
}

test "formatter parenthesizes multi-argument say" {
    trust {
        val src: ref u8 = c"say \"a\", \"b\"\n"
        assert u.s_eq(format.format_text(src), c"say(\"a\", \"b\")\n")
    }
}

test "formatter is idempotent" {
    trust {
        val src: ref u8 = c"if true\n{\n  x   = 1\n  a_b = 2\n  say(\"hi\")\n}\n"
        val once: ref u8 = format.format_text(src)
        val twice: ref u8 = format.format_text(once)
        assert u.s_eq(once, twice)
    }
}

test "formatter walks directories and filters Blood scripts" {
    trust {
        val dir: ref u8 = c"/tmp/blood-unit-format-dir"
        val sub: ref u8 = u.path_join(dir, c"nested")
        assert u.mkdir_p(sub)
        val one: ref u8 = u.path_join(dir, c"one.bx")
        val two: ref u8 = u.path_join(sub, c"two.blood")
        val other: ref u8 = u.path_join(dir, c"keep.txt")
        assert u.write_file(one, c"if true\n{\n  say(\"one\")\n}\n")
        assert u.write_file(two, c"if true\n{\n  say(\"two\")\n}\n")
        assert u.write_file(other, c"if true\n{\n  say(\"keep\")\n}\n")
        assert format.format_path(dir) == 0
        assert u.s_eq(u.read_file(one), c"if true {\n    say(\"one\")\n}\n")
        assert u.s_eq(u.read_file(two), c"if true {\n    say(\"two\")\n}\n")
        assert u.s_eq(u.read_file(other), c"if true\n{\n  say(\"keep\")\n}\n")
    }
}

test "formatter writes files in place" {
    trust {
        val dir: ref u8 = c"/tmp/blood-unit-format"
        assert u.mkdir_p(dir)
        val path: ref u8 = u.path_join(dir, c"sample.bx")
        assert u.write_file(path, c"if true\n{\n  say(\"hi\")\n}\n")
        assert format.format_file(path) == 0
        assert u.s_eq(u.read_file(path), c"if true {\n    say(\"hi\")\n}\n")
    }
}

test "formatter aligns consecutive var declarations" {
    trust {
        val src: ref u8 = c"var something = \"hello\"\nvar something_else = \"hello, world\"\n"
        val want: ref u8 = c"var something      = \"hello\"\nvar something_else = \"hello, world\"\n"
        assert u.s_eq(format.format_text(src), want)
    }
}

test "formatter indents and aligns bulk var declarations" {
    trust {
        val src: ref u8 = c"var (\nsome_variable = \"hello\"\nsome_other_variable = \"world\"\n)\n"
        val want: ref u8 = c"var (\n    some_variable       = \"hello\"\n    some_other_variable = \"world\"\n)\n"
        assert u.s_eq(format.format_text(src), want)
    }
}
