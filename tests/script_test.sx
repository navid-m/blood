val script = use("../src/lang/script.sx")
val u = use("../src/core/util.sx")

val g_shell_runs: mut i64 = 0

fn fresh() void = trust {
    script.script_init()
}

fn run(src: ref u8) i32 = trust {
    return script.run_text(src, false, c"test")
}

fn fake_capture(cmd: ref u8) ref u8 = trust {
    return u.s_cat(c"captured:", cmd)
}

fn fake_shell(cmd: ref u8) i32 = trust {
    if u.s_len(cmd) > 0 {
        g_shell_runs = g_shell_runs + 1
    }
    return 4
}

test "script runs arithmetic, comparison and boolean expressions" {
    trust {
        fresh()
        val src: ref u8 = c"if 2 + 3 * 4 != 14 {\n    raise \"arith\"\n}\nif (2 + 3) * 4 != 20 {\n    raise \"parens\"\n}\nif 7 / 2 != 3 {\n    raise \"division\"\n}\nif 7 % 2 != 1 {\n    raise \"modulo\"\n}\nif not (1 < 2 and 2 <= 2 and 3 > 2 and 3 >= 3 and 1 != 2) {\n    raise \"compare\"\n}\nif not (true and not false) {\n    raise \"boolean\"\n}\nif \"abc\" == \"abc\" {\n    pass\n} else {\n    raise \"string equality\"\n}\nif \"abc\" != \"abd\" {\n    pass\n} else {\n    raise \"string inequality\"\n}\n"
        assert run(src) == 0
    }
}

test "script supports string methods and indexing" {
    trust {
        fresh()
        val src: ref u8 = c"var s = \"  Hello World  \"\nif s.strip() != \"Hello World\" {\n    raise \"strip\"\n}\nif s.upper().strip() != \"HELLO WORLD\" {\n    raise \"upper\"\n}\nif s.lower().strip() != \"hello world\" {\n    raise \"lower\"\n}\nvar parts = \"a,b,c\".split(\",\")\nif std.len(parts) != 3 {\n    raise \"split length\"\n}\nif parts[1] != \"b\" {\n    raise \"split value\"\n}\nif \"-\".join([\"a\", \"b\", \"c\"]) != \"a-b-c\" {\n    raise \"join\"\n}\nif \"banana\".replace(\"a\", \"o\") != \"bonono\" {\n    raise \"replace\"\n}\nif \"abc\".startswith(\"ab\") != true {\n    raise \"startswith\"\n}\nif \"abc\".endswith(\"bc\") != true {\n    raise \"endswith\"\n}\nif \"abc\".contains(\"b\") != true {\n    raise \"contains\"\n}\nif \"hello\"[1] != \"e\" {\n    raise \"index\"\n}\nif \"hello\"[-1] != \"o\" {\n    raise \"negative index\"\n}\nif \"hello\".chars().len() != 5 {\n    raise \"chars\"\n}\n"
        assert run(src) == 0
    }
}

test "script supports list mutation and methods" {
    trust {
        fresh()
        val src: ref u8 = c"var xs = [3, 1, 2]\nxs.append(4)\nif std.len(xs) != 4 {\n    raise \"append\"\n}\nxs.sort()\nif xs[0] != 1 or xs[3] != 4 {\n    raise \"sort\"\n}\nif 2 not in xs {\n    raise \"membership\"\n}\nif xs.contains(3) != true {\n    raise \"contains\"\n}\nif xs.join(\"-\") != \"1-2-3-4\" {\n    raise \"join\"\n}\nif xs.pop() != 4 {\n    raise \"pop\"\n}\nif xs.len() != 3 {\n    raise \"len\"\n}\nxs.insert(0, 9)\nif xs[0] != 9 {\n    raise \"insert\"\n}\nxs.remove(0)\nif xs[0] != 1 {\n    raise \"remove\"\n}\nxs[0] = 5\nif xs[0] != 5 {\n    raise \"index assignment\"\n}\nif xs[-1] != 3 {\n    raise \"negative index\"\n}\n"
        assert run(src) == 0
    }
}

test "script supports list map filter and count with lambdas" {
    trust {
        fresh()
        val src: ref u8 = c"var xs = [1, 2, 3, 4]\nvar doubled = xs.map(|x| x * 2)\nif doubled.join(\",\") != \"2,4,6,8\" {\n    raise \"map\"\n}\nvar evens = xs.filter(|x| x % 2 == 0)\nif evens.join(\",\") != \"2,4\" {\n    raise \"filter\"\n}\nif xs.count(|x| x > 2) != 2 {\n    raise \"count predicate\"\n}\nif xs.count() != 4 {\n    raise \"count\"\n}\nvar threshold = 2\nif xs.count(|x| x > threshold) != 2 {\n    raise \"count closure\"\n}\nfn make_adder(n) {\n    return |x| x + n\n}\nvar add_ten = make_adder(10)\nif add_ten(5) != 15 {\n    raise \"closure\"\n}\nvar long = [\"a\", \"longer\", \"tiny\"].filter(|s| {\n    return s.len() > 4\n})\nif long.join(\",\") != \"longer\" {\n    raise \"block lambda\"\n}\nif [\"[pass] a\", \"[fail] b\", \"[pass] c\"].count(|l| l.starts_with(\"[pass]\")) != 2 {\n    raise \"pass count\"\n}\n"
        assert run(src) == 0
    }
}

test "script exposes builtins through the std namespace" {
    trust {
        fresh()
        val src: ref u8 = c"if std.len([1, 2, 3]) != 3 {\n    raise \"std.len\"\n}\nif std.str(42) != \"42\" {\n    raise \"std.str\"\n}\nif std.range(3).join(\",\") != \"0,1,2\" {\n    raise \"std.range\"\n}\nif std.type(std.len) != \"function\" {\n    raise \"std function value\"\n}\nvar f = std.str\nif f(9) != \"9\" {\n    raise \"std function\"\n}\ntry {\n    var x = len([1])\n} catch err {\n    if \"std.\" not in err {\n        raise \"std hint\"\n    }\n}\n"
        assert run(src) == 0
    }
}

test "script classifies existing .blood and .bx files as commands" {
    trust {
        val dir: ref u8 = c"/tmp/blood-unit-script/exts"
        assert u.mkdir_p(dir)
        val blood_file: ref u8 = u.path_join(dir, c"sample.blood")
        val bx_file: ref u8 = u.path_join(dir, c"sample.bx")
        assert u.write_file(blood_file, c"say \"blood\"\n")
        assert u.write_file(bx_file, c"say \"bx\"\n")
        assert !script.looks_like_script(blood_file)
        assert !script.looks_like_script(bx_file)
    }
}

test "script supports dictionaries and attributes" {
    trust {
        fresh()
        val src: ref u8 = c"var d = {\"a\": 1, \"b\": 2}\nif d[\"a\"] != 1 {\n    raise \"index\"\n}\nif d.get(\"z\", 9) != 9 {\n    raise \"get default\"\n}\nif d.contains(\"b\") != true {\n    raise \"contains\"\n}\nd[\"c\"] = 3\nif std.len(d) != 3 {\n    raise \"len\"\n}\nif d.len() != 3 {\n    raise \"method len\"\n}\nvar keys = d.keys()\nkeys.sort()\nif keys[0] != \"a\" or keys[2] != \"c\" {\n    raise \"keys\"\n}\nif std.len(d.values()) != 3 {\n    raise \"values\"\n}\nif std.len(d.items()) != 3 {\n    raise \"items\"\n}\nd.remove(\"a\")\nif d.contains(\"a\") {\n    raise \"remove\"\n}\nd.set(\"x\", 5)\nif d[\"x\"] != 5 {\n    raise \"set\"\n}\nd.a = 9\nif d[\"a\"] != 9 or d.a != 9 {\n    raise \"attribute\"\n}\n"
        assert run(src) == 0
    }
}

test "script export assignments update the environment" {
    trust {
        fresh()
        val src: ref u8 = c"export BLOOD_TEST_EXPORT = [\"a\", \"b\"].join(\":\")\nif std.env(\"BLOOD_TEST_EXPORT\") != \"a:b\" {\n    raise \"export env\"\n}\nif BLOOD_TEST_EXPORT != \"a:b\" {\n    raise \"export value\"\n}\n"
        assert run(src) == 0
        assert u.s_eq(u.env_get(c"BLOOD_TEST_EXPORT"), c"a:b")
        u.env_unset(c"BLOOD_TEST_EXPORT")
    }
}

test "script run and shell return result objects" {
    trust {
        fresh()
        val src: ref u8 = c"var r = run([\"sh\", \"-c\", \"printf out; printf err >&2; exit 3\"])\nif r.status != 3 or r.ok or r.stdout != \"out\" or r.stderr != \"err\" {\n    raise \"run result\"\n}\nvar m = run([\"sh\", \"-c\", \"printf out; printf err >&2\"], merge_stderr: true)\nif m.stdout != \"outerr\" or m.stderr != \"\" {\n    raise \"merge stderr\"\n}\n"
        assert run(src) == 0
    }
}

test "script defers run LIFO on return and errors" {
    trust {
        fresh()
        val src: ref u8 = c"var log = []\nfn ok() {\n    defer { log.append(\"a\") }\n    defer { log.append(\"b\") }\n    return 1\n}\nfn bad() {\n    defer { log.append(\"c\") }\n    raise \"boom\"\n}\nok()\ntry {\n    bad()\n} catch err {\n    if err != \"boom\" {\n        raise \"error lost\"\n    }\n}\nif log.join(\"\") != \"bac\" {\n    raise \"defer order\"\n}\n"
        assert run(src) == 0
    }
}

test "script filesystem, path and cd builtins" {
    trust {
        fresh()
        val old: ref u8 = u.cwd()
        val src: ref u8 = c"var dir = std.mktemp_dir(\"blood-script-test\")\nif not std.is_dir(dir) {\n    raise \"mktemp_dir\"\n}\nvar file = std.join(dir, \"a.txt\")\nstd.write_file(file, \"hello\")\nif not std.exists(file) or not std.is_file(file) or std.is_dir(file) {\n    raise \"file checks\"\n}\nif std.basename(file) != \"a.txt\" or std.stem(file) != \"a\" {\n    raise \"path names\"\n}\nif std.parent(file) != dir {\n    raise \"parent\"\n}\ncd(dir)\nif run([\"pwd\"]).stdout.strip() != dir {\n    raise \"cd\"\n}\nstd.remove_all(dir)\nif std.exists(dir) {\n    raise \"remove_all\"\n}\n"
        assert run(src) == 0
        u.chdir(old)
    }
}

test "script supports compound assignment" {
    trust {
        fresh()
        val src: ref u8 = c"var n = 17\nn %= 5\nif n != 2 {\n    raise \"modulo assign\"\n}\nn += 3\nif n != 5 {\n    raise \"add assign\"\n}\nn -= 1\nif n != 4 {\n    raise \"subtract assign\"\n}\nn *= 3\nif n != 12 {\n    raise \"multiply assign\"\n}\nn /= 5\nif n != 2 {\n    raise \"divide assign\"\n}\nvar s = \"a\"\ns += \"b\"\nif s != \"ab\" {\n    raise \"string add assign\"\n}\n"
        assert run(src) == 0
    }
}

test "script glob returns sorted matching paths" {
    trust {
        fresh()
        val root: ref u8 = c"/tmp/blood-unit-script/glob"
        assert u.mkdir_p(root)
        assert u.write_file(u.path_join(root, c"b.blood"), c"")
        assert u.write_file(u.path_join(root, c"a.blood"), c"")
        assert u.write_file(u.path_join(root, c"c.txt"), c"")
        val old: ref u8 = u.cwd()
        assert u.chdir(root) == 0
        val src: ref u8 = c"var files = std.glob(\"*.blood\")\nif std.len(files) != 2 {\n    raise \"length\"\n}\nif files[0] != \"a.blood\" or files[1] != \"b.blood\" {\n    raise \"sorted\"\n}\nif std.len(std.glob(\"missing*\")) != 0 {\n    raise \"empty\"\n}\n"
        val st: i32 = run(src)
        assert u.chdir(old) == 0
        assert st == 0
    }
}

test "script rename moves and renames paths" {
    trust {
        fresh()
        val root: ref u8 = c"/tmp/blood-unit-script/rename"
        assert u.mkdir_p(root)
        assert u.write_file(u.path_join(root, c"a.blood"), c"a")
        val old: ref u8 = u.cwd()
        assert u.chdir(root) == 0
        val src: ref u8 = c"if std.rename(\"a.blood\", \"a.bx\") == false {\n    raise \"rename\"\n}\nif std.len(std.glob(\"a.blood\")) != 0 {\n    raise \"source remains\"\n}\nif std.len(std.glob(\"a.bx\")) != 1 {\n    raise \"target missing\"\n}\nif std.rename(\"missing\", \"x\") {\n    raise \"missing should fail\"\n}\n"
        val st: i32 = run(src)
        assert u.chdir(old) == 0
        assert st == 0
    }
}

test "script supports loops, break and continue" {
    trust {
        fresh()
        val src: ref u8 = c"var total = 0\nfor i in std.range(1, 11) {\n    if i == 3 {\n        continue\n    }\n    if i == 9 {\n        break\n    }\n    total += i\n}\nif total != 33 {\n    raise \"for loop\"\n}\nvar n = 0\nwhile n < 5 {\n    n += 1\n}\nif n != 5 {\n    raise \"while loop\"\n}\nvar count = 0\nfor ch in \"abc\" {\n    count += 1\n}\nif count != 3 {\n    raise \"string loop\"\n}\nvar values = []\nfor x in [1, 2, 3] {\n    values.append(x * 2)\n}\nif values.join(\",\") != \"2,4,6\" {\n    raise \"list loop\"\n}\n"
        assert run(src) == 0
    }
}

test "script supports functions and recursion" {
    trust {
        fresh()
        val src: ref u8 = c"fn fact(n) {\n    if n <= 1 {\n        return 1\n    }\n    return n * fact(n - 1)\n}\nif fact(5) != 120 {\n    raise \"factorial\"\n}\nfn add(a, b) {\n    return a + b\n}\nif add(2, 3) != 5 {\n    raise \"add\"\n}\nfn outer(n) {\n    return add(n, fact(3))\n}\nif outer(10) != 16 {\n    raise \"nested call\"\n}\n"
        assert run(src) == 0
    }
}

test "script supports try, catch and raise" {
    trust {
        fresh()
        val src: ref u8 = c"var caught = \"\"\ntry {\n    raise \"oops\"\n} catch err {\n    caught = err\n}\nif caught != \"oops\" {\n    raise \"catch\"\n}\ntry {\n    var x = missing_value\n} catch err {\n    caught = err\n}\nif \"undefined\" not in caught {\n    raise \"undefined variable\"\n}\ntry {\n    var z = 1 / 0\n} catch err {\n    caught = err\n}\nif \"division\" not in caught {\n    raise \"division by zero\"\n}\n"
        assert run(src) == 0
    }
}

test "script supports string interpolation" {
    trust {
        fresh()
        val src: ref u8 = c"var name = \"world\"\nif \"hello {name}\" != \"hello world\" {\n    raise \"variable\"\n}\nvar expected = std.chr(123) + \"braces\" + std.chr(125)\nif \"literal {{braces}}\" != \"literal \" + expected {\n    raise \"escaped braces\"\n}\nif \"math {1 + 2}\" != \"math 3\" {\n    raise \"expression\"\n}\nvar n = 4\nif \"{n * n}\" != \"16\" {\n    raise \"nested expression\"\n}\n"
        assert run(src) == 0
    }
}

test "script supports brace block style" {
    trust {
        fresh()
        val src: ref u8 = c"fn main {\n    var total = 0\n    for i in std.range(4) {\n        total += i\n    }\n    if total != 6 {\n        raise \"brace loop\"\n    }\n}\nmain()\n"
        assert run(src) == 0
    }
}

test "script exposes arguments, status and exit" {
    trust {
        fresh()
        val args: mut ref u.Vec = u.vec_new()
        u.vec_pushp(args, c"alpha" as ref void)
        u.vec_pushp(args, c"beta" as ref void)
        script.set_args(args)
        val src: ref u8 = c"if std.len(args) != 2 {\n    raise \"argc\"\n}\nif args[0] != \"alpha\" {\n    raise \"argv0\"\n}\nif args[1] != \"beta\" {\n    raise \"argv1\"\n}\n"
        assert run(src) == 0
        assert run(c"exit(std.len(args))") == 2
        assert run(c"exit(0)") == 0
        assert run(c"exit(7)") == 7

        script.set_external_status(5)
        assert script.status_value() == 5
        assert run(c"if status != 5 {\n    raise \"status\"\n}\n") == 0
    }
}

test "script reports parse and evaluation errors" {
    trust {
        fresh()
        assert run(c"if true\n") == 2
        assert run(c"var x = missing_value\n") == 1
        assert run(c"raise \"boom\"\n") == 1
        assert run(c"var z = 1 / 0\n") == 1
        assert !script.has_error()
    }
}

test "script supports command substitution hooks" {
    trust {
        fresh()
        val old_hook: fn(ref u8) ref u8 = u.run_capture_hook
        val old_ready: i64 = u.hooks_ready
        u.run_capture_hook = fake_capture
        u.hooks_ready = 1

        val src: ref u8 = c"var a = `cmd`\nif a != \"captured:cmd\" {\n    raise \"backtick\"\n}\nvar b = $(other)\nif b != \"captured:other\" {\n    raise \"dollar\"\n}\n"
        assert run(src) == 0

        u.run_capture_hook = old_hook
        u.hooks_ready = old_ready
    }
}

test "script runs shell command statements through the hook" {
    trust {
        fresh()
        g_shell_runs = 0
        val old_hook: fn(ref u8) i32 = u.run_shell_hook
        val old_ready: i64 = u.hooks_ready
        u.run_shell_hook = fake_shell
        u.hooks_ready = 1

        val src: ref u8 = c"echo hello\nif status != 4 {\n    raise \"status\"\n}\n"
        assert run(src) == 0
        assert g_shell_runs == 1

        u.run_shell_hook = old_hook
        u.hooks_ready = old_ready
    }
}

test "script file natives read, write and append" {
    trust {
        fresh()
        val dir: ref u8 = c"/tmp/blood-unit-script"
        assert u.mkdir_p(dir)
        val src: ref u8 = c"var path = \"/tmp/blood-unit-script/note.txt\"\nif std.write_file(path, \"abc\") != true {\n    raise \"write\"\n}\nif std.read_file(path) != \"abc\" {\n    raise \"read\"\n}\nif std.append_file(path, \"def\") != true {\n    raise \"append\"\n}\nif std.read_file(path) != \"abcdef\" {\n    raise \"read append\"\n}\nif std.read_file(\"/tmp/blood-unit-script/missing\") != null {\n    raise \"missing\"\n}\n"
        assert run(src) == 0
    }
}

test "script builtins convert types and aggregate values" {
    trust {
        fresh()
        val src: ref u8 = c"if std.len([1, 2]) != 2 {\n    raise \"len\"\n}\nif std.str(42) != \"42\" {\n    raise \"str\"\n}\nif std.int(\"17\") != 17 {\n    raise \"int\"\n}\nif std.type(1) != \"int\" {\n    raise \"type int\"\n}\nif std.type(\"x\") != \"string\" {\n    raise \"type string\"\n}\nif std.type([]) != \"list\" {\n    raise \"type list\"\n}\nif std.type({}) != \"dict\" {\n    raise \"type dict\"\n}\nif std.min([3, 1, 2]) != 1 {\n    raise \"min\"\n}\nif std.max([3, 1, 2]) != 3 {\n    raise \"max\"\n}\nif std.sum([1, 2, 3]) != 6 {\n    raise \"sum\"\n}\nif std.abs(-4) != 4 {\n    raise \"abs\"\n}\nif std.ord(\"A\") != 65 {\n    raise \"ord\"\n}\nif std.chr(66) != \"B\" {\n    raise \"chr\"\n}\nif std.len(std.range(3)) != 3 {\n    raise \"range\"\n}\nif std.len(std.range(2, 5)) != 3 {\n    raise \"range start\"\n}\nif std.bool(0) != false or std.bool(1) != true {\n    raise \"bool\"\n}\nif std.clock() <= 0 {\n    raise \"clock\"\n}\n"
        assert run(src) == 0
    }
}

test "script runs parallel for iterations" {
    trust {
        fresh()
        assert run(c"para for x in [1, 2, 3] {\n    pass\n}\nif x != 3 {\n    raise \"last item\"\n}\n") == 0
        assert run(c"para for x in [0, 1, 2] {\n    if x == 2 {\n        exit(3)\n    }\n}\nif status != 3 {\n    raise \"parallel status\"\n}\n") == 0
    }
}

test "script detects lines that need continuation" {
    trust {
        assert script.needs_continuation(c"echo hi \\")
        assert script.needs_continuation(c"if true {")
        assert script.needs_continuation(c"while true {")
        assert script.needs_continuation(c"para for x in xs {")
        assert script.needs_continuation(c"fn main {")
        assert script.needs_continuation(c"say \"open")
        assert script.needs_continuation(c"[1, 2")
        assert script.needs_continuation(c"call(")
        assert !script.needs_continuation(c"echo hi")
        assert !script.needs_continuation(c"x = 1")
        assert !script.needs_continuation(c"[1, 2]")
        assert !script.needs_continuation(c"say \"closed\"")
    }
}

test "script file exit status stays local to the script" {
    trust {
        fresh()
        val dir: ref u8 = c"/tmp/blood-unit-script/exit"
        assert u.mkdir_p(dir)
        val path: ref u8 = u.path_join(dir, c"exits.bx")
        assert u.write_file(path, c"exit(7)\n")
        u.script_exit_code = -1
        assert script.run_file(path) == 7
        assert u.script_exit_code == -1

        assert script.run_interactive(c"exit(3)\n") == 3
        assert u.script_exit_code == 3
        u.script_exit_code = -1
    }
}

test "script this builtins return null without a script file" {
    trust {
        fresh()
        assert run(c"if std.this() != null {\n    raise \"this\"\n}\nif std.this_dir() != null {\n    raise \"this_dir\"\n}\n") == 0
    }
}

test "script this builtins report script name, path and directory" {
    trust {
        fresh()
        val old: ref u8 = u.cwd()
        assert u.mkdir_p(c"/tmp/blood-unit-script/this")
        assert u.chdir(c"/tmp/blood-unit-script/this") == 0
        val dir: ref u8 = u.cwd()
        val main: ref u8 = u.path_join(dir, c"main.bx")
        val child: ref u8 = u.path_join(dir, c"child.bx")
        val child_head: ref u8 = u.s_cat4(
            c"var child_info = std.this()\nif child_info.name != \"child.bx\" {\n    raise \"child name\"\n}\nif child_info.path != \"",
            child,
            c"\" {\n    raise \"child path\"\n}\nif std.this_dir() != \"",
            dir
        )
        val child_src: ref u8 = u.s_cat(child_head, c"\" {\n    raise \"child dir\"\n}\n")

        val main_head: ref u8 = u.s_cat4(
            c"var info = std.this()\nif info.name != \"main.bx\" {\n    raise \"name\"\n}\nif info.path != \"",
            main,
            c"\" {\n    raise \"path\"\n}\nif std.this_dir() != \"",
            dir
        )
        val main_mid: ref u8 = u.s_cat3(
            c"\" {\n    raise \"dir\"\n}\nif std.source(\"child.bx\") != 0 {\n    raise \"source\"\n}\ninfo = std.this()\nif info.path != \"",
            main,
            c"\" {\n    raise \"restore\"\n}\nif std.this_dir() != \""
        )
        val main_src: ref u8 = u.s_cat(
            u.s_cat(main_head, main_mid),
            u.s_cat(dir, c"\" {\n    raise \"restore dir\"\n}\n")
        )
        assert u.write_file(child, child_src)
        assert u.write_file(main, main_src)
        val old_hook: fn(ref u8) i32 = u.run_script_file_hook
        val old_ready: i64 = u.hooks_ready
        u.run_script_file_hook = script.run_file
        u.hooks_ready = 1
        val st: i32 = script.run_file(c"main.bx")
        u.run_script_file_hook = old_hook
        u.hooks_ready = old_ready
        assert u.chdir(old) == 0
        assert st == 0
    }
}

test "script classifies script-looking lines" {
    trust {
        assert script.looks_like_script(c"say hello")
        assert script.looks_like_script(c"say")
        assert script.looks_like_script(c"if x {")
        assert script.looks_like_script(c"while x {")
        assert script.looks_like_script(c"for x in xs {")
        assert script.looks_like_script(c"para for x in xs {")
        assert script.looks_like_script(c"fn f() {")
        assert script.looks_like_script(c"return 1")
        assert script.looks_like_script(c"raise \"x\"")
        assert script.looks_like_script(c"x = 1")
        assert script.looks_like_script(c"x += 1")
        assert script.looks_like_script(c"[1, 2]")
        assert script.looks_like_script(c"print(\"x\")")
        assert script.looks_like_script(c"# comment")
        assert !script.looks_like_script(c"echo hello")
        assert !script.looks_like_script(c"git status")
        assert !script.looks_like_script(c"ls -la")
        assert !script.looks_like_script(c"FOO=bar echo hi")
        assert !script.looks_like_script(c"")
        assert script.looks_like_script(c"var x = 1")
        assert script.looks_like_script(c"var (")
    }
}

test "script requires var for the first assignment" {
    trust {
        fresh()
        val src: ref u8 = c"try {\n    x = 1\n} catch err {\n    if \"undefined\" not in err {\n        raise \"expected undefined variable\"\n    }\n}\n"
        assert run(src) == 0
    }
}

test "script var declarations allow reassignment" {
    trust {
        fresh()
        val src: ref u8 = c"var x = 1\nx = 2\nif x != 2 {\n    raise \"reassign\"\n}\n"
        assert run(src) == 0
    }
}

test "script rejects duplicate var declarations" {
    trust {
        fresh()
        val src: ref u8 = c"var x = 1\ntry {\n    var x = 2\n} catch err {\n    if \"already declared\" not in err {\n        raise \"expected redeclaration error\"\n    }\n}\n"
        assert run(src) == 0
    }
}

test "script supports bulk var declarations" {
    trust {
        fresh()
        val src: ref u8 = c"var (\n    some_variable = \"hello\"\n    some_other_variable = \"world\"\n)\nif some_variable != \"hello\" or some_other_variable != \"world\" {\n    raise \"bulk var\"\n}\n"
        assert run(src) == 0
    }
}

test "script var declarations are fresh on each loop iteration" {
    trust {
        fresh()
        val src: ref u8 = c"var total = 0\nfor x in [1, 2, 3] {\n    var doubled = x * 2\n    total += doubled\n}\nif total != 12 {\n    raise \"for var\"\n}\nvar n = 0\nwhile n < 3 {\n    var label = \"iteration\"\n    if label != \"iteration\" {\n        raise \"while var\"\n    }\n    n += 1\n}\nif n != 3 {\n    raise \"while count\"\n}\n"
        assert run(src) == 0
    }
}
