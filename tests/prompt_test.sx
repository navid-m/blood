val u      = use("../src/util.sx")
val cfg    = use("../src/config.sx")
val prompt = use("../src/prompt.sx")

fn plain_config() ref cfg.Config = trust {
    val c: mut ref cfg.Config = cfg.default_config()
    c.theme = u.s_dup(c"plain")
    c.show_git = 0
    c.show_time = 0
    c.show_jobs = 0
    c.show_exit_status = 0
    c.show_duration = 0
    return c
}

fn preset_config(name: ref u8) ref cfg.Config = trust {
    val c: mut ref cfg.Config = cfg.default_config()
    c.theme = u.s_dup(name)
    c.show_git = 0
    c.show_time = 0
    c.show_jobs = 0
    c.show_exit_status = 0
    c.show_duration = 0
    return c
}

fn shortened(dir: ref u8) ref u8 = trust {
    val home: ref u8 = u.home_dir()
    val hl: i64 = u.s_len(home)
    if hl > 1 && u.s_starts(dir, home) {
        if u.s_len(dir) == hl {
            return u.s_dup(c"~")
        }
        if @load8(@ptradd(dir, hl)) == 47 {
            return u.s_cat(c"~", @ptradd(dir, hl))
        }
    }
    return u.s_dup(dir)
}

test "plain prompt renders user, host and directory" {
    trust {
        val c: mut ref cfg.Config = plain_config()
        c.directory_style = u.s_dup(c"basename")
        val out: ref u8 = prompt.render(c, 0, 0, 0)
        assert u.s_contains(out, u.username())
        assert u.s_contains(out, c"@")
        assert u.s_contains(out, u.path_base(u.cwd()))
        assert u.s_contains(out, c">")
        assert u.s_ends_with(out, c" ")
        assert u.s_starts(out, c"\x1b[0m")
    }
}

test "plain prompt honours custom colours and directory styles" {
    trust {
        val c: mut ref cfg.Config = plain_config()
        c.color_primary = u.s_dup(c"P")
        c.color_secondary = u.s_dup(c"S")
        c.color_directory = u.s_dup(c"D")
        c.directory_style = u.s_dup(c"basename")
        val out: ref u8 = prompt.render(c, 0, 0, 0)
        assert u.s_starts(out, u.s_cat(c"\x1b[0mP", u.username()))
        assert u.s_contains(out, c"S")
        assert u.s_contains(out, c"D")
        assert u.s_contains(out, u.path_base(u.cwd()))

        c.directory_style = u.s_dup(c"full")
        val full: ref u8 = prompt.render(c, 0, 0, 0)
        assert u.s_contains(full, shortened(u.cwd()))

        val short_dir: ref u8 = shortened(u.cwd())
        val expected_short: ref u8 = u.s_cat3(
            u.path_base(u.path_dir(short_dir)),
            c"/",
            u.path_base(short_dir)
        )
        c.directory_style = u.s_dup(c"short")
        val short: ref u8 = prompt.render(c, 0, 0, 0)
        assert u.s_contains(short, expected_short)
    }
}

test "default prompt is two-line with the configured symbol" {
    trust {
        val c: mut ref cfg.Config = cfg.default_config()
        c.show_git = 0
        c.show_time = 0
        c.show_jobs = 0
        c.show_exit_status = 0
        c.show_duration = 0
        c.prompt_char = u.s_dup(c"L")
        val out: ref u8 = prompt.render(c, 0, 0, 0)
        assert u.s_contains(out, c"┌─ ")
        assert u.s_contains(out, c"└─ ")
        assert u.s_contains(out, c"\n")
        assert u.s_contains(out, c"L")
        assert u.s_contains(out, u.username())
    }
}

test "prompt reports exit status, jobs and durations" {
    trust {
        val c: mut ref cfg.Config = cfg.default_config()
        c.show_git = 0
        c.show_time = 0
        c.show_exit_status = 1
        c.show_jobs = 1
        c.show_duration = 1
        val failed: ref u8 = prompt.render(c, 3, 0, 0)
        assert u.s_contains(failed, c"✘ 3")
        val jobs: ref u8 = prompt.render(c, 0, 0, 2)
        assert u.s_contains(jobs, c"⚙ 2")

        val ms: ref u8 = prompt.render(c, 0, 750, 0)
        assert u.s_contains(ms, c"took 750ms")
        val secs: ref u8 = prompt.render(c, 0, 1500, 0)
        assert u.s_contains(secs, c"took 1.5s")
        val mins: ref u8 = prompt.render(c, 0, 65000, 0)
        assert u.s_contains(mins, c"took 1m5s")

        val quiet: ref u8 = prompt.render(c, 0, 499, 0)
        assert !u.s_contains(quiet, c"took ")
    }
}

test "prompt hides disabled sections" {
    trust {
        val c: mut ref cfg.Config = cfg.default_config()
        c.show_username = 0
        c.show_hostname = 0
        c.show_directory = 0
        c.show_git = 0
        c.show_time = 0
        c.show_jobs = 0
        c.show_exit_status = 0
        c.show_duration = 0
        val out: ref u8 = prompt.render(c, 0, 0, 0)
        assert !u.s_contains(out, u.username())
        assert !u.s_contains(out, u.path_base(u.cwd()))
        assert u.s_contains(out, c"┌─ ")
        assert u.s_contains(out, c.prompt_char)
    }
}

test "lambda preset renders a compact one-line prompt" {
    trust {
        val c: ref cfg.Config = preset_config(c"lambda")
        val out: ref u8 = prompt.render(c, 0, 0, 0)
        assert u.s_starts(out, c"\x1b[0m")
        assert u.s_contains(out, c"λ")
        assert u.s_contains(out, u.path_base(u.cwd()))
        assert u.s_contains(out, c"›")
        assert u.s_ends_with(out, c" ")
        assert !u.s_contains(out, c"\n")
    }
}

test "powerline preset uses background segments and separators" {
    trust {
        val c: ref cfg.Config = preset_config(c"powerline")
        val out: ref u8 = prompt.render(c, 0, 0, 0)
        assert u.s_contains(out, c"\x1b[46m")
        assert u.s_contains(out, c"\xee\x82\xb0")
        assert u.s_contains(out, c"\n")
        assert u.s_contains(out, c"❯")
        assert u.s_contains(out, u.username())
        assert u.s_contains(out, u.path_base(u.cwd()))
    }
}

test "right aligned presets split the prompt into two parts" {
    trust {
        val c: ref cfg.Config = preset_config(c"right")
        val a: prompt.PromptParts = prompt.render_parts(c, 0, 0, 0)
        assert u.s_contains(a.left, u.path_base(u.cwd()))
        assert u.s_contains(a.left, c">")
        assert u.s_contains(a.right, u.username())
        assert u.s_contains(a.right, c"@")
        assert !u.s_contains(a.left, c"\n")

        val c2: mut ref cfg.Config = preset_config(c"right_time")
        c2.show_time = 1
        val b: prompt.PromptParts = prompt.render_parts(c2, 0, 0, 0)
        assert u.s_contains(b.left, c"❯")
        assert u.s_contains(b.right, c":")
        assert !u.s_contains(b.right, c"\n")
    }
}

test "hacker, dots and compact presets use their signature glyphs" {
    trust {
        val hacker: ref u8 = prompt.render(preset_config(c"hacker"), 0, 0, 0)
        assert u.s_contains(hacker, c" :: ")
        assert u.s_contains(hacker, c">>>")
        assert u.s_contains(hacker, c"\n")

        val dots: ref u8 = prompt.render(preset_config(c"dots"), 0, 0, 0)
        assert u.s_contains(dots, c"●")
        assert u.s_contains(dots, c"❯")
        assert u.s_contains(dots, c"\n")

        val compact_cwd: ref u8 = c"/tmp/blood-unit-prompt/Alpha/Beta/gamma"
        assert u.mkdir_p(compact_cwd)
        val old: ref u8 = u.cwd()
        assert u.chdir(compact_cwd) == 0
        val compact: ref u8 = prompt.render(preset_config(c"compact"), 0, 0, 0)
        assert u.s_contains(compact, c"/t/b/A/B/gamma")
        assert u.s_contains(compact, c"❯")
        assert !u.s_contains(compact, c"\n")
        assert u.chdir(old) == 0
    }
}

test "iconified, timestamped and doubleline presets render their frames" {
    trust {
        val iconified: ref u8 = prompt.render(preset_config(c"iconified"), 0, 0, 0)
        assert u.s_contains(iconified, c"╭─ ")
        assert u.s_contains(iconified, c"├─ ")
        assert u.s_contains(iconified, c"╰─ ")
        assert u.s_contains(iconified, c"☼ ")
        assert u.s_contains(iconified, c"⌂ ")
        assert u.s_contains(iconified, c"➜")

        val c: mut ref cfg.Config = preset_config(c"timestamped")
        c.show_time = 1
        val timestamped: ref u8 = prompt.render(c, 0, 0, 0)
        assert u.s_contains(timestamped, c"[")
        assert u.s_contains(timestamped, c"]")
        assert u.s_contains(timestamped, c"$")
        assert u.s_contains(timestamped, c"\n")

        val doubleline: ref u8 = prompt.render(preset_config(c"doubleline"), 0, 0, 0)
        assert u.s_contains(doubleline, c"╔═ ")
        assert u.s_contains(doubleline, c"╠═ ")
        assert u.s_contains(doubleline, c"╚═ ")
        assert u.s_contains(doubleline, c"▶")
    }
}
