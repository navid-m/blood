val u      = use("../src/core/util.sx")
val cfg    = use("../src/core/config.sx")
val hist   = use("../src/core/history.sx")
val sh     = use("../src/shell/shell.sx")
val script = use("../src/lang/script.sx")
val esc    = use("../src/shell/escape.sx")

fn setup(path: ref u8) ref cfg.Config = trust {
    val c: mut ref cfg.Config = cfg.load_config_from(path)
    val h: mut ref hist.History = hist.history_new(c)
    sh.shell_init(c, h, false)
    script.script_init()
    u.run_shell_hook = sh.run_line
    u.hooks_ready = 1
    return c
}

fn new_history(c: ref cfg.Config) ref hist.History = trust {
    return hist.history_new(c)
}

fn vec_has_path(v: ref u.Vec, p: ref u8) bool = trust {
    val i: mut i64 = 0
    for {
        if i >= v.len {
            break
        }
        if u.s_eq(u.vec_p(v, i) as ref u8, p) {
            return true
        }
        i++
    }
    return false
}

test "escape detection only accepts colon-prefixed lines" {
    trust {
        assert esc.is_command(c":where")
        assert esc.is_command(c"  :cfg.prompt.theme = hacker")
        assert !esc.is_command(c"echo :where")
        assert !esc.is_command(c"")
    }
}

test ":cfg updates running config and saves blood.ini" {
    trust {
        val path: ref u8 = c"/tmp/blood-unit-escape/cfg.ini"
        assert u.mkdir_p(u.path_dir(path))
        assert u.write_file(
            path,
            c"# keep this comment\n[prompt]\ntheme = default\nshow_git = true\n"
        )
        val c: mut ref cfg.Config = setup(path)
        val h: mut ref hist.History = new_history(c)

        assert esc.handle(c":cfg.prompt.theme = hacker", c, h) == 0
        assert u.s_eq(c.theme, c"hacker")
        assert esc.handle(c":cfg.prompt.show_git = false", c, h) == 0
        assert c.show_git == 0
        assert esc.handle(c":cfg.colors.primary = red", c, h) == 0
        assert u.s_eq(c.color_primary, c"\x1b[31m")
        assert esc.handle(c":cfg.history.max_entries = 5", c, h) == 0
        assert c.history_max == 5
        assert h.max == 5

        val text: ref u8 = u.read_file(path)
        assert u.s_contains(text, c"# keep this comment")
        assert u.s_contains(text, c"theme = hacker")
        assert u.s_contains(text, c"show_git = false")
        assert u.s_contains(text, c"primary = red")
        assert u.s_contains(text, c"max_entries = 5")

        assert esc.handle(c":cfg.prompt.not_a_key = 1", c, h) == 2
        assert u.s_eq(c.theme, c"hacker")
        assert esc.handle(c":cfg.prompt.show_git = maybe", c, h) == 2
        assert c.show_git == 0
        assert esc.handle(c":cfg.history.max_entries = lots", c, h) == 2
        assert c.history_max == 5
        assert !u.s_contains(u.read_file(path), c"maybe")
    }
}

test ":cfg updates aliases and environment at runtime" {
    trust {
        val path: ref u8 = c"/tmp/blood-unit-escape/aliases.ini"
        assert u.mkdir_p(u.path_dir(path))
        assert u.write_file(path, c"")
        val c: mut ref cfg.Config = setup(path)
        val h: mut ref hist.History = new_history(c)

        assert esc.handle(c":cfg.aliases.ll = echo hello", c, h) == 0
        assert u.map_has(sh.aliases(), c"ll")
        assert u.s_eq(@bitcast(u.map_get(sh.aliases(), c"ll"), ref u8), c"echo hello")

        assert esc.handle(c":cfg.env.BLOOD_ESCAPE = yes", c, h) == 0
        assert u.s_eq(sh.get_var(c"BLOOD_ESCAPE"), c"yes")

        val text: ref u8 = u.read_file(path)
        assert u.s_contains(text, c"[aliases]")
        assert u.s_contains(text, c"ll = echo hello")
        assert u.s_contains(text, c"[env]")
        assert u.s_contains(text, c"BLOOD_ESCAPE = yes")
    }
}

test ":rla reloads config, aliases and .bloodrc" {
    trust {
        val dir: ref u8 = c"/tmp/blood-unit-escape/reload"
        val path: ref u8 = u.path_join(dir, c"blood.ini")
        assert u.mkdir_p(dir)
        assert u.write_file(path, c"[prompt]\ntheme = default\n")
        val c: mut ref cfg.Config = setup(path)
        val h: mut ref hist.History = new_history(c)

        val rc: ref u8 = u.path_join(dir, c".bloodrc")
        assert u.write_file(
            rc,
            c"alias ll='echo reloaded'\nvar user_paths = [\"bin\"]\nfn prelude() {\n    std.write_file(\"/tmp/blood-unit-escape/reload/prelude.txt\", \"ran\")\n}\nprelude()\n"
        )
        val marker: ref u8 = u.path_join(dir, c"prelude.txt")

        assert esc.handle(c":rla", c, h) == 0
        assert u.file_exists(marker)
        assert u.s_eq(u.read_file(marker), c"ran")
        assert u.map_has(sh.aliases(), c"ll")

        assert u.write_file(path, c"[prompt]\ntheme = powerline\n")
        assert esc.handle(c":rla", c, h) == 0
        assert u.s_eq(c.theme, c"powerline")
    }
}

test ":cfg queries enumerated and scalar values" {
    trust {
        val path: ref u8 = c"/tmp/blood-unit-escape/query.ini"
        assert u.mkdir_p(u.path_dir(path))
        assert u.write_file(path, c"[prompt]\ntheme = lambda\n")
        val c: mut ref cfg.Config = setup(path)
        val h: mut ref hist.History = new_history(c)
        assert esc.handle(c":cfg.prompt.theme", c, h) == 0
        assert esc.handle(c":cfg.prompt.directory_style", c, h) == 0
        assert esc.handle(c":cfg.prompt.show_git", c, h) == 0
        assert esc.handle(c":cfg.colors.primary", c, h) == 0
        assert esc.handle(c":cfg.history.max_entries", c, h) == 0
        assert esc.handle(c":cfg.prompt.nope", c, h) == 2
    }
}

test ":where and :help succeed" {
    trust {
        val path: ref u8 = c"/tmp/blood-unit-escape/where.ini"
        assert u.mkdir_p(u.path_dir(path))
        assert u.write_file(path, c"")
        val c: mut ref cfg.Config = setup(path)
        val h: mut ref hist.History = new_history(c)
        assert esc.handle(c":where", c, h) == 0
        assert esc.handle(c":help", c, h) == 0
        assert esc.handle(c":nonsense", c, h) == 2
    }
}

test ":ft finds files recursively and reports absolute paths" {
    trust {
        val dir: ref u8 = c"/tmp/blood-unit-escape/ft"
        assert u.mkdir_p(u.path_join(dir, c"sub/deep"))
        val top: ref u8 = u.path_join(dir, c"foo bar.txt")
        val nested: ref u8 = u.path_join(dir, c"sub/Foo Bar.md")
        assert u.write_file(top, c"")
        assert u.write_file(nested, c"")
        assert u.write_file(u.path_join(dir, c"other.txt"), c"")
        assert u.write_file(u.path_join(dir, c"sub/deep/foobar.h"), c"")

        val saved: ref u8 = u.cwd()
        assert u.chdir(dir) == 0
        val real_dir: ref u8 = u.cwd()
        val hits: ref u.Vec = esc.find_matching_files(c"foo bar")
        assert hits.len == 2
        assert vec_has_path(hits, u.path_join(real_dir, c"foo bar.txt"))
        assert vec_has_path(hits, u.path_join(real_dir, c"sub/Foo Bar.md"))
        assert esc.find_matching_files(c"HELLEW").len == 0
        assert u.chdir(saved) == 0

        val path: ref u8 = u.path_join(dir, c"blood.ini")
        assert u.write_file(path, c"")
        val c: mut ref cfg.Config = setup(path)
        val h: mut ref hist.History = new_history(c)
        assert esc.handle(c":ft", c, h) == 2
        assert esc.handle(c":ft hellew", c, h) == 1
    }
}

test ":ls lists a directory and rejects missing paths" {
    trust {
        val dir: ref u8 = c"/tmp/blood-unit-escape/ls"
        assert u.mkdir_p(dir)
        assert u.write_file(u.path_join(dir, c"note.txt"), c"hello")
        val path: ref u8 = u.path_join(dir, c"blood.ini")
        assert u.write_file(path, c"")
        val c: mut ref cfg.Config = setup(path)
        val h: mut ref hist.History = new_history(c)
        assert esc.handle(u.s_cat(c":ls ", dir), c, h) == 0
        assert esc.handle(c":ls /tmp/blood-unit-escape/does-not-exist", c, h) == 1
    }
}
