#!/usr/bin/env blood
# Build Blood, run the unit tests, and verify every sample program.
#
# Set BLOOD=/path/to/blood to test an existing binary instead of building.

fn cleanup(tmp) {
    shell("rm -rf \"{tmp}\"")
    shell("rm -rf /tmp/blood-unit-*")
    shell("rm -f /tmp/blood_sample_file_io.txt")
}

fn fail(message) {
    say(message)
    exit(1)
}

root = capture("cd \"{this_dir()}/..\" && pwd").strip()
if status != 0 {
    fail("error: could not determine project root")
}

shell("cd \"{root}\"")

tmp_dir = env("TMPDIR")
if tmp_dir == null or tmp_dir == "" {
    tmp_dir = "/tmp"
}

tmp = capture("mktemp -d \"{tmp_dir}/blood-fw.XXXXXX\"").strip()
if status != 0 {
    fail("error: could not create temporary directory")
}

blood_bin = env("BLOOD")

if blood_bin == null or blood_bin == "" {
    spectre = capture("command -v spectre").strip()

    if status != 0 or spectre == "" {
        cleanup(tmp)
        fail("error: spectre is not installed and BLOOD is not set")
    }

    say("==> building blood (dev)")

    shell("spectre build dev")

    if status != 0 {
        cleanup(tmp)
        fail("error: Blood build failed")
    }

    blood_bin = "{root}/blood-dev"
}

shell("test -x \"{blood_bin}\"")

if status != 0 {
    cleanup(tmp)
    fail("error: blood binary is not executable: {blood_bin}")
}

spectre = capture("command -v spectre").strip()

if status == 0 and spectre != "" {
    say("==> running unit tests")

    unit_log = "{tmp}/unit.log"

    shell("spectre test tests > \"{unit_log}\" 2>&1")

    if status != 0 {
        shell("cat \"{unit_log}\"")
        cleanup(tmp)
        fail("unit tests failed")
    }

    shell("grep -Eq 'assertion failed|\\[fail\\]|modules? failed' \"{unit_log}\"")

    if status == 0 {
        shell("cat \"{unit_log}\"")
        cleanup(tmp)
        fail("unit tests failed")
    }

    passes = capture("grep -c '^\\[pass\\]' \"{unit_log}\"").strip()

    say("    {passes} unit tests passed")
} else {
    say("==> skipping unit tests (spectre is not installed)")
}

say("==> running samples")

failures = 0
count = 0

samples = glob("samples/*.bx")

for sample in samples {
    parts = sample.split("/")
    filename = parts[parts.len() - 1]
    name = filename.replace(".bx", "")

    expected = "samples/expected/{name}.out"
    args_file = "samples/args/{name}.args"

    shell("test -f \"{expected}\"")

    if status != 0 {
        say("FAIL {name}: missing expected output ({expected})")
        failures += 1
        continue
    }

    sample_args = ""
    args = read_file(args_file)

    if args != null {
        sample_args = args.strip()
    }

    out = "{tmp}/{name}.out"
    err = "{tmp}/{name}.err"

    shell("\"{blood_bin}\" \"{sample}\" {sample_args} > \"{out}\" 2> \"{err}\"")
    sample_status = status

    count += 1

    if sample_status != 0 {
        say("FAIL {name}: exited with status {sample_status}")
        shell("sed 's/^/    /' \"{err}\"")
        failures += 1
        continue
    }

    shell("test -s \"{err}\"")

    if status == 0 {
        say("FAIL {name}: wrote to stderr")
        shell("sed 's/^/    /' \"{err}\"")
        failures += 1
        continue
    }

    diff_file = "{tmp}/{name}.diff"

    shell("diff -u \"{expected}\" \"{out}\" > \"{diff_file}\"")

    if status != 0 {
        say("FAIL {name}: output did not match {expected}")
        shell("sed 's/^/    /' \"{diff_file}\"")
        failures += 1
        continue
    }

    say("PASS {name}")
}

if count == 0 {
    cleanup(tmp)
    fail("error: no samples found")
}

if failures != 0 {
    cleanup(tmp)
    fail("{failures} of {count} samples failed")
}

say("all {count} samples passed")

cleanup(tmp)