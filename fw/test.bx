#!/usr/bin/env blood

fn fail(message) {
    eprint(message)
    exit(1)
}

fn check_sample(sample) {
    var name     = std.stem(sample)
    var expected = "samples/expected/{name}.out"

    if not std.is_file(expected) {
        say("FAIL {name}: missing expected output ({expected})")
        return null
    }

    var sample_args = std.read_file("samples/args/{name}.args", default: "").split_words()
    var r           = run([blood_bin, sample, ...sample_args])

    if not r.ok {
        say("FAIL {name}: exited with status {r.status}")
        print(std.indent(r.stderr, 4))
        return false
    }

    if r.stderr != "" {
        say("FAIL {name}: wrote to stderr")
        print(std.indent(r.stderr, 4))
        return false
    }

    var want = std.read_file(expected)

    if r.stdout != want {
        say("FAIL {name}: output did not match {expected}")
        print(std.indent(std.unified_diff(want, r.stdout), 4))
        return false
    }

    say("PASS {name}")
    return true
}

var root = std.parent(std.this_dir())
cd(root)

var tmp = std.mktemp_dir("blood-fw")

defer {
    std.remove_all(tmp)
    std.remove_all(std.glob("/tmp/blood-unit-*"))
    std.remove_file("/tmp/blood_sample_file_io.txt")
}

var blood_bin = std.env("BLOOD", default: "")

if blood_bin == "" {
    if not std.which("spectre") {
        fail("error: spectre is not installed and BLOOD is not set")
    }

    say("==> building blood (dev)")

    if not run(["spectre", "build", "dev"]).ok {
        fail("error: Blood build failed")
    }

    blood_bin = "{root}/blood-dev"
}

if not std.is_executable(blood_bin) {
    fail("error: blood binary is not executable: {blood_bin}")
}

if std.which("spectre") {
    say("==> running unit tests")

    var unit = run(["spectre", "test", "tests"], merge_stderr: true)

    if not unit.ok or unit.stdout.matches(r"assertion failed|\[fail\]|modules? failed") {
        print(unit.stdout)
        fail("unit tests failed")
    }

    var passes = unit.stdout.lines().count(|line| line.starts_with("[pass]"))

    say("    {passes} unit tests passed")
} else {
    say("==> skipping unit tests (spectre is not installed)")
}

say("==> running samples")

var samples  = std.glob("samples/*.bx")
var results  = samples.map(|sample| check_sample(sample))
var count    = results.count(|result| result != null)
var failures = results.filter(|result| result != true).count()

if count == 0 {
    fail("error: no samples found")
}

if failures != 0 {
    fail("{failures} of {count} samples failed")
}

say("all {count} samples passed")
