#!/usr/bin/env blood

fn fail(message) {
    eprint(message)
    exit(1)
}

var root = parent(this_dir())
cd(root)

var tmp = mktemp_dir("blood-fw")

defer {
    remove_all(tmp)
    remove_all(glob("/tmp/blood-unit-*"))
    remove_file("/tmp/blood_sample_file_io.txt")
}

var blood_bin = env("BLOOD", default: "")
var r         = null

if blood_bin == "" {
    if not which("spectre") {
        fail("error: spectre is not installed and BLOOD is not set")
    }

    say("==> building blood (dev)")

    if not run(["spectre", "build", "dev"]).ok {
        fail("error: Blood build failed")
    }

    blood_bin = "{root}/blood-dev"
}

if not is_executable(blood_bin) {
    fail("error: blood binary is not executable: {blood_bin}")
}

if which("spectre") {
    say("==> running unit tests")

    r = run(["spectre", "test", "tests"], merge_stderr: true)

    if not r.ok or r.stdout.matches(r"assertion failed|\[fail\]|modules? failed") {
        print(r.stdout)
        fail("unit tests failed")
    }

    var passes = 0
    for line in r.stdout.lines() {
        if line.starts_with("[pass]") {
            passes += 1
        }
    }

    say("    {passes} unit tests passed")
} else {
    say("==> skipping unit tests (spectre is not installed)")
}

say("==> running samples")

var failures    = 0
var count       = 0
var name        = ""
var expected    = ""
var sample_args = []
var want        = ""

for sample in glob("samples/*.bx") {
    name     = stem(sample)
    expected = "samples/expected/{name}.out"

    if not is_file(expected) {
        say("FAIL {name}: missing expected output ({expected})")
        failures += 1
        continue
    }

    sample_args = read_file("samples/args/{name}.args", default: "").split_words()

    r = run([blood_bin, sample, ...sample_args])
    count += 1

    if not r.ok {
        say("FAIL {name}: exited with status {r.status}")
        print(indent(r.stderr, 4))
        failures += 1
        continue
    }

    if r.stderr != "" {
        say("FAIL {name}: wrote to stderr")
        print(indent(r.stderr, 4))
        failures += 1
        continue
    }

    want = read_file(expected)

    if r.stdout != want {
        say("FAIL {name}: output did not match {expected}")
        print(indent(unified_diff(want, r.stdout), 4))
        failures += 1
        continue
    }

    say("PASS {name}")
}

if count == 0 {
    fail("error: no samples found")
}

if failures != 0 {
    fail("{failures} of {count} samples failed")
}

say("all {count} samples passed")
