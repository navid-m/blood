#!/usr/bin/env blood

## Build Blood, run the unit tests, and verify every sample program.
##
## Set BLOOD=/path/to/blood to test an existing binary instead of building.

blood_bin = env("BLOOD", default: "blood")

r = run([blood_bin, join(this_dir(), "test2.bx")], merge_stderr: true)
print(r.stdout)
if r.stderr != "" {
    eprint(r.stderr.strip())
}
if not r.ok {
    exit(r.status)
}
