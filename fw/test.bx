#!/usr/bin/env blood

fn fail(message) {
    eprint(message)
    exit(1)
}

fn check_sample(sample) {
    var name     = sample.stem()
    var expected = "samples/expected/{name}.out"

    if not expected.is_file() {
        return { "ok": false, "report": "FAIL {name}: missing expected output ({expected})" }
    }

    var sample_args = (std.read_file("samples/args/{name}.args") ?? "").split_words()
    var r           = run([blood_bin, sample, ...sample_args])

    if not r.ok {
        var report = "FAIL {name}: exited with status {r.status}"
        if r.stderr != "" {
            report += "\n" + std.indent(r.stderr, 4).strip_suffix("\n")
        }
        return { "ok": false, "report": report }
    }

    if r.stderr != "" {
        var report = "FAIL {name}: wrote to stderr"
        report += "\n" + std.indent(r.stderr, 4).strip_suffix("\n")
        return { "ok": false, "report": report }
    }

    var want = std.read_file(expected) ?? ""

    if r.stdout != want {
        var report = "FAIL {name}: output did not match {expected}"
        report += "\n" + std.indent(std.unified_diff(want, r.stdout), 4).strip_suffix("\n")
        return { "ok": false, "report": report }
    }

    return { "ok": true, "report": "PASS {name}" }
}

var root = std.this_dir().parent()
cd(root)

var tmp = std.mktemp_dir("blood-fw")

defer {
    std.remove_all(tmp)
    std.remove_all(std.glob("/tmp/blood-unit-*"))
    std.remove_file("/tmp/blood_sample_file_io.txt")
}

var blood_bin = std.env("BLOOD") ?? ""

if blood_bin == "" {
    if not std.which("spectre") {
        fail("error: spectre is not installed and BLOOD is not set")
    }

    say("==> building blood (dev)")

    if not sh("spectre build dev").ok {
        fail("error: Blood build failed")
    }

    blood_bin = "{root}/blood-dev"
}

if not blood_bin.is_executable() {
    fail("error: blood binary is not executable: {blood_bin}")
}

if std.which("spectre") {
    say("==> running unit tests")

    var unit = run(["spectre", "test", "tests"], merge_stderr: true)

    if not unit.ok or unit.stdout.matches(r"assertion failed|\[fail\]|modules? failed") {
        print(unit.stdout)
        fail("unit tests failed")
    }

    var passes = unit.stdout.lines().count(|line| line.starts_with("[pass]"))

    say("    {passes} unit tests passed")
} else {
    say("==> skipping unit tests (spectre is not installed)")
}

say("==> running samples")

var (
    samples  = std.glob("samples/*.bx")
    results  = samples.pmap(|sample| check_sample(sample))
    count    = results.len()
    failures = results.count(|result| not result.ok)
)

for result in results {
    say(result.report)
}

if count == 0 {
    fail("error: no samples found")
}

if failures != 0 {
    fail("{failures} of {count} samples failed")
}

say("all {count} samples passed")
