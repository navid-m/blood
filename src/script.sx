        val wl: ref Value = lines_of(want)
        val gl: ref Value = lines_of(got)
        val wv: ref u.Vec = wl.p as ref u.Vec
        val gv: ref u.Vec = gl.p as ref u.Vec
        val b: mut ref u.Buf = u.buf_new()
        u.buf_add(b, c"--- expected\n+++ actual\n")
        val n: mut i64 = wv.len
