fn call_method(obj: ref Value, name: ref u8, args: ref u.Vec, n: ref lang.Node) ref Value = trust {
    if obj == none {
        set_error(c"method call on null", n.line, n.col)
        return v_nil()
    }
    if obj.tag == 5 {
        val vec: mut ref u.Vec = obj.p as ref u.Vec
        if u.s_eq(name, c"append") {
            u.vec_pushp(vec, arg(args, 0) as ref void)
            return v_nil()
        }
        if u.s_eq(name, c"pop") {
            if vec.len == 0 {
                return v_nil()
            }
            val v: ref Value = u.vec_p(vec, vec.len - 1) as ref Value
            vec.len--
            return v
        }
        if u.s_eq(name, c"len") {
            return v_int(vec.len)
        }
        if u.s_eq(name, c"last") {
            if vec.len == 0 {
                return v_nil()
            }
            return u.vec_p(vec, vec.len - 1) as ref Value
        }
        if u.s_eq(name, c"insert") {
            u.vec_insert(vec, num_i(arg(args, 0)), @bitcast(arg(args, 1), i64))
            return v_nil()
        }
        if u.s_eq(name, c"remove") {
            val i: i64 = num_i(arg(args, 0))
            if i >= 0 && i < vec.len {
                u.vec_remove(vec, i)
            }
            return v_nil()
        }
        if u.s_eq(name, c"contains") {
            return v_bool(list_contains(vec, arg(args, 0)))
        }
        if u.s_eq(name, c"join") {
            val b: mut ref u.Buf = u.buf_new()
            val sep: ref u8 = v_to_str(arg(args, 0))
            val i: mut i64 = 0
            for {
                if i >= vec.len {
                    break
                }
                if i > 0 {
                    u.buf_add(b, sep)
                }
                u.buf_add(b, v_to_str(u.vec_p(vec, i) as ref Value))
                i++
            }
            return v_str(u.buf_take(b))
        }
        if u.s_eq(name, c"sort") {
            sort_values(vec)
            return v_nil()
        }
    }
    if obj.tag == 6 {
        val m: mut ref u.Map = obj.p as ref u.Map
        if u.s_eq(name, c"get") {
            val raw: i64 = u.map_get(m, key_of(arg(args, 0)))
            if raw != 0 {
                return @bitcast(raw, ref Value)
            }
            return arg(args, 1)
        }
        if u.s_eq(name, c"set") {
            u.map_put(m, key_of(arg(args, 0)), @bitcast(arg(args, 1), i64))
            return v_nil()
        }
        if u.s_eq(name, c"contains") {
            return v_bool(u.map_has(m, key_of(arg(args, 0))))
        }
        if u.s_eq(name, c"keys") {
            return call_native(18, args_for(obj), n)
        }
        if u.s_eq(name, c"values") {
            return call_native(19, args_for(obj), n)
        }
        if u.s_eq(name, c"items") {
            return call_native(27, args_for(obj), n)
        }
        if u.s_eq(name, c"len") {
            return v_int(m.len)
        }
        if u.s_eq(name, c"remove") {
            u.map_del(m, key_of(arg(args, 0)))
            return v_nil()
        }
        u.map_put(m, name, @bitcast(arg(args, 0), i64))
        return v_nil()
    }
    if obj.tag == 4 {
        val s: ref u8 = obj.p as ref u8
        if u.s_eq(name, c"upper") || u.s_eq(name, c"lower") {
            val b: mut ref u.Buf = u.buf_new()
            val len: i64 = u.s_len(s)
            val i: mut i64 = 0
            for {
                if i >= len {
                    break
                }
                val c: u8 = @load8(@ptradd(s, i))
                if u.s_eq(name, c"upper") && c >= 97 && c <= 122 {
                    u.buf_ch(b, c - 32)
                } elif u.s_eq(name, c"lower") && c >= 65 && c <= 90 {
                    u.buf_ch(b, c + 32)
                } else {
                    u.buf_ch(b, c)
                }
                i++
            }
            return v_str(u.buf_take(b))
        }
        if u.s_eq(name, c"strip") {
            return v_str(u.s_trim(s))
        }
        if u.s_eq(name, c"split") {
            return v_str_split(s, v_to_str(arg(args, 0)))
        }
        if u.s_eq(name, c"startswith") || u.s_eq(name, c"starts_with") {
            return v_bool(u.s_starts(s, v_to_str(arg(args, 0))))
        }
        if u.s_eq(name, c"endswith") || u.s_eq(name, c"ends_with") {
            val suffix: ref u8 = v_to_str(arg(args, 0))
            val sl: i64 = u.s_len(s)
            val pl: i64 = u.s_len(suffix)
            if pl > sl {
                return v_bool(false)
            }
            return v_bool(u.s_eq(u.s_substr(s, sl - pl, sl), suffix))
        }
        if u.s_eq(name, c"strip_suffix") {
            val suffix: ref u8 = v_to_str(arg(args, 0))
            val sl: i64 = u.s_len(s)
            val pl: i64 = u.s_len(suffix)
            if pl <= sl && u.s_eq(u.s_substr(s, sl - pl, sl), suffix) {
                return v_str(u.s_substr(s, 0, sl - pl))
            }
            return v_str(s)
        }
        if u.s_eq(name, c"lines") {
            return lines_of(s)
        }
        if u.s_eq(name, c"split_words") {
            return split_words_value(s)
        }
        if u.s_eq(name, c"matches") {
            return v_bool(regex_match(s, v_to_str(arg(args, 0))))
        }
        if u.s_eq(name, c"last") {
            val len: i64 = u.s_len(s)
            if len == 0 {
                return v_nil()
            }
            val start: i64 = u.utf8_prev(s, len)
            return v_str(u.s_substr(s, start, len))
        }
        if u.s_eq(name, c"contains") {
            return v_bool(u.s_contains(s, v_to_str(arg(args, 0))))
        }
        if u.s_eq(name, c"replace") {
            return v_str(do_replace(s, v_to_str(arg(args, 0)), v_to_str(arg(args, 1))))
        }
        if u.s_eq(name, c"len") {
            return v_int(u.s_len(s))
        }
        if u.s_eq(name, c"chars") {
            val vec: mut ref u.Vec = list_new()
            val len: i64 = u.s_len(s)
            val i: mut i64 = 0
            for {
                if i >= len {
                    break
                }
                val j: i64 = u.utf8_next(s, i, len)
                u.vec_pushp(vec, v_str(u.s_substr(s, i, j)) as ref void)
                i = j
            }
            return v_list(vec)
        }
        if u.s_eq(name, c"join") {
            val v: ref Value = arg(args, 0)
            if v != none && v.tag == 5 {
                val vec: ref u.Vec = v.p as ref u.Vec
                val b: mut ref u.Buf = u.buf_new()
                val i: mut i64 = 0
                for {
                    if i >= vec.len {
                        break
                    }
                    if i > 0 {
                        u.buf_add(b, s)
                    }
                    u.buf_add(b, v_to_str(u.vec_p(vec, i) as ref Value))
                    i++
                }
                return v_str(u.buf_take(b))
            }
            return v_str(u.s_dup(c""))
        }
    }
    if obj.tag == 2 || obj.tag == 3 {
        if u.s_eq(name, c"abs") {
            return call_native(13, args_for(obj), n)
        }
    }
    set_error(u.s_cat3(c"unknown method '", name, c"'"), n.line, n.col)
    return v_nil()
}

fn args_for(v: ref Value) ref u.Vec = trust {
    val a: mut ref u.Vec = u.vec_new()
    u.vec_pushp(a, v)
    return a
}

fn sort_values(vec: mut ref u.Vec) void = trust {
    val i: mut i64 = 1
    for {
        if i >= vec.len {
            break
        }
        val key: ref Value = u.vec_p(vec, i) as ref Value
        val j: mut i64 = i - 1
        for {
            if j < 0 {
                break
            }
            val cur: ref Value = u.vec_p(vec, j) as ref Value
            if u.s_cmp(v_to_str(cur), v_to_str(key)) <= 0 {
                break
            }
            u.vec_setp(vec, j + 1, cur)
            j--
        }
        u.vec_setp(vec, j + 1, key)
        i++
    }
}

fn v_str_split(s: ref u8, sep: ref u8) ref Value = trust {
    val vec: mut ref u.Vec = list_new()
    if u.s_len(sep) == 0 {
        val n: i64 = u.s_len(s)
        val i: mut i64 = 0
        for {
            if i >= n {
                break
            }
            val j: i64 = u.utf8_next(s, i, n)
            u.vec_pushp(vec, v_str(u.s_substr(s, i, j)) as ref void)
            i = j
        }
        return v_list(vec)
    }
    val n: i64 = u.s_len(s)
    val start: mut i64 = 0
    for {
        val found: i64 = u.s_find(@ptradd(s, start), sep)
        if found < 0 {
            u.vec_pushp(vec, v_str(u.s_substr(s, start, n)) as ref void)
            break
        }
        val at: i64 = start + found
        u.vec_pushp(vec, v_str(u.s_substr(s, start, at)) as ref void)
        start = at + u.s_len(sep)
        if start > n {
            break
        }
    }
    return v_list(vec)
}

fn do_replace(s: ref u8, from: ref u8, to: ref u8) ref u8 = trust {
    if u.s_len(from) == 0 {
        return u.s_dup(s)
    }
    val b: mut ref u.Buf = u.buf_new()
    val n: i64 = u.s_len(s)
    val start: mut i64 = 0
    for {
        val found: i64 = u.s_find(@ptradd(s, start), from)
        if found < 0 {
            u.buf_addn(b, @ptradd(s, start), n - start)
            break
        }
        val at: i64 = start + found
        u.buf_addn(b, @ptradd(s, start), at - start)
        u.buf_add(b, to)
        start = at + u.s_len(from)
        if start > n {
            break
        }
    }
    return u.buf_take(b)
}

fn assign_target(target: ref lang.Node, value: ref Value, env: mut ref Env, op: i64) void = trust {
    if target.kind == lang.NodeKind.Var {
        val final: mut ref Value = value
        if op > 1 {
            val cur: ref Value = env_lookup(env, target.s)
            if cur == none {
                set_error(
                    u.s_cat3(c"undefined variable '", target.s, c"'"),
                    target.line,
                    target.col
                )
                return
            }
            final = bin_op(op - 2, cur, value)
        }
        env_assign(env, target.s, final)
        return
    }
    if target.kind == lang.NodeKind.Attr {
        val obj: ref Value = eval(u.vec_p(target.kids, 0) as ref lang.Node, env)
        if g_flow != 0 {
            return
        }
        val final: mut ref Value = value
        if op > 1 {
            val cur: mut ref Value = v_nil()
            if obj != none && obj.tag == 6 {
                val m0: ref u.Map = obj.p as ref u.Map
                val raw: i64 = u.map_get(m0, target.s)
                if raw != 0 {
                    cur = @bitcast(raw, ref Value)
                }
            }
            final = bin_op(op - 2, cur, value)
        }
        if obj != none && obj.tag == 6 {
            val m: mut ref u.Map = obj.p as ref u.Map
            u.map_put(m, target.s, @bitcast(final, i64))
            return
        }
        set_error(c"value does not support attribute assignment", target.line, target.col)
        return
    }
    if target.kind == lang.NodeKind.Index {
        val obj: ref Value = eval(u.vec_p(target.kids, 0) as ref lang.Node, env)
        val idx: ref Value = eval(u.vec_p(target.kids, 1) as ref lang.Node, env)
        val final: mut ref Value = value
        if op > 1 {
            val cur: ref Value = do_index(obj, idx, target)
            final = bin_op(op - 2, cur, value)
        }
        if obj != none && obj.tag == 5 {
            val vec: mut ref u.Vec = obj.p as ref u.Vec
            val i: mut i64 = num_i(idx)
            if i < 0 {
                i = vec.len + i
            }
            if i >= 0 && i < vec.len {
                u.vec_setp(vec, i, final)
            } else {
                set_error(c"list index out of range", target.line, target.col)
            }
            return
        }
        if obj != none && obj.tag == 6 {
            val m: mut ref u.Map = obj.p as ref u.Map
            u.map_put(m, key_of(idx), @bitcast(final, i64))
            return
        }
        set_error(c"value is not assignable by index", target.line, target.col)
        return
    }
    set_error(c"invalid assignment target", target.line, target.col)
}

fn wait_status_code(status: i32) i64 = trust {
    if (status & 127) == 0 {
        return ((status >> 8) & 255) as i64
    }
    return (128 + (status & 127)) as i64
}

fn para_items(iterable: ref Value) ref u.Vec = trust {
    val items: mut ref u.Vec = u.vec_new()
    if iterable == none {
        return items
    }
    if iterable.tag == 5 {
        val vec: ref u.Vec = iterable.p as ref u.Vec
        val i: mut i64 = 0
        for {
            if i >= vec.len {
                break
            }
            u.vec_pushp(items, u.vec_p(vec, i))
            i++
        }
        return items
    }
    if iterable.tag == 4 {
        val s: ref u8 = iterable.p as ref u8
        val len: i64 = u.s_len(s)
        val i: mut i64 = 0
        for {
            if i >= len {
                break
            }
            val j: i64 = u.utf8_next(s, i, len)
            u.vec_pushp(items, v_str(u.s_substr(s, i, j)) as ref void)
            i = j
        }
        return items
    }
    if iterable.tag == 6 {
        val m: ref u.Map = iterable.p as ref u.Map
        val i: mut i64 = 0
        for {
            if i >= m.cap {
                break
            }
            if u.map_used_at(m, i) {
                u.vec_pushp(items, v_str(u.s_dup(u.map_key_at(m, i))) as ref void)
            }
            i++
        }
    }
    return items
}

fn exec_para_for(n: ref lang.Node, env: mut ref Env) void = trust {
    val iterable: ref Value = eval(u.vec_p(n.kids, 0) as ref lang.Node, env)
    if g_flow != 0 {
        return
    }
    val items: ref u.Vec = para_items(iterable)
    val body: ref lang.Node = u.vec_p(n.kids, 1) as ref lang.Node
    val pids: mut ref u.Vec = u.vec_new()
    val failed: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= items.len {
            break
        }
        if u.interrupt_flag != 0 {
            break
        }
        val item: ref Value = u.vec_p(items, i) as ref Value
        val pid: i32 = rt.fork()
        if pid == 0 {
            g_error = none
            g_flow = 0
            g_return = none
            env_assign(env, n.s, item)
            set_status(0)
            exec_block(body, env, false)
            val code: mut i64 = 0
            if g_flow == 4 {
                val msg: mut ref u8 = g_error
                if msg == none {
                    msg = u.s_dup(c"error")
                }
                report_error(c"", g_err_line, g_err_col, msg)
                code = 1
            } elif g_flow == 5 {
                code = u.script_exit_code
            } else {
                code = status_value()
            }
            if code < 0 {
                code = 0
            }
            rt.exit_now((code & 255) as i32)
            return
        }
        if pid < 0 {
            failed = 127
            break
        }
        u.vec_pushp(pids, v_int(pid as i64) as ref void)
        i++
    }
    val j: mut i64 = 0
    for {
        if j >= pids.len {
            break
        }
        val pid: i32 = num_i(u.vec_p(pids, j) as ref Value) as i32
        val status: mut i32 = 0
        val got: mut i32 = -1
        for {
            got = rt.waitpid(pid, @addr(status), 0)
            if got >= 0 || u.interrupt_flag == 0 {
                break
            }
        }
        if got >= 0 {
            val code: i64 = wait_status_code(status)
            if code != 0 && failed == 0 {
                failed = code
            }
        } elif failed == 0 {
            failed = 127
        }
        j++
    }
    if items.len > 0 {
        env_assign(env, n.s, u.vec_p(items, items.len - 1) as ref Value)
    }
    set_status(failed)
    if u.interrupt_flag != 0 {
        u.interrupt_flag = 0
        set_error(c"interrupted", n.line, n.col)
        return
    }
    if failed == 127 && pids.len == 0 {
        set_error(c"failed to start parallel iteration", n.line, n.col)
    }
}

fn exec_stmt(n: ref lang.Node, env: mut ref Env, toplevel: bool) void = trust {
    if n == none || g_flow != 0 {
        return
    }
    if n.kind == lang.NodeKind.Program {
        val i: mut i64 = 0
        for {
            if i >= n.kids.len {
                break
            }
            exec_stmt(u.vec_p(n.kids, i) as ref lang.Node, env, true)
            if g_flow != 0 {
                break
            }
            i++
        }
        return
    }
    if n.kind == lang.NodeKind.Block {
        exec_block(n, env, false)
        return
    }
    if n.kind == lang.NodeKind.Say {
        val b: mut ref u.Buf = u.buf_new()
        val i: mut i64 = 0
        for {
            if i >= n.kids.len {
                break
            }
            val v: ref Value = eval(u.vec_p(n.kids, i) as ref lang.Node, env)
            if g_flow != 0 {
                return
            }
            if i > 0 {
                u.buf_ch(b, 32)
            }
            u.buf_add(b, v_to_str(v))
            i++
        }
        u.buf_ch(b, 10)
        u.stdout_s(u.buf_take(b))
        return
    }
    if n.kind == lang.NodeKind.ExprStmt {
        val v: ref Value = eval(u.vec_p(n.kids, 0) as ref lang.Node, env)
        if toplevel && g_interactive != 0 && g_flow == 0 && !is_nil(v) {
            u.stdout_s(u.s_cat(v_to_str(v), c"\n"))
        }
        return
    }
    if n.kind == lang.NodeKind.Assign {
        val value: ref Value = eval(u.vec_p(n.kids, 1) as ref lang.Node, env)
        if g_flow != 0 {
            return
        }
        val target: ref lang.Node = u.vec_p(n.kids, 0) as ref lang.Node
        assign_target(target, value, env, n.a)
        if n.b != 0 && g_flow == 0 && target.kind == lang.NodeKind.Var {
            val bound: ref Value = env_lookup(env, target.s)
            u.env_set(target.s, v_to_str(bound))
        }
        return
    }
    if n.kind == lang.NodeKind.If {
        val pairs: i64 = n.a
        val i: mut i64 = 0
        for {
            if i >= pairs {
                break
            }
            val cond: ref Value = eval(u.vec_p(n.kids, i * 2) as ref lang.Node, env)
            if g_flow != 0 {
                return
            }
            if truthy(cond) {
                exec_block(u.vec_p(n.kids, i * 2 + 1) as ref lang.Node, env, false)
                return
            }
            i++
        }
        if n.b != 0 && pairs * 2 < n.kids.len {
            exec_block(u.vec_p(n.kids, pairs * 2) as ref lang.Node, env, false)
        }
        return
    }
    if n.kind == lang.NodeKind.While {
        for {
            if u.interrupt_flag != 0 {
                u.interrupt_flag = 0
                set_error(c"interrupted", n.line, n.col)
                break
            }
            if g_flow == 1 || g_flow == 2 {
                g_flow = 0
            }
            if g_flow != 0 {
                break
            }
            val cond: ref Value = eval(u.vec_p(n.kids, 0) as ref lang.Node, env)
            if g_flow != 0 {
                break
            }
            if !truthy(cond) {
                break
            }
            exec_block(u.vec_p(n.kids, 1) as ref lang.Node, env, false)
            if g_flow == 1 {
                g_flow = 0
                break
            }
            if g_flow == 2 {
                g_flow = 0
                continue
            }
            if g_flow != 0 {
                break
            }
        }
        return
    }
    if n.kind == lang.NodeKind.ParaFor {
        exec_para_for(n, env)
        return
    }
    if n.kind == lang.NodeKind.For {
        val iterable: ref Value = eval(u.vec_p(n.kids, 0) as ref lang.Node, env)
        if g_flow != 0 || iterable == none {
            return
        }
        if iterable.tag == 5 {
            val vec: ref u.Vec = iterable.p as ref u.Vec
            val i: mut i64 = 0
            for {
                if u.interrupt_flag != 0 {
                    u.interrupt_flag = 0
                    set_error(c"interrupted", n.line, n.col)
                    break
                }
                if i >= vec.len {
                    break
                }
                env_assign(env, n.s, u.vec_p(vec, i) as ref Value)
                exec_block(u.vec_p(n.kids, 1) as ref lang.Node, env, false)
                if g_flow == 1 {
                    g_flow = 0
                    break
                }
                if g_flow == 2 {
                    g_flow = 0
                    i++
                    continue
                }
                if g_flow != 0 {
                    break
                }
                i++
            }
        } elif iterable.tag == 4 {
            val s: ref u8 = iterable.p as ref u8
            val len: i64 = u.s_len(s)
            val i: mut i64 = 0
            for {
                if u.interrupt_flag != 0 {
                    u.interrupt_flag = 0
                    set_error(c"interrupted", n.line, n.col)
                    break
                }
                if i >= len {
                    break
                }
                val j: i64 = u.utf8_next(s, i, len)
                env_assign(env, n.s, v_str(u.s_substr(s, i, j)))
                exec_block(u.vec_p(n.kids, 1) as ref lang.Node, env, false)
                if g_flow == 1 {
                    g_flow = 0
                    break
                }
                if g_flow == 2 {
                    g_flow = 0
                    i = j
                    continue
                }
                if g_flow != 0 {
                    break
                }
                i = j
            }
        } elif iterable.tag == 6 {
            val m: ref u.Map = iterable.p as ref u.Map
            val i: mut i64 = 0
            for {
                if u.interrupt_flag != 0 {
                    u.interrupt_flag = 0
                    set_error(c"interrupted", n.line, n.col)
                    break
                }
                if i >= m.cap {
                    break
                }
                if u.map_used_at(m, i) {
                    env_assign(env, n.s, v_str(u.s_dup(u.map_key_at(m, i))))
                    exec_block(u.vec_p(n.kids, 1) as ref lang.Node, env, false)
                    if g_flow == 1 {
                        g_flow = 0
                        break
                    }
                    if g_flow == 2 {
                        g_flow = 0
                    } elif g_flow != 0 {
                        break
                    }
                }
                i++
            }
        }
        return
    }
    if n.kind == lang.NodeKind.FnDef {
        val f: mut ref Func = u.xalloc(@sizeof(Func) as i64) as ref Func
        f.name = n.s
        f.params = n.params
        f.body = u.vec_p(n.kids, 0) as ref lang.Node
        f.native = 0
        env_assign(env, n.s, v_func(f))
        return
    }
    if n.kind == lang.NodeKind.Return {
        val v: mut ref Value = v_nil()
        if n.kids.len > 0 {
            v = eval(u.vec_p(n.kids, 0) as ref lang.Node, env)
        }
        if g_flow != 0 {
            return
        }
        g_return = v
        g_flow = 3
        return
    }
    if n.kind == lang.NodeKind.Break {
        g_flow = 1
        return
    }
    if n.kind == lang.NodeKind.Continue {
        g_flow = 2
        return
    }
    if n.kind == lang.NodeKind.Pass {
        return
    }
    if n.kind == lang.NodeKind.Defer {
        defer_register(u.vec_p(n.kids, 0) as ref lang.Node, env)
        return
    }
    if n.kind == lang.NodeKind.Try {
        exec_block(u.vec_p(n.kids, 0) as ref lang.Node, env, false)
        if g_flow == 4 {
            val msg: mut ref u8 = g_error
            if msg == none {
                msg = u.s_dup(c"error")
            }
            g_error = none
            g_flow = 0
            if n.s != none {
                env_assign(env, n.s, v_str(msg))
            }
            if n.kids.len > 1 {
                exec_block(u.vec_p(n.kids, 1) as ref lang.Node, env, false)
            }
        }
        return
    }
    if n.kind == lang.NodeKind.Raise {
        val v: mut ref Value = v_nil()
        if n.kids.len > 0 {
            v = eval(u.vec_p(n.kids, 0) as ref lang.Node, env)
        }
        if g_flow != 0 {
            return
        }
        set_error(v_to_str(v), n.line, n.col)
        return
    }
    if n.kind == lang.NodeKind.ShellCmd {
        if u.hooks_ready == 0 {
            return
        }
        val hook: fn(ref u8) i32 = u.run_shell_hook
        val st: i32 = hook(n.s)
        set_status(st as i64)
        if u.interrupt_flag != 0 {
            u.interrupt_flag = 0
            set_error(c"interrupted", n.line, n.col)
        }
        return
    }
    // Remaining expression statements.
    val v: ref Value = eval(n, env)
    if toplevel && g_interactive != 0 && g_flow == 0 && !is_nil(v) {
        u.stdout_s(u.s_cat(v_to_str(v), c"\n"))
    }
}

fn exec_block(n: ref lang.Node, env: mut ref Env, toplevel: bool) void = trust {
    if n == none {
        return
    }
    val i: mut i64 = 0
    for {
        if i >= n.kids.len {
            break
        }
        exec_stmt(u.vec_p(n.kids, i) as ref lang.Node, env, toplevel)
        if g_flow != 0 {
            break
        }
        i++
    }
}

// ---------------------------------------------------------------------------
// Builtin bindings and entry points
// ---------------------------------------------------------------------------

fn define_native(env: mut ref Env, name: ref u8) void = trust {
    val f: mut ref Func = u.xalloc(@sizeof(Func) as i64) as ref Func
    f.name = u.s_dup(name)
    f.params = u.vec_new()
    f.body = none
    f.native = native_id(name)
    env_define(env, name, v_func(f))
}

pub fn script_init() void = trust {
    g_env = env_new_mode(none, true)
    g_error = none
    g_flow = 0
    g_return = none
    g_depth = 0
    g_interactive = 1
    g_script_path = none
    g_args = u.vec_new_perm()
    define_native(g_env, c"len")
    define_native(g_env, c"str")
    define_native(g_env, c"int")
    define_native(g_env, c"float")
    define_native(g_env, c"bool")
    define_native(g_env, c"range")
    define_native(g_env, c"print")
    define_native(g_env, c"input")
    define_native(g_env, c"sleep")
    define_native(g_env, c"exit")
    define_native(g_env, c"shell")
    define_native(g_env, c"capture")
    define_native(g_env, c"abs")
    define_native(g_env, c"min")
    define_native(g_env, c"max")
    define_native(g_env, c"sum")
    define_native(g_env, c"type")
    define_native(g_env, c"keys")
    define_native(g_env, c"values")
    define_native(g_env, c"items")
    define_native(g_env, c"read_file")
    define_native(g_env, c"write_file")
    define_native(g_env, c"append_file")
    define_native(g_env, c"env")
    define_native(g_env, c"clock")
    define_native(g_env, c"chr")
    define_native(g_env, c"ord")
    define_native(g_env, c"source")
    define_native(g_env, c"glob")
    define_native(g_env, c"rename")
    define_native(g_env, c"this")
    define_native(g_env, c"this_dir")
    define_native(g_env, c"run")
    define_native(g_env, c"eprint")
    define_native(g_env, c"indent")
    define_native(g_env, c"exists")
    define_native(g_env, c"is_file")
    define_native(g_env, c"is_dir")
    define_native(g_env, c"is_executable")
    define_native(g_env, c"which")
    define_native(g_env, c"mktemp_dir")
    define_native(g_env, c"remove_file")
    define_native(g_env, c"remove_all")
    define_native(g_env, c"parent")
    define_native(g_env, c"basename")
    define_native(g_env, c"stem")
    define_native(g_env, c"join")
    define_native(g_env, c"cd")
    define_native(g_env, c"unified_diff")
    g_defers = u.vec_new_perm()
    env_define(g_env, c"status", v_int(0))
    env_define(g_env, c"null", v_nil())
    env_define(g_env, c"true", v_bool(true))
    env_define(g_env, c"false", v_bool(false))
    env_define(g_env, c"args", v_list(g_args))
}

pub fn set_args(args: ref u.Vec) void = trust {
    g_args = u.vec_new_perm()
    val i: mut i64 = 0
    for {
        if i >= args.len {
            break
        }
        u.vec_pushp(g_args, v_str(u.vec_p(args, i) as ref u8) as ref void)
        i++
    }
    if g_env != none {
        env_define(g_env, c"args", v_list(g_args))
    }
}

fn memo_get(memo: ref u.Vec, old: i64) ref void = trust {
    val i: mut i64 = 0
    for {
        if i + 1 >= memo.len {
            break
        }
        if u.vec_gets(memo, i) == old {
            return u.vec_p(memo, i + 1)
        }
        i += 2
    }
    return none
}

fn memo_put(memo: mut ref u.Vec, old: ref void, new: ref void) void = trust {
    u.vec_push(memo, @bitcast(old, i64))
    u.vec_pushp(memo, new)
}

fn enqueue(jobs: mut ref u.Vec, old: ref void, kind: i64, slot: ref void) void = trust {
    if old == none {
        if slot != none {
            @store64(slot, 0)
        }
        return
    }
    u.vec_push(jobs, @bitcast(old, i64))
    u.vec_push(jobs, kind)
    u.vec_pushp(jobs, slot)
}

fn queue_value_children(v: mut ref Value, jobs: mut ref u.Vec) void = trust {
    if v.tag == 4 {
        enqueue(jobs, v.p, 0, @ptradd(v as ref void, 16))
    } elif v.tag == 5 {
        enqueue(jobs, v.p, 2, @ptradd(v as ref void, 16))
    } elif v.tag == 6 {
        enqueue(jobs, v.p, 3, @ptradd(v as ref void, 16))
    } elif v.tag == 7 {
        enqueue(jobs, v.p, 4, @ptradd(v as ref void, 16))
    }
}

fn queue_vec_from(
    src: ref u.Vec,
    dst: ref u.Vec,
    kind: i64,
    jobs: mut ref u.Vec
) void = trust {
    val i: mut i64 = 0
    for {
        if i >= src.len {
            break
        }
        enqueue(jobs, u.vec_p(src, i), kind, @ptradd(dst.data, i * 8))
        i++
    }
}

fn queue_map_children(m: mut ref u.Map, jobs: mut ref u.Vec) void = trust {
    val i: mut i64 = 0
    for {
        if i >= m.cap {
            break
        }
        if u.map_used_at(m, i) {
            val e: mut ref u.MapEntry = u.map_entry_at(m, i)
            enqueue(
                jobs,
                @bitcast(e.value, ref void),
                1,
                @addr(e.value) as ref void
            )
        }
        i++
    }
}

fn queue_func_children(f: mut ref Func, jobs: mut ref u.Vec) void = trust {
    enqueue(jobs, f.name as ref void, 0, @ptradd(f as ref void, 0))
    enqueue(jobs, f.params as ref void, 7, @ptradd(f as ref void, 8))
    enqueue(jobs, f.body as ref void, 5, @ptradd(f as ref void, 16))
}

fn queue_node_children(n: mut ref lang.Node, jobs: mut ref u.Vec) void = trust {
    enqueue(jobs, n.s as ref void, 0, @ptradd(n as ref void, 24))
    enqueue(jobs, n.kids as ref void, 6, @ptradd(n as ref void, 32))
    enqueue(jobs, n.params as ref void, 7, @ptradd(n as ref void, 40))
}

fn queue_env_children(e: mut ref Env, jobs: mut ref u.Vec) void = trust {
    enqueue(jobs, e.vars as ref void, 3, @ptradd(e as ref void, 0))
    enqueue(jobs, e.parent as ref void, 8, @ptradd(e as ref void, 8))
}

fn store_slot(slot: ref void, p: ref void) void = trust {
    if slot != none {
        @store64(slot, @bitcast(p, i64))
    }
}

fn promote_all(jobs: mut ref u.Vec, memo: mut ref u.Vec) void = trust {
    val i: mut i64 = 0
    for {
        if i + 2 >= jobs.len {
            break
        }
        val old: ref void = @bitcast(u.vec_gets(jobs, i), ref void)
        val kind: i64 = u.vec_gets(jobs, i + 1)
        val slot: ref void = u.vec_p(jobs, i + 2)
        i += 3
        if old == none {
            store_slot(slot, none)
            continue
        }
        val found: ref void = memo_get(memo, @bitcast(old, i64))
        if found != none {
            store_slot(slot, found)
            continue
        }
        if kind == 0 {
            val ns: ref u8 = u.s_dup_perm(old as ref u8)
            memo_put(memo, old, ns as ref void)
            store_slot(slot, ns as ref void)
            continue
        }
        if kind == 1 {
            val ov: ref Value = old as ref Value
            val nv: mut ref Value = u.xalloc_perm(@sizeof(Value) as i64) as ref Value
            nv.tag = ov.tag
            nv.i = ov.i
            nv.p = ov.p
            memo_put(memo, old, nv as ref void)
            store_slot(slot, nv as ref void)
            queue_value_children(nv, jobs)
            continue
        }
        if kind == 2 {
            val ov: ref u.Vec = old as ref u.Vec
            val nv: mut ref u.Vec = u.vec_new_perm()
            nv.perm = 1
            u.vec_reserve(nv, ov.len)
            nv.len = ov.len
            memo_put(memo, old, nv as ref void)
            store_slot(slot, nv as ref void)
            queue_vec_from(ov, nv, 1, jobs)
            continue
        }
        if kind == 3 {
            val om: ref u.Map = old as ref u.Map
            val nm: mut ref u.Map = u.map_new_perm()
            nm.perm = 1
            val k: mut i64 = 0
            for {
                if k >= om.cap {
                    break
                }
                if u.map_used_at(om, k) {
                    u.map_put(
                        nm,
                        u.map_key_at(om, k),
                        u.map_val_at(om, k)
                    )
                }
                k++
            }
            memo_put(memo, old, nm as ref void)
            store_slot(slot, nm as ref void)
            queue_map_children(nm, jobs)
            continue
        }
        if kind == 4 {
            val of: ref Func = old as ref Func
            val nf: mut ref Func = u.xalloc_perm(@sizeof(Func) as i64) as ref Func
            nf.name = of.name
            nf.params = of.params
            nf.body = of.body
            nf.native = of.native
            memo_put(memo, old, nf as ref void)
            store_slot(slot, nf as ref void)
            queue_func_children(nf, jobs)
            continue
        }
        if kind == 5 {
            val on: ref lang.Node = old as ref lang.Node
            val nn: mut ref lang.Node = u.xalloc_perm(@sizeof(lang.Node) as i64) as ref lang.Node
            nn.kind = on.kind
            nn.a = on.a
            nn.b = on.b
            nn.s = on.s
            nn.kids = on.kids
            nn.params = on.params
            nn.line = on.line
            nn.col = on.col
            memo_put(memo, old, nn as ref void)
            store_slot(slot, nn as ref void)
            queue_node_children(nn, jobs)
            continue
        }
        if kind == 6 {
            val ov: ref u.Vec = old as ref u.Vec
            val nv: mut ref u.Vec = u.vec_new_perm()
            nv.perm = 1
            u.vec_reserve(nv, ov.len)
            nv.len = ov.len
            memo_put(memo, old, nv as ref void)
            store_slot(slot, nv as ref void)
            queue_vec_from(ov, nv, 5, jobs)
            continue
        }
        if kind == 7 {
            val ov: ref u.Vec = old as ref u.Vec
            val nv: mut ref u.Vec = u.vec_new_perm()
            nv.perm = 1
            u.vec_reserve(nv, ov.len)
            nv.len = ov.len
            memo_put(memo, old, nv as ref void)
            store_slot(slot, nv as ref void)
            queue_vec_from(ov, nv, 0, jobs)
            continue
        }
        val oe: ref Env = old as ref Env
        val ne: mut ref Env = u.xalloc_perm(@sizeof(Env) as i64) as ref Env
        ne.vars = oe.vars
        ne.parent = oe.parent
        memo_put(memo, old, ne as ref void)
        store_slot(slot, ne as ref void)
        queue_env_children(ne, jobs)
    }
}

fn promote_roots() void = trust {
    u.gc_start()
    val memo: mut ref u.Vec = u.vec_new()
    val jobs: mut ref u.Vec = u.vec_new()
    val old_env: ref void = g_env as ref void
    val old_args: ref void = g_args as ref void
    val old_ret: ref void = g_return as ref void
    val old_err: ref void = g_error as ref void
    enqueue(jobs, old_env, 8, none)
    enqueue(jobs, old_args, 2, none)
    enqueue(jobs, old_ret, 1, none)
    enqueue(jobs, old_err, 0, none)
    promote_all(jobs, memo)
    u.gc_finish()
    if old_env != none {
        g_env = memo_get(memo, @bitcast(old_env, i64)) as ref Env
    }
    if old_args != none {
        g_args = memo_get(memo, @bitcast(old_args, i64)) as ref u.Vec
    }
    if old_ret != none {
        g_return = memo_get(memo, @bitcast(old_ret, i64)) as ref Value
    }
    if old_err != none {
        g_error = memo_get(memo, @bitcast(old_err, i64)) as ref u8
    }
}

fn report_error(label: ref u8, line: i64, col: i64, msg: ref u8) void = trust {
    val b: mut ref u.Buf = u.buf_new()
    u.buf_add(b, c"blood: ")
    if label != none && u.s_len(label) > 0 {
        u.buf_add(b, label)
        u.buf_add(b, c":")
    }
    u.buf_add(b, u.s_int(line))
    u.buf_add(b, c":")
    u.buf_add(b, u.s_int(col))
    u.buf_add(b, c": ")
    u.buf_add(b, msg)
    u.buf_ch(b, 10)
    u.write_fd(2, u.buf_take(b))
}

pub fn run_text(src: ref u8, interactive: bool, label: ref u8) i32 = trust {
    if g_env == none {
        script_init()
    }
    u.scratch_begin()
    g_run_depth++
    u.script_exit_code = -1
    g_error = none
    g_flow = 0
    g_return = none
    g_interactive = 0
    if interactive {
        g_interactive = 1
    }
    val program: ref lang.Node = lang.parse(src)
    if lang.last_error() != none {
        report_error(label, lang.last_error_line(), lang.last_error_col(), lang.last_error())
        g_run_depth--
        u.scratch_end()
        return 2
    }
    defer_push_frame()
    exec_stmt(program, g_env, true)
    defer_run_frame()
    if g_run_depth == 1 {
        promote_roots()
    }
    if g_flow == 5 {
        g_flow = 0
        val code: i32 = u.script_exit_code as i32
        g_run_depth--
        u.scratch_end()
        return code
    }
    if g_flow == 4 {
        val msg: mut ref u8 = g_error
        if msg == none {
            msg = u.s_dup(c"evaluation error")
        }
        if u.s_eq(msg, c"interrupted") && g_interactive != 0 {
            g_error = none
            g_flow = 0
            g_run_depth--
            u.scratch_end()
            return 130
        }
        report_error(label, g_err_line, g_err_col, msg)
        g_error = none
        g_flow = 0
        g_run_depth--
        u.scratch_end()
        return 1
    }
    g_flow = 0
    g_run_depth--
    u.scratch_end()
    return 0
}

pub fn run_file(path: ref u8) i32 = trust {
    u.scratch_begin()
    val resolved: ref u8 = u.absolute_path(path)
    val src: ref u8 = u.read_file(resolved)
    if src == none {
        u.write_fd(2, u.s_cat3(c"blood: ", path, c": cannot read script\n"))
        u.scratch_end()
        return 1
    }
    if g_env == none {
        script_init()
    }
    val previous: ref u8 = g_script_path
    val previous_exit: i64 = u.script_exit_code
    g_script_path = resolved
    env_define(g_env, c"__file__", v_str(path))
    val st: i32 = run_text(src, false, path)
    g_script_path = previous
    u.script_exit_code = previous_exit
    u.scratch_end()
    return st
}

pub fn run_interactive(src: ref u8) i32 = trust {
    return run_text(src, true, c"")
}

pub fn set_external_status(st: i64) void = trust {
    if g_env == none {
        script_init()
    }
    set_status(st)
}

pub fn status_value() i64 = trust {
    if g_env == none {
        return 0
    }
    val v: ref Value = env_lookup(g_env, c"status")
    if v == none {
        return 0
    }
    return num_i(v)
}

pub fn has_error() bool = trust {
    return g_error != none
}

pub fn looks_like_script(line: ref u8) bool = trust {
    val t: ref u8 = u.s_trim(line)
    if u.s_len(t) == 0 {
        return false
    }
    if @load8(t) == 35 {
        return true
    }
    if (u.s_ends_with(
            t,
            c".blood"
        ) || u.s_ends_with(t, c".bx")) && !u.s_contains(t, c" ") && u.file_exists(t) {
        return false
    }
    if u.s_starts(
        t,
        c"say "
    ) || u.s_eq(
        t,
        c"say"
    ) || u.s_starts(
        t,
        c"if "
    ) || u.s_starts(
        t,
        c"elif "
    ) || u.s_starts(
        t,
        c"else"
    ) || u.s_starts(
        t,
        c"while "
    ) || u.s_starts(
        t,
        c"for "
    ) || u.s_starts(
        t,
        c"para "
    ) || u.s_starts(
        t,
        c"fn "
    ) || u.s_starts(
        t,
        c"def "
    ) || u.s_starts(
        t,
        c"return"
    ) || u.s_starts(
        t,
        c"break"
    ) || u.s_starts(
        t,
        c"continue"
    ) || u.s_starts(
        t,
        c"pass"
    ) || u.s_starts(
        t,
        c"try"
    ) || u.s_starts(
        t,
        c"catch"
    ) || u.s_starts(t, c"except") || u.s_starts(t, c"raise ") || u.s_starts(t, c"throw ") {
        return true
    }
    if @load8(t) == 91 || @load8(t) == 123 {
        return true
    }
    // Assignment with whitespace before '=' is script syntax.
    val n: i64 = u.s_len(t)
    val first: u8 = @load8(t)
    if (first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95 {
        val i: mut i64 = 1
        for {
            if i >= n {
                break
            }
            val c: u8 = @load8(@ptradd(t, i))
            if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
                i++
                continue
            }
            break
        }
        if i < n {
            val c: u8 = @load8(@ptradd(t, i))
            if c == 40 || c == 91 || c == 46 {
                return true
            }
            if c == 32 || c == 9 {
                val j: mut i64 = i
                for {
                    if j >= n {
                        break
                    }
                    val d: u8 = @load8(@ptradd(t, j))
                    if d != 32 && d != 9 {
                        break
                    }
                    j++
                }
                if j < n {
                    val d: u8 = @load8(@ptradd(t, j))
                    if d == 61 && !(j + 1 < n && @load8(@ptradd(t, j + 1)) == 61) {
                        return true
                    }
                    if (d == 43 || d == 45 || d == 42 || d == 47) && j + 1 < n && @load8(@ptradd(
                            t,
                            j + 1
                        )) == 61 {
                        return true
                    }
                }
            }
        }
    }
    return false
}

pub fn needs_continuation(line: ref u8) bool = trust {
    val t: ref u8 = u.s_trim(line)
    val n: i64 = u.s_len(t)
    if n > 0 && @load8(@ptradd(t, n - 1)) == 92 {
        return true
    }
    if n > 0 && @load8(@ptradd(t, n - 1)) == 58 && looks_like_script(t) {
        return true
    }
    // Unbalanced quotes or brackets.
    val quote: mut u8 = 0
    val depth: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(t, i))
        if quote != 0 {
            if c == 92 {
                i += 2
                continue
            }
            if c == quote {
                quote = 0
            }
            i++
            continue
        }
        if c == 39 || c == 34 {
            quote = c
        } elif c == 40 || c == 91 || c == 123 {
            depth++
        } elif c == 41 || c == 93 || c == 125 {
            if depth > 0 {
                depth--
            }
        }
        i++
    }
    return quote != 0 || depth > 0
}
