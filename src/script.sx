/// Interpreter for the Blood scripting language.

val u    = use("util.sx")
val lang = use("lang.sx")
val term = use("terminal.sx")
val sh   = use("shell.sx")
val ex   = use("exec.sx")
val re   = use("std/regex")
val rt   = use("std/runtime")

pub type Value = {
    tag: mut i64
    i: mut i64
    p: mut ref void
}

pub type Env = {
    vars: mut ref u.Map
    parent: mut ref Env
}

pub type Func = {
    name: mut ref u8
    params: mut ref u.Vec
    body: mut ref lang.Node
    native: mut i64
}

type Defer = {
    node: mut ref lang.Node
    env: mut ref Env
}

val g_env: mut ref Env = none
val g_error: mut ref u8 = none
val g_err_line: mut i64 = 0
val g_err_col: mut i64 = 0
val g_flow: mut i64 = 0
val g_return: mut ref Value = none
val g_interactive: mut i64 = 1
val g_depth: mut i64 = 0
val g_run_depth: mut i64 = 0
val g_args: mut ref u.Vec = none
val g_script_path: mut ref u8 = none
val g_defers: mut ref u.Vec = none
val g_temp_seq: mut i64 = 0

fn v_new(tag: i64) ref Value = trust {
    val v: mut ref Value = u.xalloc(@sizeof(Value) as i64) as ref Value
    v.tag = tag
    v.i = 0
    v.p = none
    return v
}

pub fn v_nil() ref Value = trust {
    return v_new(0)
}

pub fn v_bool(b: bool) ref Value = trust {
    val v: mut ref Value = v_new(1)
    if b {
        v.i = 1
    }
    return v
}

pub fn v_int(n: i64) ref Value = trust {
    val v: mut ref Value = v_new(2)
    v.i = n
    return v
}

pub fn v_float(f: f64) ref Value = trust {
    val v: mut ref Value = v_new(3)
    v.i = @bitcast(f, i64)
    return v
}

pub fn v_str(s: ref u8) ref Value = trust {
    val v: mut ref Value = v_new(4)
    if s != none {
        v.p = u.s_dup(s)
    }
    return v
}

fn v_list(vec: ref u.Vec) ref Value = trust {
    val v: mut ref Value = v_new(5)
    v.p = vec
    return v
}

fn v_dict(m: ref u.Map) ref Value = trust {
    val v: mut ref Value = v_new(6)
    v.p = m
    return v
}

fn v_func(f: ref Func) ref Value = trust {
    val v: mut ref Value = v_new(7)
    v.p = f
    return v
}

fn is_nil(v: ref Value) bool = trust {
    return v == none || v.tag == 0
}

pub fn truthy(v: ref Value) bool = trust {
    if is_nil(v) {
        return false
    }
    if v.tag == 1 {
        return v.i != 0
    }
    if v.tag == 2 {
        return v.i != 0
    }
    if v.tag == 3 {
        return @bitcast(v.i, f64) != 0.0
    }
    if v.tag == 4 {
        return u.s_len(v.p as ref u8) > 0
    }
    if v.tag == 5 {
        val vec: ref u.Vec = v.p as ref u.Vec
        return vec.len > 0
    }
    if v.tag == 6 {
        val m: ref u.Map = v.p as ref u.Map
        return m.len > 0
    }
    return true
}

fn num_f(v: ref Value) f64 = trust {
    if v == none {
        return 0.0
    }
    if v.tag == 2 {
        return v.i as f64
    }
    if v.tag == 3 {
        return @bitcast(v.i, f64)
    }
    if v.tag == 1 {
        if v.i != 0 {
            return 1.0
        }
        return 0.0
    }
    if v.tag == 4 {
        match u.parse_float(v.p as ref u8) {
            some f => {
                return f
            }
            none => {
                return 0.0
            }
        }
    }
    return 0.0
}

fn num_i(v: ref Value) i64 = trust {
    if v == none {
        return 0
    }
    if v.tag == 2 {
        return v.i
    }
    if v.tag == 3 {
        return @bitcast(v.i, f64) as i64
    }
    if v.tag == 1 {
        return v.i
    }
    if v.tag == 4 {
        match u.parse_int(v.p as ref u8) {
            some n => {
                return n
            }
            none => {
                return 0
            }
        }
    }
    return 0
}

fn is_float_val(v: ref Value) bool = trust {
    return v != none && v.tag == 3
}

fn v_to_str(v: ref Value) ref u8 = trust {
    if is_nil(v) {
        return u.s_dup(c"null")
    }
    if v.tag == 1 {
        if v.i != 0 {
            return u.s_dup(c"true")
        }
        return u.s_dup(c"false")
    }
    if v.tag == 2 {
        return u.s_int(v.i)
    }
    if v.tag == 3 {
        return u.s_float(@bitcast(v.i, f64))
    }
    if v.tag == 4 {
        return v.p as ref u8
    }
    if v.tag == 7 {
        val f: ref Func = v.p as ref Func
        return u.s_cat3(c"<fn ", f.name, c">")
    }
    if v.tag == 5 {
        val vec: ref u.Vec = v.p as ref u.Vec
        val b: mut ref u.Buf = u.buf_new()
        u.buf_ch(b, 91)
        val i: mut i64 = 0
        for {
            if i >= vec.len {
                break
            }
            if i > 0 {
                u.buf_add(b, c", ")
            }
            u.buf_add(b, v_to_str(u.vec_p(vec, i) as ref Value))
            i++
        }
        u.buf_ch(b, 93)
        return u.buf_take(b)
    }
    if v.tag == 6 {
        val m: ref u.Map = v.p as ref u.Map
        val b: mut ref u.Buf = u.buf_new()
        u.buf_ch(b, 123)
        val i: mut i64 = 0
        val first: mut bool = true
        for {
            if i >= m.cap {
                break
            }
            if u.map_used_at(m, i) {
                if !first {
                    u.buf_add(b, c", ")
                }
                first = false
                u.buf_add(b, u.map_key_at(m, i))
                u.buf_add(b, c": ")
                u.buf_add(b, v_to_str(@bitcast(u.map_val_at(m, i), ref Value)))
            }
            i++
        }
        u.buf_ch(b, 125)
        return u.buf_take(b)
    }
    return u.s_dup(c"")
}

fn key_of(v: ref Value) ref u8 = trust {
    if v != none && v.tag == 4 {
        return v.p as ref u8
    }
    return v_to_str(v)
}

fn type_name(v: ref Value) ref u8 = trust {
    if is_nil(v) {
        return u.s_dup(c"null")
    }
    if v.tag == 1 {
        return u.s_dup(c"bool")
    }
    if v.tag == 2 {
        return u.s_dup(c"int")
    }
    if v.tag == 3 {
        return u.s_dup(c"float")
    }
    if v.tag == 4 {
        return u.s_dup(c"string")
    }
    if v.tag == 5 {
        return u.s_dup(c"list")
    }
    if v.tag == 6 {
        return u.s_dup(c"dict")
    }
    if v.tag == 7 {
        return u.s_dup(c"function")
    }
    return u.s_dup(c"unknown")
}

fn set_error(msg: ref u8, line: i64, col: i64) void = trust {
    if g_error == none {
        g_error = u.s_dup(msg)
        g_err_line = line
        g_err_col = col
    }
    g_flow = 4
}

fn env_new_mode(parent: ref Env, perm: bool) ref Env = trust {
    val e: mut ref Env = none
    if perm {
        e = u.xalloc_perm(@sizeof(Env) as i64) as ref Env
        e.vars = u.map_new_perm()
    } else {
        e = u.xalloc(@sizeof(Env) as i64) as ref Env
        e.vars = u.map_new()
    }
    e.parent = parent
    return e
}

fn env_new(parent: ref Env) ref Env = trust {
    return env_new_mode(parent, false)
}

fn env_define(e: mut ref Env, name: ref u8, v: ref Value) void = trust {
    u.map_put(e.vars, name, @bitcast(v, i64))
}

fn env_lookup(e: ref Env, name: ref u8) ref Value = trust {
    val chain: mut ref Env = e
    for {
        if chain == none {
            break
        }
        val raw: i64 = u.map_get(chain.vars, name)
        if raw != 0 {
            return @bitcast(raw, ref Value)
        }
        chain = chain.parent
    }
    return none
}

fn env_assign(e: mut ref Env, name: ref u8, v: ref Value) void = trust {
    val chain: mut ref Env = e
    for {
        if chain == none {
            break
        }
        if u.map_has(chain.vars, name) {
            u.map_put(chain.vars, name, @bitcast(v, i64))
            return
        }
        chain = chain.parent
    }
    env_define(e, name, v)
}

fn set_status(status: i64) void = trust {
    if g_env == none {
        return
    }
    env_assign(g_env, c"status", v_int(status))
}

fn defer_push_frame() void = trust {
    if g_defers == none {
        g_defers = u.vec_new_perm()
    }
    u.vec_pushp(g_defers, u.vec_new() as ref void)
}

fn defer_register(n: ref lang.Node, env: mut ref Env) void = trust {
    if g_defers == none || g_defers.len == 0 {
        return
    }
    val frame: mut ref u.Vec = u.vec_p(g_defers, g_defers.len - 1) as ref u.Vec
    val d: mut ref Defer = u.xalloc(@sizeof(Defer) as i64) as ref Defer
    d.node = n
    d.env = env
    u.vec_pushp(frame, d as ref void)
    env = env
}

fn defer_run_frame() void = trust {
    if g_defers == none || g_defers.len == 0 {
        return
    }
    val frame: ref u.Vec = u.vec_p(g_defers, g_defers.len - 1) as ref u.Vec
    g_defers.len--
    val saved_flow: mut i64 = g_flow
    val saved_error: mut ref u8 = g_error
    val saved_line: mut i64 = g_err_line
    val saved_col: mut i64 = g_err_col
    val saved_return: ref Value = g_return
    val saved_exit: mut i64 = u.script_exit_code
    g_flow = 0
    g_error = none
    val i: mut i64 = frame.len - 1
    for {
        if i < 0 {
            break
        }
        val d: mut ref Defer = u.vec_p(frame, i) as ref Defer
        g_flow = 0
        exec_stmt(d.node, d.env, false)
        if g_flow == 4 {
            if saved_flow != 4 {
                saved_flow = 4
                saved_error = g_error
                saved_line = g_err_line
                saved_col = g_err_col
            }
        } elif g_flow == 5 {
            if saved_flow != 5 {
                saved_flow = 5
                saved_exit = u.script_exit_code
            }
        }
        g_flow = 0
        g_error = none
        i--
    }
    g_flow = saved_flow
    g_error = saved_error
    g_err_line = saved_line
    g_err_col = saved_col
    g_return = saved_return
    u.script_exit_code = saved_exit
}

fn list_new() ref u.Vec = trust {
    return u.vec_new()
}

fn dict_new() ref u.Map = trust {
    return u.map_new()
}

fn bin_numeric(op: i64, a: ref Value, b: ref Value) ref Value = trust {
    if op == 3 {
        if !is_float_val(a) && !is_float_val(b) {
            val bi: i64 = num_i(b)
            if bi == 0 {
                set_error(c"division by zero", 0, 0)
                return v_nil()
            }
            return v_int(num_i(a) / bi)
        }
        return v_float(num_f(a) / num_f(b))
    }
    if op == 4 {
        val bi: i64 = num_i(b)
        if bi == 0 {
            set_error(c"division by zero", 0, 0)
            return v_nil()
        }
        return v_int(num_i(a) % bi)
    }
    if is_float_val(a) || is_float_val(b) {
        if op == 0 {
            return v_float(num_f(a) + num_f(b))
        }
        if op == 1 {
            return v_float(num_f(a) - num_f(b))
        }
        if op == 2 {
            return v_float(num_f(a) * num_f(b))
        }
    }
    if op == 0 {
        return v_int(num_i(a) + num_i(b))
    }
    if op == 1 {
        return v_int(num_i(a) - num_i(b))
    }
    if op == 2 {
        return v_int(num_i(a) * num_i(b))
    }
    return v_nil()
}

fn list_contains(vec: ref u.Vec, v: ref Value) bool = trust {
    val i: mut i64 = 0
    for {
        if i >= vec.len {
            break
        }
        if values_equal(u.vec_p(vec, i) as ref Value, v) {
            return true
        }
        i++
    }
    return false
}

fn values_equal(a: ref Value, b: ref Value) bool = trust {
    if is_nil(a) || is_nil(b) {
        return is_nil(a) && is_nil(b)
    }
    if (a.tag == 2 || a.tag == 3 || a.tag == 1) && (b.tag == 2 || b.tag == 3 || b.tag == 1) {
        if is_float_val(a) || is_float_val(b) {
            return num_f(a) == num_f(b)
        }
        return num_i(a) == num_i(b)
    }
    if a.tag != b.tag {
        return false
    }
    if a.tag == 4 {
        return u.s_eq(a.p as ref u8, b.p as ref u8)
    }
    if a.tag == 5 {
        val va: ref u.Vec = a.p as ref u.Vec
        val vb: ref u.Vec = b.p as ref u.Vec
        if va.len != vb.len {
            return false
        }
        val i: mut i64 = 0
        for {
            if i >= va.len {
                break
            }
            if !values_equal(u.vec_p(va, i) as ref Value, u.vec_p(vb, i) as ref Value) {
                return false
            }
            i++
        }
        return true
    }
    return a.i == b.i && a.p == b.p
}

fn bin_op(op: i64, a: ref Value, b: ref Value) ref Value = trust {
    if op == 0 {
        if (a != none && a.tag == 4) || (b != none && b.tag == 4) {
            return v_str(u.s_cat(v_to_str(a), v_to_str(b)))
        }
        if a != none && b != none && a.tag == 5 && b.tag == 5 {
            val va: ref u.Vec = a.p as ref u.Vec
            val vb: ref u.Vec = b.p as ref u.Vec
            val out: mut ref u.Vec = list_new()
            val i: mut i64 = 0
            for {
                if i >= va.len {
                    break
                }
                u.vec_pushp(out, u.vec_p(va, i))
                i++
            }
            val j: mut i64 = 0
            for {
                if j >= vb.len {
                    break
                }
                u.vec_pushp(out, u.vec_p(vb, j))
                j++
            }
            return v_list(out)
        }
        return bin_numeric(op, a, b)
    }
    if op == 1 || op == 2 || op == 3 || op == 4 {
        return bin_numeric(op, a, b)
    }
    if op == 5 {
        return v_bool(values_equal(a, b))
    }
    if op == 6 {
        return v_bool(!values_equal(a, b))
    }
    if op == 7 || op == 8 || op == 9 || op == 10 {
        if a != none && b != none && (a.tag == 4 || b.tag == 4) {
            val c: i64 = u.s_cmp(v_to_str(a), v_to_str(b))
            if op == 7 {
                return v_bool(c < 0)
            }
            if op == 8 {
                return v_bool(c > 0)
            }
            if op == 9 {
                return v_bool(c <= 0)
            }
            return v_bool(c >= 0)
        }
        val x: f64 = num_f(a)
        val y: f64 = num_f(b)
        if op == 7 {
            return v_bool(x < y)
        }
        if op == 8 {
            return v_bool(x > y)
        }
        if op == 9 {
            return v_bool(x <= y)
        }
        return v_bool(x >= y)
    }
    return v_nil()
}

fn in_op(a: ref Value, b: ref Value, negate: bool) ref Value = trust {
    val found: mut bool = false
    if b != none && b.tag == 5 {
        found = list_contains(b.p as ref u.Vec, a)
    } elif b != none && b.tag == 6 {
        found = u.map_has(b.p as ref u.Map, key_of(a))
    } elif b != none && b.tag == 4 {
        found = u.s_contains(b.p as ref u8, v_to_str(a))
    }
    if negate {
        return v_bool(!found)
    }
    return v_bool(found)
}

fn interp(raw: ref u8, env: mut ref Env) ref u8 = trust {
    val b: mut ref u.Buf = u.buf_new()
    val n: i64 = u.s_len(raw)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(raw, i))
        if c == 123 {
            if i + 1 < n && @load8(@ptradd(raw, i + 1)) == 123 {
                u.buf_ch(b, 123)
                i += 2
                continue
            }
            val depth: mut i64 = 1
            val start: i64 = i + 1
            val j: mut i64 = i + 1
            val quote: mut u8 = 0
            for {
                if j >= n {
                    break
                }
                val d: u8 = @load8(@ptradd(raw, j))
                if quote != 0 {
                    if d == 92 {
                        j += 2
                        continue
                    }
                    if d == quote {
                        quote = 0
                    }
                    j++
                    continue
                }
                if d == 34 || d == 39 {
                    quote = d
                    j++
                    continue
                }
                if d == 123 {
                    depth++
                } elif d == 125 {
                    depth--
                    if depth == 0 {
                        break
                    }
                }
                j++
            }
            if j < n {
                val expr: ref u8 = u.s_substr(raw, start, j)
                val node: ref lang.Node = lang.parse_expr_text(expr)
                if lang.last_error() != none {
                    u.buf_add(b, c"{")
                } else {
                    val fv: ref Value = eval(node, env)
                    u.buf_add(b, v_to_str(fv))
                }
                i = j + 1
                continue
            }
            u.buf_ch(b, 123)
            i++
            continue
        }
        if c == 125 && i + 1 < n && @load8(@ptradd(raw, i + 1)) == 125 {
            u.buf_ch(b, 125)
            i += 2
            continue
        }
        u.buf_ch(b, c)
        i++
    }
    return u.buf_take(b)
}

fn eval(n: ref lang.Node, env: mut ref Env) ref Value = trust {
    if n == none || g_flow != 0 {
        return v_nil()
    }
    if n.kind == lang.NodeKind.IntLit {
        return v_int(n.a)
    }
    if n.kind == lang.NodeKind.FloatLit {
        return v_float(@bitcast(n.a, f64))
    }
    if n.kind == lang.NodeKind.StrLit {
        if n.b != 0 {
            return v_str(n.s)
        }
        return v_str(interp(n.s, env))
    }
    if n.kind == lang.NodeKind.BoolLit {
        return v_bool(n.a != 0)
    }
    if n.kind == lang.NodeKind.NullLit {
        return v_nil()
    }
    if n.kind == lang.NodeKind.Var {
        val v: ref Value = env_lookup(env, n.s)
        if v == none {
            set_error(u.s_cat3(c"undefined variable '", n.s, c"'"), n.line, n.col)
            return v_nil()
        }
        return v
    }
    if n.kind == lang.NodeKind.ListLit {
        val vec: mut ref u.Vec = list_new()
        val i: mut i64 = 0
        for {
            if i >= n.kids.len {
                break
            }
            val item: ref lang.Node = u.vec_p(n.kids, i) as ref lang.Node
            if item.kind == lang.NodeKind.Spread {
                val spread: ref Value = eval(u.vec_p(item.kids, 0) as ref lang.Node, env)
                if g_flow != 0 {
                    return v_nil()
                }
                if spread != none && spread.tag == 5 {
                    val src: ref u.Vec = spread.p as ref u.Vec
                    val j: mut i64 = 0
                    for {
                        if j >= src.len {
                            break
                        }
                        u.vec_pushp(vec, u.vec_p(src, j))
                        j++
                    }
                }
            } else {
                u.vec_pushp(vec, eval(item, env) as ref void)
            }
            i++
        }
        return v_list(vec)
    }
    if n.kind == lang.NodeKind.DictLit {
        val m: mut ref u.Map = dict_new()
        val i: mut i64 = 0
        for {
            if i + 1 >= n.kids.len {
                break
            }
            val k: ref u8 = key_of(eval(u.vec_p(n.kids, i) as ref lang.Node, env))
            val v: ref Value = eval(u.vec_p(n.kids, i + 1) as ref lang.Node, env)
            u.map_put(m, k, @bitcast(v, i64))
            i += 2
        }
        return v_dict(m)
    }
    if n.kind == lang.NodeKind.Unary {
        val v: ref Value = eval(u.vec_p(n.kids, 0) as ref lang.Node, env)
        if n.a == lang.UnOp.Not as i64 {
            return v_bool(!truthy(v))
        }
        if is_float_val(v) {
            return v_float(0.0 - num_f(v))
        }
        return v_int(0 - num_i(v))
    }
    if n.kind == lang.NodeKind.Binary {
        if n.a == 100 {
            val l: ref Value = eval(u.vec_p(n.kids, 0) as ref lang.Node, env)
            if truthy(l) {
                return l
            }
            return eval(u.vec_p(n.kids, 1) as ref lang.Node, env)
        }
        if n.a == 101 {
            val l: ref Value = eval(u.vec_p(n.kids, 0) as ref lang.Node, env)
            if !truthy(l) {
                return l
            }
            return eval(u.vec_p(n.kids, 1) as ref lang.Node, env)
        }
        val l: ref Value = eval(u.vec_p(n.kids, 0) as ref lang.Node, env)
        val r: ref Value = eval(u.vec_p(n.kids, 1) as ref lang.Node, env)
        if g_flow != 0 {
            return v_nil()
        }
        if n.a == lang.BinOp.In as i64 {
            return in_op(l, r, false)
        }
        if n.a == lang.BinOp.NotIn as i64 {
            return in_op(l, r, true)
        }
        return bin_op(n.a, l, r)
    }
    if n.kind == lang.NodeKind.Index {
        val obj: ref Value = eval(u.vec_p(n.kids, 0) as ref lang.Node, env)
        val idx: ref Value = eval(u.vec_p(n.kids, 1) as ref lang.Node, env)
        return do_index(obj, idx, n)
    }
    if n.kind == lang.NodeKind.Attr {
        val obj: ref Value = eval(u.vec_p(n.kids, 0) as ref lang.Node, env)
        if obj != none && obj.tag == 6 {
            val m: mut ref u.Map = obj.p as ref u.Map
            val raw: i64 = u.map_get(m, n.s)
            if raw != 0 {
                return @bitcast(raw, ref Value)
            }
        }
        return v_nil()
    }
    if n.kind == lang.NodeKind.CmdSubst {
        if u.hooks_ready == 0 {
            return v_str(u.s_dup(c""))
        }
        val hook: fn(ref u8) ref u8 = u.run_capture_hook
        val out: ref u8 = hook(n.s)
        set_status(u.hook_status)
        if out == none {
            return v_str(u.s_dup(c""))
        }
        val m: mut i64 = u.s_len(out)
        for {
            if m <= 0 {
                break
            }
            val c: u8 = @load8(@ptradd(out, m - 1))
            if c != 10 && c != 13 {
                break
            }
            m--
        }
        return v_str(u.s_substr(out, 0, m))
    }
    if n.kind == lang.NodeKind.Call {
        val callee: ref lang.Node = u.vec_p(n.kids, 0) as ref lang.Node
        if callee.kind == lang.NodeKind.Attr {
            val obj: ref Value = eval(u.vec_p(callee.kids, 0) as ref lang.Node, env)
            val args: ref u.Vec = eval_args(n, 1, env)
            return call_method(obj, callee.s, args, n)
        }
        val fnval: ref Value = eval(callee, env)
        if g_flow != 0 {
            return v_nil()
        }
        if fnval == none || fnval.tag != 7 {
            set_error(c"attempt to call a non-function value", n.line, n.col)
            return v_nil()
        }
        val args: ref u.Vec = eval_args(n, 1, env)
        return call_func(fnval.p as ref Func, args, n)
    }
    return v_nil()
}

fn eval_args(n: ref lang.Node, from: i64, env: mut ref Env) ref u.Vec = trust {
    val args: mut ref u.Vec = u.vec_new()
    val i: mut i64 = from
    for {
        if i >= n.kids.len {
            break
        }
        val v: ref Value = eval(u.vec_p(n.kids, i) as ref lang.Node, env)
        u.vec_pushp(args, v)
        i++
    }
    return args
}

fn do_index(obj: ref Value, idx: ref Value, n: ref lang.Node) ref Value = trust {
    if obj == none {
        set_error(c"cannot index a null value", n.line, n.col)
        return v_nil()
    }
    if obj.tag == 5 {
        val vec: mut ref u.Vec = obj.p as ref u.Vec
        val i: mut i64 = num_i(idx)
        if i < 0 {
            i = vec.len + i
        }
        if i < 0 || i >= vec.len {
            set_error(c"list index out of range", n.line, n.col)
            return v_nil()
        }
        return u.vec_p(vec, i) as ref Value
    }
    if obj.tag == 6 {
        val m: mut ref u.Map = obj.p as ref u.Map
        val raw: i64 = u.map_get(m, key_of(idx))
        if raw == 0 {
            return v_nil()
        }
        return @bitcast(raw, ref Value)
    }
    if obj.tag == 4 {
        val s: ref u8 = obj.p as ref u8
        val i: mut i64 = num_i(idx)
        val len: i64 = u.s_len(s)
        if i < 0 {
            i = len + i
        }
        if i < 0 || i >= len {
            set_error(c"string index out of range", n.line, n.col)
            return v_nil()
        }
        val e: i64 = u.utf8_next(s, i, len)
        return v_str(u.s_substr(s, i, e))
    }
    set_error(c"value is not indexable", n.line, n.col)
    return v_nil()
}

fn call_func(f: ref Func, args: ref u.Vec, n: ref lang.Node) ref Value = trust {
    if f.native != 0 {
        return call_native(f.native, args, n)
    }
    if g_depth > 200 {
        set_error(c"recursion limit exceeded", n.line, n.col)
        return v_nil()
    }
    g_depth++
    val callenv: mut ref Env = env_new(g_env)
    val i: mut i64 = 0
    for {
        if i >= f.params.len {
            break
        }
        env_define(callenv, u.vec_p(f.params, i) as ref u8, v_nil())
        i++
    }
    val pos: mut i64 = 0
    val ai: mut i64 = 0
    for {
        if ai >= args.len {
            break
        }
        val arg: ref Value = u.vec_p(args, ai) as ref Value
        val name: ref u8 = arg_name(n, ai)
        if u.s_len(name) == 0 {
            if pos < f.params.len {
                env_define(callenv, u.vec_p(f.params, pos) as ref u8, arg)
                pos++
            }
        } else {
            val j: mut i64 = 0
            val found: mut bool = false
            for {
                if j >= f.params.len {
                    break
                }
                if u.s_eq(u.vec_p(f.params, j) as ref u8, name) {
                    env_define(callenv, name, arg)
                    found = true
                    break
                }
                j++
            }
            if !found {
                g_depth--
                set_error(u.s_cat3(c"unknown parameter '", name, c"'"), n.line, n.col)
                return v_nil()
            }
        }
        ai++
    }
    defer_push_frame()
    val saved_flow: i64 = g_flow
    val saved_return: ref Value = g_return
    g_flow = 0
    g_return = none
    exec_block(f.body, callenv, false)
    val result: mut ref Value = v_nil()
    if g_flow == 3 {
        if g_return != none {
            result = g_return
        }
    }
    defer_run_frame()
    if g_flow == 4 || g_flow == 5 {
        // propagate error/exit
    } else {
        g_flow = saved_flow
    }
    g_return = saved_return
    g_depth--
    return result
}

fn native_id(name: ref u8) i64 = trust {
    if u.s_eq(name, c"len") {
        return 1
    }
    if u.s_eq(name, c"str") {
        return 2
    }
    if u.s_eq(name, c"int") {
        return 3
    }
    if u.s_eq(name, c"float") {
        return 4
    }
    if u.s_eq(name, c"bool") {
        return 5
    }
    if u.s_eq(name, c"range") {
        return 6
    }
    if u.s_eq(name, c"print") {
        return 7
    }
    if u.s_eq(name, c"input") {
        return 8
    }
    if u.s_eq(name, c"sleep") {
        return 9
    }
    if u.s_eq(name, c"exit") {
        return 10
    }
    if u.s_eq(name, c"shell") {
        return 11
    }
    if u.s_eq(name, c"capture") {
        return 12
    }
    if u.s_eq(name, c"abs") {
        return 13
    }
    if u.s_eq(name, c"min") {
        return 14
    }
    if u.s_eq(name, c"max") {
        return 15
    }
    if u.s_eq(name, c"sum") {
        return 16
    }
    if u.s_eq(name, c"type") {
        return 17
    }
    if u.s_eq(name, c"keys") {
        return 18
    }
    if u.s_eq(name, c"values") {
        return 19
    }
    if u.s_eq(name, c"read_file") {
        return 20
    }
    if u.s_eq(name, c"write_file") {
        return 21
    }
    if u.s_eq(name, c"append_file") {
        return 22
    }
    if u.s_eq(name, c"env") {
        return 23
    }
    if u.s_eq(name, c"clock") {
        return 24
    }
    if u.s_eq(name, c"chr") {
        return 25
    }
    if u.s_eq(name, c"ord") {
        return 26
    }
    if u.s_eq(name, c"items") {
        return 27
    }
    if u.s_eq(name, c"source") {
        return 28
    }
    if u.s_eq(name, c"glob") {
        return 29
    }
    if u.s_eq(name, c"rename") {
        return 30
    }
    if u.s_eq(name, c"this") {
        return 31
    }
    if u.s_eq(name, c"this_dir") {
        return 32
    }
    if u.s_eq(name, c"run") {
        return 33
    }
    if u.s_eq(name, c"eprint") {
        return 34
    }
    if u.s_eq(name, c"indent") {
        return 35
    }
    if u.s_eq(name, c"exists") {
        return 36
    }
    if u.s_eq(name, c"is_file") {
        return 37
    }
    if u.s_eq(name, c"is_dir") {
        return 38
    }
    if u.s_eq(name, c"is_executable") {
        return 39
    }
    if u.s_eq(name, c"which") {
        return 40
    }
    if u.s_eq(name, c"mktemp_dir") {
        return 41
    }
    if u.s_eq(name, c"remove_file") {
        return 42
    }
    if u.s_eq(name, c"remove_all") {
        return 43
    }
    if u.s_eq(name, c"parent") {
        return 44
    }
    if u.s_eq(name, c"basename") {
        return 45
    }
    if u.s_eq(name, c"stem") {
        return 46
    }
    if u.s_eq(name, c"join") {
        return 47
    }
    if u.s_eq(name, c"cd") {
        return 48
    }
    if u.s_eq(name, c"unified_diff") {
        return 49
    }
    return 0
}

fn arg(args: ref u.Vec, i: i64) ref Value = trust {
    if i >= args.len {
        return v_nil()
    }
    return u.vec_p(args, i) as ref Value
}

fn arg_name(n: ref lang.Node, i: i64) ref u8 = trust {
    if n == none || i >= n.params.len {
        return c""
    }
    return u.vec_p(n.params, i) as ref u8
}

fn named_index(n: ref lang.Node, name: ref u8, count: i64) i64 = trust {
    val i: mut i64 = 0
    for {
        if i >= count {
            break
        }
        if u.s_eq(arg_name(n, i), name) {
            return i
        }
        i++
    }
    return -1
}

fn arg_named(n: ref lang.Node, args: ref u.Vec, name: ref u8) ref Value = trust {
    val idx: i64 = named_index(n, name, args.len)
    if idx < 0 {
        return v_nil()
    }
    return arg(args, idx)
}

fn v_result(status: i64, out: ref u8, errs: ref u8) ref Value = trust {
    val m: mut ref u.Map = dict_new()
    u.map_put(m, c"status", @bitcast(v_int(status), i64))
    u.map_put(m, c"stdout", @bitcast(v_str(out), i64))
    u.map_put(m, c"stderr", @bitcast(v_str(errs), i64))
    u.map_put(m, c"ok", @bitcast(v_bool(status == 0), i64))
    return v_dict(m)
}

fn result_status(v: ref Value) i64 = trust {
    if v == none || v.tag != 6 {
        return 127
    }
    val m: ref u.Map = v.p as ref u.Map
    val raw: i64 = u.map_get(m, c"status")
    if raw == 0 {
        return 127
    }
    return num_i(@bitcast(raw, ref Value))
}

fn drain_fd(fd: i32, b: mut ref u.Buf, chunk: ref u8, timeout: i32) i64 = trust {
    val pf: mut ex.PollFd = @zeroed
    pf.fd = fd
    pf.events = 1
    pf.revents = 0
    val ready: i32 = rt.poll(@addr(pf) as ref void, 1, timeout)
    if ready <= 0 {
        return 0
    }
    val n: i64 = ex.fd_read(fd, chunk, 4096)
    if n <= 0 {
        return -1
    }
    u.buf_addn(b, chunk, n)
    return 1
}

fn spawn_result(
    argv: ref u.Vec,
    command: ref u8,
    as_shell: bool,
    merge: bool,
    cwd: ref u8
) ref Value = trust {
    val outp: ex.Pipe = ex.make_pipe()
    val errp: mut ex.Pipe = @zeroed
    val has_err: bool = !merge
    if has_err {
        errp = ex.make_pipe()
    }
    val pid: i32 = ex.p_fork()
    if pid == 0 {
        ex.child_reset()
        ex.fd_close(outp.read_fd)
        if has_err {
            ex.fd_close(errp.read_fd)
        }
        ex.fd_dup2(outp.write_fd, 1)
        if has_err {
            ex.fd_dup2(errp.write_fd, 2)
            ex.fd_close(errp.write_fd)
        } else {
            ex.fd_dup2(outp.write_fd, 2)
        }
        ex.fd_close(outp.write_fd)
        if cwd != none && u.s_len(cwd) > 0 && u.chdir(u.expand_tilde(cwd)) != 0 {
            u.write_fd(2, u.s_cat3(c"blood: run: ", cwd, c": cannot change directory\n"))
            ex.p_exit(127)
        }
        if as_shell {
            val st: i32 = sh.run_line(command)
            ex.p_exit(st)
        }
        ex.child_exec(argv)
        ex.p_exit(127)
    }
    ex.fd_close(outp.write_fd)
    if has_err {
        ex.fd_close(errp.write_fd)
    }
    if pid < 0 {
        ex.fd_close(outp.read_fd)
        if has_err {
            ex.fd_close(errp.read_fd)
        }
        return v_result(127, c"", c"blood: fork failed\n")
    }
    val outb: mut ref u.Buf = u.buf_new()
    val errb: mut ref u.Buf = u.buf_new()
    val chunk: ref u8 = u.xalloc(4096 as usize) as ref u8
    val out_open: mut i64 = 1
    val err_open: mut i64 = 0
    if has_err {
        err_open = 1
    }
    for {
        if out_open == 0 && err_open == 0 {
            break
        }
        val did: mut i64 = 0
        if out_open != 0 {
            val r: i64 = drain_fd(outp.read_fd, outb, chunk, 0)
            if r == 1 {
                did = 1
            } elif r < 0 {
                out_open = 0
            }
        }
        if err_open != 0 {
            val r: i64 = drain_fd(errp.read_fd, errb, chunk, 0)
            if r == 1 {
                did = 1
            } elif r < 0 {
                err_open = 0
            }
        }
        if did == 0 {
            if out_open != 0 {
                val r: i64 = drain_fd(outp.read_fd, outb, chunk, 50)
                if r < 0 {
                    out_open = 0
                }
            } elif err_open != 0 {
                val r: i64 = drain_fd(errp.read_fd, errb, chunk, 50)
                if r < 0 {
                    err_open = 0
                }
            }
        }
    }
    u.xfree(chunk)
    ex.fd_close(outp.read_fd)
    if has_err {
        ex.fd_close(errp.read_fd)
    }
    val status: i64 = ex.wait_pid(pid) as i64
    return v_result(status, u.buf_take(outb), u.buf_take(errb))
}

fn remove_all_path(path: ref u8) bool = trust {
    if !u.file_exists(path) && !u.is_dir(path) {
        return true
    }
    if !u.is_dir(path) {
        return rt.unlink(path) == 0
    }
    val names: mut ref u.Vec = u.vec_new()
    val d: ref void = u.dir_open(path)
    if d == none {
        return false
    }
    for {
        val name: ref u8 = u.dir_next(d)
        if name == none {
            break
        }
        if u.s_eq(name, c".") || u.s_eq(name, c"..") {
            continue
        }
        u.vec_pushp(names, u.s_dup(name) as ref void)
    }
    u.dir_close(d)
    val i: mut i64 = 0
    for {
        if i >= names.len {
            break
        }
        remove_all_path(u.path_join(path, u.vec_p(names, i) as ref u8))
        i++
    }
    return rt.rmdir(path) == 0
}

fn temp_dir(prefix: ref u8) ref u8 = trust {
    val base: ref u8 = u.env_get(c"TMPDIR")
    val dir: mut ref u8 = c"/tmp"
    if base != none && u.s_len(base) > 0 {
        dir = base
    }
    val i: mut i64 = 0
    for {
        if i >= 100 {
            break
        }
        g_temp_seq++
        val name: ref u8 = u.s_cat3(
            prefix,
            c"-",
            u.s_cat3(u.s_int(u.now_ms()), c"-", u.s_int(g_temp_seq))
        )
        val path: ref u8 = u.path_join(dir, name)
        if rt.mkdir(path, 493 as u32) == 0 {
            return path
        }
        i++
    }
    return none
}

fn indent_text(s: ref u8, n: i64) ref u8 = trust {
    if n <= 0 || u.s_len(s) == 0 {
        return u.s_dup(s)
    }
    val b: mut ref u.Buf = u.buf_new()
    val len: i64 = u.s_len(s)
    val i: mut i64 = 0
    val at_start: mut bool = true
    for {
        if i >= len {
            break
        }
        if at_start {
            val k: mut i64 = 0
            for {
                if k >= n {
                    break
                }
                u.buf_ch(b, 32)
                k++
            }
            at_start = false
        }
        val c: u8 = @load8(@ptradd(s, i))
        u.buf_ch(b, c)
        if c == 10 {
            at_start = true
        }
        i++
    }
    return u.buf_take(b)
}

fn lines_of(s: ref u8) ref Value = trust {
    val vec: mut ref u.Vec = list_new()
    val len: i64 = u.s_len(s)
    if len == 0 {
        return v_list(vec)
    }
    val start: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i > len {
            break
        }
        if i == len || @load8(@ptradd(s, i)) == 10 {
            val end: mut i64 = i
            if end > start && @load8(@ptradd(s, end - 1)) == 13 {
                end--
            }
            if i == len && start == len {
                break
            }
            u.vec_pushp(vec, v_str(u.s_substr(s, start, end)) as ref void)
            start = i + 1
        }
        i++
    }
    return v_list(vec)
}

fn split_words_value(s: ref u8) ref Value = trust {
    val vec: mut ref u.Vec = list_new()
    val len: i64 = u.s_len(s)
    val b: mut ref u.Buf = u.buf_new()
    val inword: mut i64 = 0
    val quote: mut u8 = 0
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if quote != 0 {
            if c == quote {
                quote = 0
            } else {
                u.buf_ch(b, c)
            }
        } elif c == 39 || c == 34 {
            quote = c
            inword = 1
        } elif c == 32 || c == 9 || c == 10 || c == 13 {
            if inword != 0 {
                u.vec_pushp(vec, v_str(u.buf_take(b)) as ref void)
                b = u.buf_new()
                inword = 0
            }
        } else {
            u.buf_ch(b, c)
            inword = 1
        }
        i++
    }
    if inword != 0 {
        u.vec_pushp(vec, v_str(u.buf_take(b)) as ref void)
    }
    return v_list(vec)
}

fn regex_match(s: ref u8, pattern: ref u8) bool = trust {
    val ml: mut i64 = 0
    match re.re_match(pattern, s, @addr(ml)) {
        ok found => {
            match found {
                some _ => {
                    return true
                }
                none => {
                    return false
                }
            }
        }
        err _ => {
            return false
        }
    }
    return false
}

fn call_native(id: i64, args: ref u.Vec, n: ref lang.Node) ref Value = trust {
    if id == 1 {
        val v: ref Value = arg(args, 0)
        if v != none && v.tag == 5 {
            return v_int((v.p as ref u.Vec).len)
        }
        if v != none && v.tag == 6 {
            return v_int((v.p as ref u.Map).len)
        }
        if v != none && v.tag == 4 {
            return v_int(u.s_len(v.p as ref u8))
        }
        return v_int(u.s_len(v_to_str(v)))
    }
    if id == 2 {
        return v_str(v_to_str(arg(args, 0)))
    }
    if id == 3 {
        return v_int(num_i(arg(args, 0)))
    }
    if id == 4 {
        return v_float(num_f(arg(args, 0)))
    }
    if id == 5 {
        return v_bool(truthy(arg(args, 0)))
    }
    if id == 6 {
        val a: i64 = num_i(arg(args, 0))
        val b: mut i64 = 0
        if args.len > 1 {
            b = num_i(arg(args, 1))
        } else {
            b = a
        }
        val start: mut i64 = 0
        if args.len > 1 {
            start = a
        }
        val vec: mut ref u.Vec = list_new()
        val i: mut i64 = start
        for {
            if i >= b {
                break
            }
            u.vec_pushp(vec, v_int(i) as ref void)
            i++
        }
        return v_list(vec)
    }
    if id == 7 {
        val b: mut ref u.Buf = u.buf_new()
        val i: mut i64 = 0
        for {
            if i >= args.len {
                break
            }
            if i > 0 {
                u.buf_ch(b, 32)
            }
            u.buf_add(b, v_to_str(arg(args, i)))
            i++
        }
        u.buf_ch(b, 10)
        u.stdout_s(u.buf_take(b))
        return v_nil()
    }
    if id == 8 {
        if args.len > 0 {
            u.stdout_s(v_to_str(arg(args, 0)))
        }
        val line: ref u8 = term.read_plain()
        if line == none {
            return v_nil()
        }
        return v_str(line)
    }
    if id == 9 {
        val ms: i64 = num_i(arg(args, 0))
        if ms > 0 {
            rt.usleep((ms * 1000) as u32)
        }
        return v_nil()
    }
    if id == 10 {
        val code: i64 = num_i(arg(args, 0))
        u.script_exit_code = code
        g_flow = 5
        return v_nil()
    }
    if id == 11 || id == 12 {
        if u.hooks_ready == 0 {
            return v_result(127, c"", c"")
        }
        val res: ref Value = spawn_result(
            u.vec_new(),
            v_to_str(arg(args, 0)),
            true,
            false,
            none
        )
        set_status(result_status(res))
        return res
    }
    if id == 13 {
        val f: f64 = num_f(arg(args, 0))
        if f < 0.0 {
            return v_float(0.0 - f)
        }
        return v_float(f)
    }
    if id == 14 || id == 15 {
        if args.len == 0 {
            return v_nil()
        }
        val first: ref Value = arg(args, 0)
        if first != none && first.tag == 5 {
            val vec: ref u.Vec = first.p as ref u.Vec
            if vec.len == 0 {
                return v_nil()
            }
            val best: mut ref Value = u.vec_p(vec, 0) as ref Value
            val i: mut i64 = 1
            for {
                if i >= vec.len {
                    break
                }
                val cur: ref Value = u.vec_p(vec, i) as ref Value
                val cmp: f64 = num_f(cur)
                val bc: f64 = num_f(best)
                if (id == 14 && cmp < bc) || (id == 15 && cmp > bc) {
                    best = cur
                }
                i++
            }
            return best
        }
        val a: f64 = num_f(arg(args, 0))
        val b: f64 = num_f(arg(args, 1))
        if id == 14 {
            if a < b {
                return v_float(a)
            }
            return v_float(b)
        }
        if a > b {
            return v_float(a)
        }
        return v_float(b)
    }
    if id == 16 {
        val v: ref Value = arg(args, 0)
        val total: mut f64 = 0.0
