/// Language Server Protocol implementation for Blood scripts.
///
/// The server speaks JSON-RPC over stdin/stdout using the standard LSP
/// Content-Length framing. It keeps an in-memory copy of every open document
/// and provides diagnostics, completion, hover, navigation, symbols, rename,
/// signature help, folding ranges and formatting.

val u      = use("../core/util.sx")
val ex     = use("../core/exec.sx")
val lang   = use("lang.sx")
val format = use("format.sx")
val js     = use("std/json")
val str    = use("std/string")

type Symbol = {
    name: mut ref u8
    kind: mut i64
    line: mut i64
    col: mut i64
    params: mut ref u.Vec
}

type Candidate = {
    label: mut ref u8
    kind: mut i64
    detail: mut ref u8
}

type Span = {
    start: mut i64
    end: mut i64
}

type Pos = {
    line: mut i64
    ch: mut i64
}

val docs: mut ref u.Map = none
val exit_flag: mut i64 = 0
val exit_code: mut i64 = 0
val did_shutdown: mut i64 = 0

fn key(name: ref u8) str.StringView = trust {
    return str.from_cstr(name)
}

fn jstr(v: js.JsonValue, name: ref u8) ref u8 = trust {
    match js.object_get_str(v, key(name)) {
        some value => {
            return u.s_ndup(str.ptr(value), str.len(value))
        }
        none => {
            return none
        }
    }
}

fn jint(v: js.JsonValue, name: ref u8) i64 = trust {
    match js.object_get_int(v, key(name)) {
        some value => {
            return value
        }
        none => {
            return 0
        }
    }
}

fn doc_text(uri: ref u8) ref u8 = trust {
    if uri == none {
        return none
    }
    val raw: i64 = u.map_get(docs, uri)
    if raw == 0 {
        return none
    }
    return @bitcast(raw, ref u8)
}

fn doc_put(uri: ref u8, text: ref u8) void = trust {
    if uri == none || text == none {
        return
    }
    val old: i64 = u.map_get(docs, uri)
    if old != 0 {
        u.s_free(@bitcast(old, ref u8) as ref void)
    }
    u.map_put(docs, uri, @bitcast(u.s_dup_perm(text), i64))
}

fn doc_drop(uri: ref u8) void = trust {
    if uri == none {
        return
    }
    val old: i64 = u.map_get(docs, uri)
    if old != 0 {
        u.s_free(@bitcast(old, ref u8) as ref void)
    }
    u.map_del(docs, uri)
}

fn json_quote(b: mut ref u.Buf, s: ref u8) void = trust {
    u.buf_ch(b, 34)
    val n: i64 = u.s_len(s)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == 34 {
            u.buf_add(b, c"\\\"")
        } elif c == 92 {
            u.buf_add(b, c"\\\\")
        } elif c == 10 {
            u.buf_add(b, c"\\n")
        } elif c == 13 {
            u.buf_add(b, c"\\r")
        } elif c == 9 {
            u.buf_add(b, c"\\t")
        } elif c == 8 {
            u.buf_add(b, c"\\b")
        } elif c == 12 {
            u.buf_add(b, c"\\f")
        } elif c < 32 {
            u.buf_add(b, c"\\u00")
            val hi: u8 = c / 16
            val lo: u8 = c % 16
            if hi < 10 {
                u.buf_ch(b, 48 + hi)
            } else {
                u.buf_ch(b, 87 + hi)
            }
            if lo < 10 {
                u.buf_ch(b, 48 + lo)
            } else {
                u.buf_ch(b, 87 + lo)
            }
        } else {
            u.buf_ch(b, c)
        }
        i++
    }
    u.buf_ch(b, 34)
}

fn id_raw(root: js.JsonValue) ref u8 = trust {
    match js.object_get(root, key(c"id")) {
        some value => {
            if js.is_int(value) {
                return u.s_int(js.as_int(value))
            }
            if js.is_uint(value) {
                return u.s_uint(js.as_uint(value) as i64)
            }
            if js.is_string(value) {
                val view: str.StringView = js.as_string(value)
                val text: ref u8 = u.s_ndup(str.ptr(view), str.len(view))
                val b: mut ref u.Buf = u.buf_new()
                json_quote(b, text)
                return u.buf_take(b)
            }
            return u.s_dup(c"null")
        }
        none => {
            return none
        }
    }
}

fn send_payload(payload: ref u8) void = trust {
    val b: mut ref u.Buf = u.buf_new()
    u.buf_add(b, c"Content-Length: ")
    u.buf_int(b, u.s_len(payload))
    u.buf_add(b, c"\r\n\r\n")
    u.buf_add(b, payload)
    u.write_fd(1, u.buf_take(b))
}

fn send_result(id: ref u8, result: ref u8) void = trust {
    if id == none {
        return
    }
    val b: mut ref u.Buf = u.buf_new()
    u.buf_add(b, c"{\"jsonrpc\":\"2.0\",\"id\":")
    u.buf_add(b, id)
    u.buf_add(b, c",\"result\":")
    u.buf_add(b, result)
    u.buf_ch(b, 125)
    send_payload(u.buf_take(b))
}

fn send_error(id: ref u8, code: i64, message: ref u8) void = trust {
    val b: mut ref u.Buf = u.buf_new()
    u.buf_add(b, c"{\"jsonrpc\":\"2.0\",\"id\":")
    if id == none {
        u.buf_add(b, c"null")
    } else {
        u.buf_add(b, id)
    }
    u.buf_add(b, c",\"error\":{\"code\":")
    u.buf_int(b, code)
    u.buf_add(b, c",\"message\":")
    json_quote(b, message)
    u.buf_add(b, c"}}")
    send_payload(u.buf_take(b))
}

fn send_notification(method: ref u8, params: ref u8) void = trust {
    val b: mut ref u.Buf = u.buf_new()
    u.buf_add(b, c"{\"jsonrpc\":\"2.0\",\"method\":")
    json_quote(b, method)
    u.buf_add(b, c",\"params\":")
    u.buf_add(b, params)
    u.buf_ch(b, 125)
    send_payload(u.buf_take(b))
}

fn read_byte() i32 = trust {
    val c: mut u8 = 0
    val n: i64 = ex.fd_read(0, @addr(c) as ref u8, 1)
    if n <= 0 {
        return -1
    }
    return c as i32
}

fn read_header_line() ref u8 = trust {
    val b: mut ref u.Buf = u.buf_new()
    for {
        val c: i32 = read_byte()
        if c < 0 {
            if b.len == 0 {
                return none
            }
            break
        }
        if c == 10 {
            break
        }
        if c == 13 {
            continue
        }
        u.buf_ch(b, c as u8)
    }
    return u.buf_take(b)
}

fn read_message_length() i64 = trust {
    val length: mut i64 = -1
    for {
        val line: ref u8 = read_header_line()
        if line == none {
            return -1
        }
        if u.s_len(line) == 0 {
            break
        }
        if u.s_starts(line, c"Content-Length:") || u.s_starts(line, c"content-length:") {
            val colon: i64 = u.s_index_of_char(line, 58, 0)
            if colon >= 0 {
                if u.parse_int(u.s_trim(u.s_substr(line, colon + 1, u.s_len(line)))) is some value {
                    length = value
                }
            }
        }
    }
    return length
}

fn read_exact(n: i64) ref u8 = trust {
    if n <= 0 {
        return u.s_dup(c"")
    }
    val out: ref u8 = u.s_alloc(n)
    val got: mut i64 = 0
    for {
        if got >= n {
            break
        }
        val r: i64 = ex.fd_read(0, @ptradd(out, got), n - got)
        if r <= 0 {
            break
        }
        got = got + r
    }
    @store8(@ptradd(out, got), 0)
    return out
}

fn line_start_offset(text: ref u8, line: i64) i64 = trust {
    if line <= 0 {
        return 0
    }
    val n: i64 = u.s_len(text)
    val current: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        if @load8(@ptradd(text, i)) == 10 {
            current++
            if current == line {
                return i + 1
            }
        }
        i++
    }
    return n
}

fn position_offset(text: ref u8, line: i64, ch: i64) i64 = trust {
    val n: i64 = u.s_len(text)
    val start: i64 = line_start_offset(text, line)
    val i: mut i64 = start
    val count: mut i64 = 0
    for {
        if i >= n || count >= ch {
            break
        }
        if @load8(@ptradd(text, i)) == 10 {
            break
        }
        i = u.utf8_next(text, i, n)
        count++
    }
    return i
}

fn pos_at(text: ref u8, offset: i64) Pos = trust {
    val n: i64 = u.s_len(text)
    val limit: mut i64 = offset
    if limit > n {
        limit = n
    }
    val line: mut i64 = 0
    val ch: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= limit {
            break
        }
        val c: u8 = @load8(@ptradd(text, i))
        if c == 10 {
            line++
            ch = 0
            i++
            continue
        }
        val next: i64 = u.utf8_next(text, i, n)
        ch++
        i = next
    }
    return Pos{line: line, ch: ch}
}

fn is_ident_byte(c: u8) bool = trust {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95
}

fn word_span_at(text: ref u8, offset: i64) Span = trust {
    val n: i64 = u.s_len(text)
    val at: mut i64 = offset
    if at > n {
        at = n
    }
    if at < 0 {
        at = 0
    }
    val start: mut i64 = at
    for {
        if start <= 0 {
            break
        }
        val prev: i64 = u.utf8_prev(text, start)
        if !is_ident_byte(@load8(@ptradd(text, prev))) {
            break
        }
        start = prev
    }
    val end: mut i64 = at
    for {
        if end >= n {
            break
        }
        if !is_ident_byte(@load8(@ptradd(text, end))) {
            break
        }
        end = u.utf8_next(text, end, n)
    }
    return Span{start: start, end: end}
}

fn add_range(b: mut ref u.Buf, sl: i64, sc: i64, el: i64, ec: i64) void = trust {
    u.buf_add(b, c"{\"start\":{\"line\":")
    u.buf_int(b, sl)
    u.buf_add(b, c",\"character\":")
    u.buf_int(b, sc)
    u.buf_add(b, c"},\"end\":{\"line\":")
    u.buf_int(b, el)
    u.buf_add(b, c",\"character\":")
    u.buf_int(b, ec)
    u.buf_add(b, c"}}")
}

fn add_range_offsets(b: mut ref u.Buf, text: ref u8, start: i64, end: i64) void = trust {
    val sp: Pos = pos_at(text, start)
    val ep: Pos = pos_at(text, end)
    add_range(b, sp.line, sp.ch, ep.line, ep.ch)
}

fn params_obj(params: option[js.JsonValue], name: ref u8) option[js.JsonValue] = trust {
    match params {
        some value => {
            return js.object_get(value, key(name))
        }
        none => {
            return none
        }
    }
}

fn params_str(params: option[js.JsonValue], name: ref u8) ref u8 = trust {
    if params_obj(params, name) is some value {
        if js.is_string(value) {
            val view: str.StringView = js.as_string(value)
            return u.s_ndup(str.ptr(view), str.len(view))
        }
    }
    return none
}

fn params_nested_str(params: option[js.JsonValue], outer: ref u8, inner: ref u8) ref u8 = trust {
    if params_obj(params, outer) is some value {
        return jstr(value, inner)
    }
    return none
}

fn params_nested_int(params: option[js.JsonValue], outer: ref u8, inner: ref u8) i64 = trust {
    if params_obj(params, outer) is some value {
        return jint(value, inner)
    }
    return 0
}

fn doc_uri(params: option[js.JsonValue]) ref u8 = trust {
    return params_nested_str(params, c"textDocument", c"uri")
}

fn doc_from_params(params: option[js.JsonValue]) ref u8 = trust {
    val uri: ref u8 = doc_uri(params)
    return doc_text(uri)
}

fn add_symbol(
    out: mut ref u.Vec,
    name: ref u8,
    kind: i64,
    line: i64,
    col: i64,
    params: ref u.Vec
) void = trust {
    if name == none || u.s_len(name) == 0 {
        return
    }
    val s: mut ref Symbol = u.xalloc(@sizeof(Symbol) as i64) as ref Symbol
    s.name = name
    s.kind = kind
    s.line = line
    s.col = col
    s.params = params
    u.vec_pushp(out, s as ref void)
}

fn collect_symbols(n: ref lang.Node, out: mut ref u.Vec) void = trust {
    if n == none {
        return
    }
    if n.kind == lang.NodeKind.FnDef {
        add_symbol(out, n.s, 12, n.line, n.col, n.params)
    } elif n.kind == lang.NodeKind.VarDecl {
        add_symbol(out, n.s, 13, n.line, n.col, none)
    } elif n.kind == lang.NodeKind.For || n.kind == lang.NodeKind.ParaFor {
        add_symbol(out, n.s, 13, n.line, n.col, none)
    }
    val i: mut i64 = 0
    for {
        if i >= n.kids.len {
            break
        }
        collect_symbols(u.vec_p(n.kids, i) as ref lang.Node, out)
        i++
    }
    val j: mut i64 = 0
    for {
        if j >= n.defaults.len {
            break
        }
        collect_symbols(u.vec_p(n.defaults, j) as ref lang.Node, out)
        j++
    }
}

fn document_symbols(text: ref u8) ref u.Vec = trust {
    val out: mut ref u.Vec = u.vec_new()
    val program: ref lang.Node = lang.parse(text)
    collect_symbols(program, out)
    return out
}

fn find_symbol(symbols: ref u.Vec, name: ref u8) ref Symbol = trust {
    val i: mut i64 = 0
    for {
        if i >= symbols.len {
            break
        }
        val s: ref Symbol = u.vec_p(symbols, i) as ref Symbol
        if u.s_eq(s.name, name) {
            return s
        }
        i++
    }
    return none
}

fn kind_name(kind: i64) ref u8 = trust {
    if kind == 12 {
        return u.s_dup(c"function")
    }
    return u.s_dup(c"variable")
}

fn add_candidate(out: mut ref u.Vec, label: ref u8, kind: i64, detail: ref u8) void = trust {
    val c: mut ref Candidate = u.xalloc(@sizeof(Candidate) as i64) as ref Candidate
    c.label = label
    c.kind = kind
    c.detail = detail
    u.vec_pushp(out, c as ref void)
}

fn add_keywords(out: mut ref u.Vec) void = trust {
    add_candidate(out, c"if", 14, c"keyword")
    add_candidate(out, c"elif", 14, c"keyword")
    add_candidate(out, c"else", 14, c"keyword")
    add_candidate(out, c"while", 14, c"keyword")
    add_candidate(out, c"for", 14, c"keyword")
    add_candidate(out, c"para", 14, c"keyword")
    add_candidate(out, c"fn", 14, c"keyword")
    add_candidate(out, c"def", 14, c"keyword")
    add_candidate(out, c"export", 14, c"keyword")
    add_candidate(out, c"defer", 14, c"keyword")
    add_candidate(out, c"var", 14, c"keyword")
    add_candidate(out, c"const", 14, c"keyword")
    add_candidate(out, c"pub", 14, c"keyword")
    add_candidate(out, c"use", 14, c"keyword")
    add_candidate(out, c"return", 14, c"keyword")
    add_candidate(out, c"break", 14, c"keyword")
    add_candidate(out, c"continue", 14, c"keyword")
    add_candidate(out, c"pass", 14, c"keyword")
    add_candidate(out, c"try", 14, c"keyword")
    add_candidate(out, c"catch", 14, c"keyword")
    add_candidate(out, c"except", 14, c"keyword")
    add_candidate(out, c"raise", 14, c"keyword")
    add_candidate(out, c"throw", 14, c"keyword")
    add_candidate(out, c"in", 14, c"keyword")
    add_candidate(out, c"not", 14, c"keyword")
    add_candidate(out, c"and", 14, c"keyword")
    add_candidate(out, c"or", 14, c"keyword")
    add_candidate(out, c"true", 14, c"keyword")
    add_candidate(out, c"false", 14, c"keyword")
    add_candidate(out, c"null", 14, c"keyword")
}

fn add_builtins(out: mut ref u.Vec) void = trust {
    add_candidate(out, c"say", 3, c"builtin")
    add_candidate(out, c"print", 3, c"builtin")
    add_candidate(out, c"eprint", 3, c"builtin")
    add_candidate(out, c"input", 3, c"builtin")
