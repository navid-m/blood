/// Documentation generation for Blood source files.

val u    = use("../core/util.sx")
val lang = use("lang.sx")

val doc_css     = @embed("../assets/doc.css")
val doc_css_len = @embedlen("../assets/doc.css")
val doc_js      = @embed("../assets/doc.js")
val doc_js_len  = @embedlen("../assets/doc.js")

type DocField = {
    name: mut ref u8
    typ: mut ref u8
    default_text: mut ref u8
    docs: mut ref u8
}

type DocItem = {
    kind: mut i64
    name: mut ref u8
    signature: mut ref u8
    docs: mut ref u8
    fields: mut ref u.Vec
    methods: mut ref u.Vec
    public: mut bool
}

fn split_lines(src: ref u8) ref u.Vec = trust {
    val out: mut ref u.Vec = u.vec_new()
    val n: i64 = u.s_len(src)
    val start: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i > n {
            break
        }
        if i == n || @load8(@ptradd(src, i)) == 10 {
            if start < i {
                u.vec_pushp(out, u.s_substr(src, start, i) as ref void)
            } else {
                u.vec_pushp(out, c"" as ref void)
            }
            start = i + 1
        }
        i++
    }
    return out
}

fn doc_text_of_line(line: ref u8) ref u8 = trust {
    val t: ref u8 = u.s_trim(line)
    if !u.s_starts(t, c"##") {
        return none
    }
    return u.s_trim(u.s_substr(t, 2, u.s_len(t)))
}

fn docs_for_line(lines: ref u.Vec, line: i64) ref u8 = trust {
    val parts: mut ref u.Vec = u.vec_new()
    val i: mut i64 = line - 2
    for {
        if i < 0 || i >= lines.len {
            break
        }
        val text: ref u8 = doc_text_of_line(u.vec_p(lines, i) as ref u8)
        if text == none {
            break
        }
        u.vec_pushp(parts, text as ref void)
        i--
    }
    val b: mut ref u.Buf = u.buf_new()
    val j: mut i64 = parts.len - 1
    for {
        if j < 0 {
            break
        }
        if u.s_len(u.buf_view(b)) > 0 {
            u.buf_ch(b, 10)
        }
        u.buf_add(b, u.vec_p(parts, j) as ref u8)
        j--
    }
    return u.buf_take(b)
}

fn item_new(kind: i64, name: ref u8, signature: ref u8, docs: ref u8) ref DocItem = trust {
    val d: mut ref DocItem = u.xalloc(@sizeof(DocItem) as i64) as ref DocItem
    d.kind = kind
    d.name = name
    d.signature = signature
    d.docs = docs
    d.fields = u.vec_new()
    d.methods = u.vec_new()
    d.public = true
    return d
}

fn field_default(sig: ref u8) ref u8 = trust {
    val at: i64 = u.s_find(sig, c"=")
    if at < 0 {
        return c""
    }
    return u.s_trim(u.s_substr(sig, at + 1, u.s_len(sig)))
}

fn collect_type(n: ref lang.Node, lines: ref u.Vec) ref DocItem = trust {
    val sig: mut ref u8 = n.sig_text
    if sig == none {
        sig = u.s_cat(c"type ", n.s)
    }
    val item: mut ref DocItem = item_new(0, n.s, sig, docs_for_line(lines, n.line))
    item.public = (n.flags & 1) != 0
    val i: mut i64 = 0
    for {
        if i >= n.kids.len {
            break
        }
        val f: ref lang.Node = u.vec_p(n.kids, i) as ref lang.Node
        if f.kind == lang.NodeKind.FieldDecl {
            val fsig: mut ref u8 = f.sig_text
            if fsig == none {
                fsig = f.s
            }
            val field: mut ref DocField = u.xalloc(@sizeof(DocField) as i64) as ref DocField
            field.name = f.s
            field.typ = f.type_text
            field.default_text = field_default(fsig)
            field.docs = docs_for_line(lines, f.line)
            u.vec_pushp(item.fields, field as ref void)
        }
        i++
    }
    return item
}

fn fn_item(n: ref lang.Node, lines: ref u.Vec) ref DocItem = trust {
    val sig: mut ref u8 = n.sig_text
    if sig == none {
        sig = n.s
    }
    val item: mut ref DocItem = item_new(1, n.s, sig, docs_for_line(lines, n.line))
    item.public = (n.flags & 1) != 0
    return item
}

fn binding_item(n: ref lang.Node, lines: ref u.Vec, kind: i64) ref DocItem = trust {
    val raw: mut ref u8 = n.sig_text
    if raw == none {
        raw = n.s
    }
    val sig: mut ref u8 = u.s_cat(c"const ", raw)
    if kind == 2 {
        sig = u.s_cat(c"var ", raw)
    }
    val item: mut ref DocItem = item_new(kind, n.s, sig, docs_for_line(lines, n.line))
    item.public = (n.flags & 1) != 0
    return item
}

fn find_type_item(items: ref u.Vec, name: ref u8) ref DocItem = trust {
    val i: mut i64 = 0
    for {
        if i >= items.len {
            break
        }
        val item: ref DocItem = u.vec_p(items, i) as ref DocItem
        if item.kind == 0 && u.s_eq(item.name, name) {
            return item
        }
        i++
    }
    return none
}

fn collect_docs(program: ref lang.Node, lines: ref u.Vec) ref u.Vec = trust {
    val items: mut ref u.Vec = u.vec_new()
    val i: mut i64 = 0
    for {
        if i >= program.kids.len {
            break
        }
        val n: ref lang.Node = u.vec_p(program.kids, i) as ref lang.Node
        if n.kind == lang.NodeKind.TypeDecl {
            u.vec_pushp(items, collect_type(n, lines) as ref void)
        }
        i++
    }
    i = 0
    for {
        if i >= program.kids.len {
            break
        }
        val n: ref lang.Node = u.vec_p(program.kids, i) as ref lang.Node
        if n.kind == lang.NodeKind.FnDef {
            val item: ref DocItem = fn_item(n, lines)
            if n.owner != none {
                val owner: mut ref DocItem = find_type_item(items, n.owner)
                if owner != none {
                    u.vec_pushp(owner.methods, item as ref void)
                } else {
                    u.vec_pushp(items, item as ref void)
                }
            } else {
                u.vec_pushp(items, item as ref void)
            }
        } elif n.kind == lang.NodeKind.VarDecl {
            u.vec_pushp(items, binding_item(n, lines, 2) as ref void)
        } elif n.kind == lang.NodeKind.ConstDecl {
            u.vec_pushp(items, binding_item(n, lines, 3) as ref void)
        }
        i++
    }
    return items
}

fn md_docs(b: mut ref u.Buf, docs: ref u8) void = trust {
    if u.s_len(docs) > 0 {
        u.buf_add(b, docs)
        u.buf_add(b, c"\n\n")
    }
}

fn md_cell(b: mut ref u.Buf, s: ref u8) void = trust {
    val n: i64 = u.s_len(s)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == 10 {
            u.buf_add(b, c"<br>")
        } elif c == 124 {
            u.buf_add(b, c"\\|")
        } else {
            u.buf_ch(b, c)
        }
        i++
    }
}

fn md_fields(b: mut ref u.Buf, item: ref DocItem) void = trust {
    if item.fields.len == 0 {
        return
    }
    u.buf_add(b, c"| Field | Type | Default | Description |\n| --- | --- | --- | --- |\n")
    val i: mut i64 = 0
    for {
        if i >= item.fields.len {
            break
        }
        val f: ref DocField = u.vec_p(item.fields, i) as ref DocField
        u.buf_add(b, c"| `")
        u.buf_add(b, f.name)
        u.buf_add(b, c"` | `")
        if f.typ != none {
            u.buf_add(b, f.typ)
        }
        u.buf_add(b, c"` | ")
        if u.s_len(f.default_text) > 0 {
            u.buf_add(b, c"`")
            u.buf_add(b, f.default_text)
            u.buf_add(b, c"`")
        }
        u.buf_add(b, c" | ")
        md_cell(b, f.docs)
        u.buf_add(b, c" |\n")
        i++
    }
    u.buf_ch(b, 10)
}

fn render_md(items: ref u.Vec, title: ref u8) ref u8 = trust {
    val b: mut ref u.Buf = u.buf_new()
    u.buf_add(b, c"# ")
    u.buf_add(b, title)
    u.buf_add(b, c"\n\n")
    val sections: mut ref u.Vec = u.vec_new()
    u.vec_pushp(sections, c"Types" as ref void)
    u.vec_pushp(sections, c"Functions" as ref void)
    u.vec_pushp(sections, c"Variables" as ref void)
    u.vec_pushp(sections, c"Constants" as ref void)
    val kinds: mut ref u.Vec = u.vec_new()
    u.vec_push(kinds, 0)
    u.vec_push(kinds, 1)
    u.vec_push(kinds, 2)
    u.vec_push(kinds, 3)
    val si: mut i64 = 0
    for {
        if si >= sections.len {
            break
        }
        val kind: i64 = u.vec_gets(kinds, si)
        val any: mut bool = false
        val i: mut i64 = 0
        for {
            if i >= items.len {
                break
            }
            val item: ref DocItem = u.vec_p(items, i) as ref DocItem
            if item.kind == kind {
                any = true
                break
            }
            i++
        }
        if any {
            u.buf_add(b, c"## ")
            u.buf_add(b, u.vec_p(sections, si) as ref u8)
            u.buf_add(b, c"\n\n")
        }
        i = 0
        for {
            if i >= items.len {
                break
            }
            val item: ref DocItem = u.vec_p(items, i) as ref DocItem
            if item.kind == kind {
                u.buf_add(b, c"### `")
                u.buf_add(b, item.signature)
                u.buf_add(b, c"`\n\n")
                md_docs(b, item.docs)
                if item.kind == 0 {
                    md_fields(b, item)
                }
                val mi: mut i64 = 0
                for {
                    if mi >= item.methods.len {
                        break
                    }
                    val method: ref DocItem = u.vec_p(item.methods, mi) as ref DocItem
                    u.buf_add(b, c"#### `")
                    u.buf_add(b, method.signature)
                    u.buf_add(b, c"`\n\n")
                    md_docs(b, method.docs)
                    mi++
                }
            }
            i++
        }
        si++
    }
    return u.buf_take(b)
}

fn html_char(b: mut ref u.Buf, c: u8) void = trust {
    if c == 38 {
        u.buf_add(b, c"&amp;")
    } elif c == 60 {
        u.buf_add(b, c"&lt;")
    } elif c == 62 {
        u.buf_add(b, c"&gt;")
    } elif c == 34 {
        u.buf_add(b, c"&quot;")
    } elif c == 39 {
        u.buf_add(b, c"&#39;")
    } else {
        u.buf_ch(b, c)
    }
}

fn html_escape(b: mut ref u.Buf, s: ref u8) void = trust {
    val n: i64 = u.s_len(s)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        html_char(b, @load8(@ptradd(s, i)))
        i++
    }
}

fn find_byte(s: ref u8, from: i64, ch: u8) i64 = trust {
    val n: i64 = u.s_len(s)
    val i: mut i64 = from
    for {
        if i >= n {
            break
        }
        if @load8(@ptradd(s, i)) == ch {
            return i
        }
        i++
    }
    return -1
}

fn find_pair(s: ref u8, from: i64, a: u8, b: u8) i64 = trust {
    val n: i64 = u.s_len(s)
    val i: mut i64 = from
    for {
        if i + 1 >= n {
            break
        }
        if @load8(@ptradd(s, i)) == a && @load8(@ptradd(s, i + 1)) == b {
            return i
        }
        i++
    }
    return -1
}

fn html_inline(b: mut ref u.Buf, s: ref u8) void = trust {
    val n: i64 = u.s_len(s)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == 92 && i + 1 < n {
            html_char(b, @load8(@ptradd(s, i + 1)))
            i += 2
            continue
        }
        if c == 96 {
            val close: i64 = find_byte(s, i + 1, 96)
            if close > i {
                u.buf_add(b, c"<code>")
                html_escape(b, u.s_substr(s, i + 1, close))
                u.buf_add(b, c"</code>")
                i = close + 1
                continue
            }
        }
        if c == 42 {
            if i + 1 < n && @load8(@ptradd(s, i + 1)) == 42 {
                val close: i64 = find_pair(s, i + 2, 42, 42)
                if close > i + 1 {
                    u.buf_add(b, c"<strong>")
                    html_inline(b, u.s_substr(s, i + 2, close))
                    u.buf_add(b, c"</strong>")
                    i = close + 2
                    continue
                }
            } else {
                val close: i64 = find_byte(s, i + 1, 42)
                if close > i {
                    u.buf_add(b, c"<em>")
                    html_inline(b, u.s_substr(s, i + 1, close))
                    u.buf_add(b, c"</em>")
                    i = close + 1
                    continue
                }
            }
        }
        if c == 95 && i + 1 < n && @load8(@ptradd(s, i + 1)) == 95 {
            val close: i64 = find_pair(s, i + 2, 95, 95)
            if close > i + 1 {
                u.buf_add(b, c"<strong>")
                html_inline(b, u.s_substr(s, i + 2, close))
                u.buf_add(b, c"</strong>")
                i = close + 2
                continue
            }
        }
        if c == 91 {
            val close: i64 = find_byte(s, i + 1, 93)
            if close > i && close + 1 < n && @load8(@ptradd(s, close + 1)) == 40 {
                val end: i64 = find_byte(s, close + 2, 41)
                if end > close {
                    u.buf_add(b, c"<a href='")
                    html_escape(b, u.s_substr(s, close + 2, end))
                    u.buf_add(b, c"'>")
                    html_inline(b, u.s_substr(s, i + 1, close))
                    u.buf_add(b, c"</a>")
                    i = end + 1
                    continue
                }
            }
        }
        html_char(b, c)
        i++
    }
}

fn html_docs(b: mut ref u.Buf, docs: ref u8) void = trust {
    if u.s_len(docs) == 0 {
        return
    }
    u.buf_add(b, c"<div class='doc'>")
    val n: i64 = u.s_len(docs)
    val pos: mut i64 = 0
    val in_para: mut bool = false
    val lines: mut i64 = 0
    for {
        if pos > n {
            break
        }
        val nl: i64 = u.s_index_of_char(docs, 10, pos)
        val end: mut i64 = n
        if nl >= 0 {
            end = nl
        }
        val line: ref u8 = u.s_trim(u.s_substr(docs, pos, end))
        if u.s_len(line) == 0 {
            if in_para {
                u.buf_add(b, c"</p>\n")
                in_para = false
            }
        } else {
            if !in_para {
                u.buf_add(b, c"<p>")
                in_para = true
                lines = 0
            } elif lines > 0 {
                u.buf_add(b, c"<br>")
            }
            html_inline(b, line)
            lines++
        }
        if nl < 0 {
            break
        }
        pos = nl + 1
    }
    if in_para {
        u.buf_add(b, c"</p>\n")
    }
    u.buf_add(b, c"</div>\n")
}

fn html_cell(b: mut ref u.Buf, s: ref u8) void = trust {
    val n: i64 = u.s_len(s)
    val pos: mut i64 = 0
    val first: mut bool = true
    for {
        if pos > n {
            break
        }
        val nl: i64 = u.s_index_of_char(s, 10, pos)
        val end: mut i64 = n
        if nl >= 0 {
            end = nl
        }
        val line: ref u8 = u.s_trim(u.s_substr(s, pos, end))
        if !first && u.s_len(line) > 0 {
            u.buf_add(b, c"<br>")
        }
        html_inline(b, line)
        first = false
        if nl < 0 {
            break
        }
        pos = nl + 1
    }
}

fn is_ident_start(c: u8) bool = trust {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn is_ident_char(c: u8) bool = trust {
    return is_ident_start(c) || (c >= 48 && c <= 57)
}

fn is_digit(c: u8) bool = trust {
    return c >= 48 && c <= 57
}

fn is_hl_keyword(s: ref u8) bool = trust {
    return u.s_eq(s, c"fn") || u.s_eq(s, c"val") || u.s_eq(s, c"mut") || u.s_eq(
        s,
        c"pub"
    ) || u.s_eq(s, c"type") || u.s_eq(s, c"var") || u.s_eq(s, c"const") || u.s_eq(
        s,
        c"return"
    ) || u.s_eq(s, c"if") || u.s_eq(s, c"else") || u.s_eq(s, c"elif") || u.s_eq(
        s,
        c"trust"
    ) || u.s_eq(s, c"use") || u.s_eq(s, c"ref") || u.s_eq(s, c"for") || u.s_eq(
        s,
        c"in"
    ) || u.s_eq(s, c"some") || u.s_eq(s, c"none") || u.s_eq(s, c"ok") || u.s_eq(
        s,
        c"err"
    ) || u.s_eq(s, c"match") || u.s_eq(s, c"true") || u.s_eq(s, c"false") || u.s_eq(
        s,
        c"defer"
    ) || u.s_eq(s, c"break") || u.s_eq(s, c"continue") || u.s_eq(s, c"as") || u.s_eq(
        s,
        c"assert"
    ) || u.s_eq(s, c"when") || u.s_eq(s, c"union") || u.s_eq(s, c"enum") || u.s_eq(
        s,
        c"extern"
    ) || u.s_eq(s, c"link") || u.s_eq(s, c"lib") || u.s_eq(s, c"guarded") || u.s_eq(
        s,
        c"not"
    ) || u.s_eq(s, c"test") || u.s_eq(s, c"guard") || u.s_eq(s, c"invariant") || u.s_eq(
        s,
        c"spec"
    ) || u.s_eq(s, c"pre") || u.s_eq(s, c"post") || u.s_eq(s, c"inline") || u.s_eq(
        s,
        c"try"
    ) || u.s_eq(s, c"raise") || u.s_eq(s, c"say") || u.s_eq(s, c"self")
}

fn is_hl_type(s: ref u8) bool = trust {
    return u.s_eq(s, c"u8") || u.s_eq(s, c"u16") || u.s_eq(s, c"u32") || u.s_eq(
        s,
        c"u64"
    ) || u.s_eq(s, c"i8") || u.s_eq(s, c"i16") || u.s_eq(s, c"i32") || u.s_eq(
        s,
        c"i64"
    ) || u.s_eq(s, c"int") || u.s_eq(s, c"uint") || u.s_eq(s, c"float") || u.s_eq(
        s,
        c"f32"
    ) || u.s_eq(s, c"f64") || u.s_eq(s, c"bool") || u.s_eq(s, c"string") || u.s_eq(
        s,
        c"void"
    ) || u.s_eq(s, c"any")
}

fn hl_string_end(s: ref u8, start: i64, n: i64) i64 = trust {
    val quote: u8 = @load8(@ptradd(s, start))
    val triple: bool = start + 2 < n && @load8(@ptradd(s, start + 1)) == quote && @load8(
        @ptradd(s, start + 2)
    ) == quote
    val i: mut i64 = start + 1
    if triple {
        i = start + 3
    }
    for {
        if i >= n {
            return n
        }
        val c: u8 = @load8(@ptradd(s, i))
        if triple {
            if c == quote && i + 2 < n && @load8(@ptradd(s, i + 1)) == quote && @load8(
                @ptradd(s, i + 2)
            ) == quote {
                return i + 3
            }
        } else {
            if c == quote {
                return i + 1
            }
        }
        if c == 92 {
            i += 2
        } else {
            i++
        }
    }
    return n
}

fn hl_code_inner(b: mut ref u.Buf, s: ref u8) void = trust {
    val n: i64 = u.s_len(s)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == 32 || c == 9 || c == 10 || c == 13 {
            u.buf_ch(b, c)
            i++
            continue
        }
        if c == 35 {
            val close: i64 = u.s_index_of_char(s, 10, i)
            val end: mut i64 = n
            if close >= 0 {
                end = close
            }
            u.buf_add(b, c"<span class='com'>")
            html_escape(b, u.s_substr(s, i, end))
            u.buf_add(b, c"</span>")
            i = end
            continue
        }
        if (c == 114 || c == 99) && i + 1 < n && (@load8(
            @ptradd(s, i + 1)
        ) == 34 || @load8(@ptradd(s, i + 1)) == 39) {
            val end: i64 = hl_string_end(s, i + 1, n)
            u.buf_add(b, c"<span class='str'>")
            html_escape(b, u.s_substr(s, i, end))
            u.buf_add(b, c"</span>")
            i = end
            continue
        }
        if c == 34 || c == 39 {
            val end: i64 = hl_string_end(s, i, n)
            u.buf_add(b, c"<span class='str'>")
            html_escape(b, u.s_substr(s, i, end))
            u.buf_add(b, c"</span>")
            i = end
            continue
        }
        if is_digit(c) {
            val start: i64 = i
            i++
            for {
                if i >= n {
                    break
                }
                val d: u8 = @load8(@ptradd(s, i))
                if is_ident_char(d) || d == 46 {
                    i++
                } else {
                    break
                }
            }
            u.buf_add(b, c"<span class='num'>")
            html_escape(b, u.s_substr(s, start, i))
            u.buf_add(b, c"</span>")
            continue
        }
        if is_ident_start(c) {
            val start: i64 = i
            i++
            for {
                if i >= n {
                    break
                }
                if is_ident_char(@load8(@ptradd(s, i))) {
                    i++
                } else {
                    break
                }
            }
            val word: ref u8 = u.s_substr(s, start, i)
            if is_hl_keyword(word) {
                u.buf_add(b, c"<span class='kw'>")
                html_escape(b, word)
                u.buf_add(b, c"</span>")
            } elif is_hl_type(word) || (c >= 65 && c <= 90) {
                u.buf_add(b, c"<span class='type'>")
                html_escape(b, word)
                u.buf_add(b, c"</span>")
            } else {
                html_escape(b, word)
            }
            continue
        }
        if c == 64 {
            val start: i64 = i
            i++
            if i < n && is_ident_start(@load8(@ptradd(s, i))) {
                i++
                for {
                    if i >= n {
                        break
                    }
                    if is_ident_char(@load8(@ptradd(s, i))) {
                        i++
                    } else {
                        break
                    }
                }
            }
            u.buf_add(b, c"<span class='builtin'>")
            html_escape(b, u.s_substr(s, start, i))
            u.buf_add(b, c"</span>")
            continue
        }
        html_char(b, c)
        i++
    }
}

fn hl_code(b: mut ref u.Buf, s: ref u8) void = trust {
    u.buf_add(b, c"<code class='signature'>")
    hl_code_inner(b, s)
    u.buf_add(b, c"</code>")
}

fn html_fields(b: mut ref u.Buf, item: ref DocItem) void = trust {
    if item.fields.len == 0 {
        return
    }
    u.buf_add(b, c"<details class='panel' open><summary>Fields <span class='count'>")
    u.buf_int(b, item.fields.len)
    u.buf_add(
        b,
        c"</span></summary><div class='panel-body'><div class='table-wrap'><table class='fields'><thead><tr><th>Field</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>\n"
    )
    val i: mut i64 = 0
    for {
        if i >= item.fields.len {
            break
        }
        val f: ref DocField = u.vec_p(item.fields, i) as ref DocField
        u.buf_add(b, c"<tr><td><code>")
        html_escape(b, f.name)
        u.buf_add(b, c"</code></td><td><code>")
        if f.typ != none {
            hl_code_inner(b, f.typ)
        }
        u.buf_add(b, c"</code></td><td>")
        if u.s_len(f.default_text) > 0 {
            u.buf_add(b, c"<code>")
            hl_code_inner(b, f.default_text)
            u.buf_add(b, c"</code>")
        }
        u.buf_add(b, c"</td><td>")
        html_cell(b, f.docs)
        u.buf_add(b, c"</td></tr>\n")
        i++
    }
    u.buf_add(b, c"</tbody></table></div></div></details>\n")
}

fn kind_label(kind: i64) ref u8 = trust {
    if kind == 0 {
        return c"type"
    }
    if kind == 1 {
        return c"function"
    }
    if kind == 2 {
        return c"variable"
    }
    return c"constant"
}

fn render_sidebar(b: mut ref u.Buf, items: ref u.Vec) void = trust {
    u.buf_add(b, c"<aside class='sidebar'><div class='sidebar-inner'>\n")
    val names: mut ref u.Vec = u.vec_new()
    u.vec_pushp(names, c"Types" as ref void)
    u.vec_pushp(names, c"Functions" as ref void)
    u.vec_pushp(names, c"Variables" as ref void)
    u.vec_pushp(names, c"Constants" as ref void)
    val si: mut i64 = 0
    for {
        if si >= names.len {
            break
        }
        val kind: i64 = si
        val any: mut bool = false
        val i: mut i64 = 0
        for {
            if i >= items.len {
                break
            }
            val item: ref DocItem = u.vec_p(items, i) as ref DocItem
            if item.kind == kind {
                any = true
                break
            }
            i++
        }
        if any {
            u.buf_add(b, c"<div class='nav-section'><div class='nav-heading'>")
            u.buf_add(b, u.vec_p(names, si) as ref u8)
            u.buf_add(b, c"</div><ul>\n")
            i = 0
            for {
                if i >= items.len {
                    break
                }
                val item: ref DocItem = u.vec_p(items, i) as ref DocItem
                if item.kind == kind {
                    u.buf_add(b, c"<li class='nav-item")
                    if !item.public {
                        u.buf_add(b, c" private")
                    }
                    u.buf_add(b, c"'><a href='#item-")
                    u.buf_int(b, i)
                    u.buf_add(b, c"'><code>")
                    html_escape(b, item.name)
                    u.buf_add(b, c"</code></a></li>\n")
                }
                i++
            }
            u.buf_add(b, c"</ul></div>\n")
        }
        si++
    }
    u.buf_add(b, c"</div></aside>\n")
}

fn render_styles(b: mut ref u.Buf) void = trust {
    u.buf_add(b, c"<style>\n")
    u.buf_addn(b, doc_css, doc_css_len)
    u.buf_add(b, c"</style>\n")
}

fn render_scripts(b: mut ref u.Buf) void = trust {
    u.buf_add(b, c"<script>\n")
    u.buf_addn(b, doc_js, doc_js_len)
    u.buf_add(b, c"</script>\n")
}

fn render_item(b: mut ref u.Buf, item: ref DocItem, id: ref u8, label: ref u8) void = trust {
    u.buf_add(b, c"<details class='item")
    if !item.public {
        u.buf_add(b, c" private")
    }
    u.buf_add(b, c"' id='")
    u.buf_add(b, id)
    u.buf_add(b, c"' open><summary class='item-summary'><span class='kind'>")
    u.buf_add(b, label)
    u.buf_add(b, c"</span>")
    hl_code(b, item.signature)
    if !item.public {
        u.buf_add(b, c"<span class='badge private'>private</span>")
    }
    u.buf_add(b, c"</summary><div class='item-body'>\n")
    html_docs(b, item.docs)
    if item.kind == 0 {
        html_fields(b, item)
    }
    if item.methods.len > 0 {
        u.buf_add(b, c"<details class='panel' open><summary>Methods <span class='count'>")
        u.buf_int(b, item.methods.len)
        u.buf_add(b, c"</span></summary><div class='panel-body'>\n")
        val mi: mut i64 = 0
        for {
            if mi >= item.methods.len {
                break
            }
            val method: ref DocItem = u.vec_p(item.methods, mi) as ref DocItem
            val mid: ref u8 = u.s_cat(u.s_cat(id, c"-m"), u.s_int(mi))
            render_item(b, method, mid, c"method")
            mi++
        }
        u.buf_add(b, c"</div></details>\n")
    }
    u.buf_add(b, c"</div></details>\n")
}

fn render_html(items: ref u.Vec, title: ref u8) ref u8 = trust {
    val b: mut ref u.Buf = u.buf_new()
    u.buf_add(
        b,
        c\\<!doctype html>
        \\<html lang='en' data-theme='light'>
        \\<head>
        \\<meta charset='utf-8'>
        \\<meta name='viewport' content='width=device-width, initial-scale=1'>
        \\<title>
    )
    html_escape(b, title)
    u.buf_add(b, c" - Blood docs</title>\n")
    render_styles(b)
    u.buf_add(
        b,
        c\\</head>
        \\<body class='show-private'>
        \\<header class='topbar'>
        \\<div class='brand'><span>blood</span><span class='sub'>docs</span></div>
        \\<div class='actions'>
        \\<button type='button' class='btn' id='expand-all'>Expand all</button>
        \\<button type='button' class='btn' id='collapse-all'>Collapse all</button>
        \\<label class='switch'><input type='checkbox' id='show-private' checked> Private</label>
        \\<button type='button' class='btn' id='theme-toggle'>Dark</button>
        \\</div>
        \\</header>
        \\<div class='layout'>
    )
    render_sidebar(b, items)
    u.buf_add(
        b,
        c\\<main class='content'>
        \\<div class='page-head'>
        \\<div class='breadcrumb'>Documentation</div>
        \\<h1>
    )
    html_escape(b, title)
    u.buf_add(
        b,
        c\\</h1>
        \\<p>Generated by blood -doc</p>
        \\</div>
    )
    val names: mut ref u.Vec = u.vec_new()
    u.vec_pushp(names, c"Types" as ref void)
    u.vec_pushp(names, c"Functions" as ref void)
    u.vec_pushp(names, c"Variables" as ref void)
    u.vec_pushp(names, c"Constants" as ref void)
    val anchors: mut ref u.Vec = u.vec_new()
    u.vec_pushp(anchors, c"types" as ref void)
    u.vec_pushp(anchors, c"functions" as ref void)
    u.vec_pushp(anchors, c"variables" as ref void)
    u.vec_pushp(anchors, c"constants" as ref void)
    val si: mut i64 = 0
    for {
        if si >= names.len {
            break
        }
        val kind: i64 = si
        val count: mut i64 = 0
        val i: mut i64 = 0
        for {
            if i >= items.len {
                break
            }
            val item: ref DocItem = u.vec_p(items, i) as ref DocItem
            if item.kind == kind {
                count++
            }
            i++
        }
        if count > 0 {
            u.buf_add(b, c"<section class='section' id='section-")
            u.buf_add(b, u.vec_p(anchors, si) as ref u8)
            u.buf_add(b, c"'><h2>")
            u.buf_add(b, u.vec_p(names, si) as ref u8)
            u.buf_add(b, c" <span class='count'>")
            u.buf_int(b, count)
            u.buf_add(b, c"</span></h2>\n")
            val idx: mut i64 = 0
            for {
                if idx >= items.len {
                    break
                }
                val item: ref DocItem = u.vec_p(items, idx) as ref DocItem
                if item.kind == kind {
                    val id: ref u8 = u.s_cat(c"item-", u.s_int(idx))
                    render_item(b, item, id, kind_label(kind))
                }
                idx++
            }
            u.buf_add(b, c"</section>\n")
        }
        si++
    }
    u.buf_add(b, c"</main>\n</div>\n")
    render_scripts(b)
    u.buf_add(b, c"</body>\n</html>\n")
    return u.buf_take(b)
}

fn blood_file(path: ref u8) bool = trust {
    return u.s_ends_with(path, c".bx") || u.s_ends_with(path, c".blood")
}

fn skip_dir(name: ref u8) bool = trust {
    return u.s_eq(name, c".git") || u.s_eq(name, c"node_modules") || u.s_eq(
        name,
        c".sxb"
    ) || u.s_eq(name, c"bx-docs-out")
}

fn replace_extension(path: ref u8, ext: ref u8) ref u8 = trust {
    val n: i64 = u.s_len(path)
    val i: mut i64 = n - 1
    for {
        if i < 0 {
            break
        }
        val c: u8 = @load8(@ptradd(path, i))
        if c == 47 || c == 92 {
            break
        }
        if c == 46 {
            return u.s_cat(u.s_substr(path, 0, i), ext)
        }
        i--
    }
    return u.s_cat(path, ext)
}

fn relative_path(path: ref u8) ref u8 = trust {
    if !u.path_is_abs(path) {
        if u.s_starts(path, c"./") {
            return u.s_substr(path, 2, u.s_len(path))
        }
        return path
    }
    val cwd: ref u8 = u.cwd()
    if u.s_starts(path, cwd) {
        val at: i64 = u.s_len(cwd)
        if at < u.s_len(path) && (@load8(@ptradd(path, at)) == 47 || @load8(@ptradd(path, at)) == 92) {
            return u.s_substr(path, at + 1, u.s_len(path))
        }
    }
    return u.path_base(path)
}

fn relative_root(path: ref u8) ref u8 = trust {
    val rel: ref u8 = relative_path(path)
    if u.s_eq(rel, c".") || u.s_eq(rel, c"./") || u.s_len(rel) == 0 {
        return c""
    }
    val n: i64 = u.s_len(rel)
    if n > 0 && (@load8(@ptradd(rel, n - 1)) == 47 || @load8(@ptradd(rel, n - 1)) == 92) {
        return u.s_substr(rel, 0, n - 1)
    }
    return rel
}

fn target_path(rel: ref u8, out_dir: ref u8, markdown: bool) ref u8 = trust {
    val ext: mut ref u8 = c".html"
    if markdown {
        ext = c".md"
    }
    val root: mut ref u8 = c"bx-docs-out"
    if out_dir != none && u.s_len(out_dir) > 0 {
        root = out_dir
    }
    return u.path_join(root, replace_extension(rel, ext))
}

fn generate_file(path: ref u8, rel: ref u8, out_dir: ref u8, markdown: bool) i32 = trust {
    val src: ref u8 = u.read_file(path)
    if src == none {
        u.write_fd(2, u.s_cat3(c"blood: -doc: ", path, c": cannot read file\n"))
        return 1
    }
    lang.clear_error()
    val program: ref lang.Node = lang.parse(src)
    if lang.last_error() != none {
        val b: mut ref u.Buf = u.buf_new()
        u.buf_add(b, c"blood: -doc: ")
        u.buf_add(b, path)
        u.buf_ch(b, 58)
        u.buf_add(b, u.s_int(lang.last_error_line()))
        u.buf_ch(b, 58)
        u.buf_add(b, u.s_int(lang.last_error_col()))
        u.buf_add(b, c": ")
        u.buf_add(b, lang.last_error())
        u.buf_ch(b, 10)
        u.write_fd(2, u.buf_take(b))
        return 1
    }
    val lines: ref u.Vec = split_lines(src)
    val items: ref u.Vec = collect_docs(program, lines)
    val title: ref u8 = u.path_base(path)
    val out: mut ref u8 = render_html(items, title)
    if markdown {
        out = render_md(items, title)
    }
    val target: ref u8 = target_path(rel, out_dir, markdown)
    u.mkdir_p(u.path_dir(target))
    if !u.write_file(target, out) {
        u.write_fd(2, u.s_cat3(c"blood: -doc: ", target, c": cannot write file\n"))
        return 1
    }
    u.stdout_ln(u.s_cat3(path, c" -> ", target))
    return 0
}

fn generate_dir(path: ref u8, rel: ref u8, out_dir: ref u8, markdown: bool) i32 = trust {
    val d: ref void = u.dir_open(path)
    if d == none {
        u.write_fd(2, u.s_cat3(c"blood: -doc: ", path, c": cannot read directory\n"))
        return 1
    }
    val names: mut ref u.Vec = u.vec_new()
    for {
        val name: ref u8 = u.dir_next(d)
        if name == none {
            break
        }
        if u.s_eq(name, c".") || u.s_eq(name, c"..") {
            continue
        }
        u.vec_pushp(names, u.s_dup(name) as ref void)
    }
    u.dir_close(d)
    val rc: mut i32 = 0
    val i: mut i64 = 0
    for {
        if i >= names.len {
            break
        }
        val name: ref u8 = u.vec_p(names, i) as ref u8
        val child: ref u8 = u.path_join(path, name)
        val child_rel: mut ref u8 = name
        if u.s_len(rel) > 0 {
            child_rel = u.path_join(rel, name)
        }
        if u.is_dir(child) {
            if !skip_dir(name) && generate_dir(child, child_rel, out_dir, markdown) != 0 {
                rc = 1
            }
        } elif blood_file(child) && generate_file(
            child,
            child_rel,
            out_dir,
            markdown
        ) != 0 {
            rc = 1
        }
        i++
    }
    return rc
}

pub fn generate_paths(paths: ref u.Vec, out_dir: ref u8, markdown: bool) i32 = trust {
    val rc: mut i32 = 0
    val i: mut i64 = 0
    for {
        if i >= paths.len {
            break
        }
        val path: ref u8 = u.vec_p(paths, i) as ref u8
        if u.is_dir(path) {
            if generate_dir(path, relative_root(path), out_dir, markdown) != 0 {
                rc = 1
            }
        } elif blood_file(path) {
            if generate_file(path, relative_path(path), out_dir, markdown) != 0 {
                rc = 1
            }
        } else {
            u.write_fd(2, u.s_cat3(c"blood: -doc: ", path, c": expected a .bx or .blood file\n"))
            rc = 1
        }
        i++
    }
    return rc
}
