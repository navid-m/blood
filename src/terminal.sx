/// Terminal handling, raw mode, and the interactive line editor.

val u       = use("util.sx")
val cfgmod  = use("config.sx")
val histmod = use("history.sx")
val comp    = use("completion.sx")
val rt      = use("std/runtime")

when darwin {
    /// Darwin `struct termios`: `tcflag_t` and `speed_t` are C `unsigned long`
    /// (64-bit) and `NCCS` is 20.
    extern type Termios = {
        c_iflag: mut u64
        c_oflag: mut u64
        c_cflag: mut u64
        c_lflag: mut u64
        c_cc: mut [20]u8
        c_ispeed: mut u64
        c_ospeed: mut u64
    }
}
otherwise {
    pub type Termios = {
        c_iflag: mut u32
        c_oflag: mut u32
        c_cflag: mut u32
        c_lflag: mut u32
        c_line: mut u8
        c_cc: mut [32]u8
        c_ispeed: mut u32
        c_ospeed: mut u32
    }
}

when darwin {
    /// `ioctl` is variadic, and Darwin's AArch64 ABI passes variadic
    /// arguments on the stack. Declaring it as variadic keeps that contract.
    extern "sys/ioctl.h"
    extern (C, header) fn c_ioctl(fd: i32, req: u64, ...) i32 = "ioctl"
}

pub type PollFd = {
    fd: mut i32
    events: mut i16
    revents: mut i16
}

pub type WinSize = {
    rows: u16
    cols: u16
    xpixel: u16
    ypixel: u16
}

pub type TermState = {
    orig: mut Termios
    have_tty: mut i64
    raw_active: mut i64
}

val term: mut TermState = @zeroed

pub type Editor = {
    cfg: mut ref cfgmod.Config
    hist: mut ref histmod.History
    vars: mut ref u.Map
    aliases: mut ref u.Map
    line: mut ref u8
    len: mut i64
    cap: mut i64
    pos: mut i64
    view_start: mut i64
    right_prompt: mut ref u8
    hist_index: mut i64
    draft: mut ref u8
    cancelled: mut i64
    eof: mut i64
    first_draw: mut i64
    drawn_rows: mut i64
    menu_active: mut i64
    menu_items: mut ref u.Vec
    menu_index: mut i64
    menu_start: mut i64
    menu_end: mut i64
    menu_base: mut ref u8
    menu_kind: mut i64
    search_active: mut i64
    search_query: mut ref u8
    search_index: mut i64
    search_orig: mut ref u8
}

fn const_icanon() u32 = trust {
    return 2 as u32
}

fn const_echo() u32 = trust {
    return 8 as u32
}

fn const_isig() u32 = trust {
    return 1 as u32
}

fn const_iexten() u32 = trust {
    return 32768 as u32
}

fn const_ixon() u32 = trust {
    return 1024 as u32
}

fn const_icrnl() u32 = trust {
    return 256 as u32
}

fn d_const_echo() u64 = trust {
    return 8 as u64
}

fn d_const_icanon() u64 = trust {
    return 256 as u64
}

fn d_const_isig() u64 = trust {
    return 128 as u64
}

fn d_const_iexten() u64 = trust {
    return 1024 as u64
}

fn d_const_ixon() u64 = trust {
    return 512 as u64
}

fn d_const_icrnl() u64 = trust {
    return 256 as u64
}

fn winsize_request() u64 = trust {
    when darwin {
        return 1074295912 as u64
    }
    otherwise {
        return 21523 as u64
    }
}

fn query_winsize(ws: ref WinSize) i32 = trust {
    when darwin {
        return c_ioctl(1, winsize_request(), ws as ref void)
    }
    otherwise {
        return rt.ioctl(1, winsize_request(), ws as ref void)
    }
}

pub fn init_terminal() void = trust {
    val t: mut Termios = @zeroed
    if rt.tcgetattr(0, @addr(t) as ref void) == 0 {
        term.orig = t
        term.have_tty = 1
    } else {
        term.have_tty = 0
    }
    term.raw_active = 0
}

pub fn have_tty() bool = trust {
    return term.have_tty != 0
}

pub fn raw_mode() void = trust {
    if term.have_tty == 0 {
        return
    }
    when darwin {
        val t: mut Termios = term.orig
        t.c_lflag = t.c_lflag & ~(d_const_echo() | d_const_icanon() | d_const_iexten() | d_const_isig())
        t.c_iflag = t.c_iflag & ~(d_const_ixon() | d_const_icrnl())
        @store8(@ptradd(@addr(t.c_cc) as ref u8, 16), 1)
        @store8(@ptradd(@addr(t.c_cc) as ref u8, 17), 0)
        rt.tcsetattr(0, 0, @addr(t) as ref void)
    }
    otherwise {
        val t: mut Termios = term.orig
        t.c_lflag = t.c_lflag & ~(const_echo() | const_icanon() | const_iexten() | const_isig())
        t.c_iflag = t.c_iflag & ~(const_ixon() | const_icrnl())
        @store8(@ptradd(@addr(t.c_cc) as ref u8, 6), 1)
        @store8(@ptradd(@addr(t.c_cc) as ref u8, 5), 0)
        rt.tcsetattr(0, 0, @addr(t) as ref void)
    }
    term.raw_active = 1
}

pub fn cooked_mode() void = trust {
    if term.have_tty == 0 {
        return
    }
    rt.tcsetattr(0, 0, @addr(term.orig) as ref void)
    term.raw_active = 0
}

pub fn cols() i64 = trust {
    val ws: mut WinSize = @zeroed
    if query_winsize(@addr(ws)) == 0 && ws.cols > 0 {
        return ws.cols as i64
    }
    return 80
}

pub fn rows() i64 = trust {
    val ws: mut WinSize = @zeroed
    if query_winsize(@addr(ws)) == 0 && ws.rows > 0 {
        return ws.rows as i64
    }
    return 24
}

pub fn write_s(s: ref u8) void = trust {
    u.write_fd(1, s)
}

fn read_key() i32 = trust {
    val c: mut u8 = 0
    val n: i64 = rt.read(0, @addr(c) as ref void, 1)
    if n <= 0 {
        return -1
    }
    return c as i32
}

fn read_key_timeout(ms: i32) i32 = trust {
    val pfd: mut PollFd = @zeroed
    pfd.fd = 0
    pfd.events = 1
    pfd.revents = 0
    if rt.poll(@addr(pfd) as ref void, 1, ms) <= 0 {
        return -1
    }
    return read_key()
}

pub fn editor_new(
    c: ref cfgmod.Config,
    h: ref histmod.History,
    vars: ref u.Map,
    aliases: ref u.Map
) ref Editor = trust {
    val e: mut ref Editor = u.xalloc(@sizeof(Editor) as i64) as ref Editor
    e.cfg = c
    e.hist = h
    e.vars = vars
    e.aliases = aliases
    e.cap = 256
    e.line = u.xalloc(256) as ref u8
    @store8(e.line, 0)
    e.len = 0
    e.pos = 0
    e.view_start = 0
    e.right_prompt = u.s_dup(c"")
    e.hist_index = h.items.len
    e.draft = u.s_dup(c"")
    e.cancelled = 0
    e.eof = 0
    e.first_draw = 1
    e.drawn_rows = 1
    e.menu_active = 0
    e.menu_items = none
    e.menu_index = 0
    e.menu_start = 0
    e.menu_end = 0
    e.menu_base = u.s_dup(c"")
    e.menu_kind = 0
    e.search_active = 0
    e.search_query = u.s_dup(c"")
    e.search_index = h.items.len - 1
    e.search_orig = u.s_dup(c"")
    return e
}

pub fn was_cancelled(e: ref Editor) bool = trust {
    return e.cancelled != 0
}

pub fn was_eof(e: ref Editor) bool = trust {
    return e.eof != 0
}

fn ed_reserve(e: mut ref Editor, extra: i64) void = trust {
    val need: i64 = e.len + extra + 1
    if need <= e.cap {
        return
    }
    val nc: mut i64 = e.cap * 2
    for {
        if nc >= need {
            break
        }
        nc = nc * 2
    }
    e.line = u.mem_realloc(e.line as ref void, nc)
    e.cap = nc
}

fn ed_set(e: mut ref Editor, s: ref u8) void = trust {
    val n: i64 = u.s_len(s)
    e.len = 0
    ed_reserve(e, n)
    if n > 0 {
        u.mem_copy(e.line as ref void, s, n)
    }
    e.len = n
    e.pos = n
    @store8(@ptradd(e.line, n), 0)
}

fn ed_insert_byte(e: mut ref Editor, c: u8) void = trust {
    ed_reserve(e, 1)
    if e.pos < e.len {
        u.mem_move(
            @ptradd(e.line, e.pos + 1) as ref void,
            @ptradd(e.line, e.pos) as ref void,
            e.len - e.pos
        )
    }
    @store8(@ptradd(e.line, e.pos), c)
    e.len++
    e.pos++
    @store8(@ptradd(e.line, e.len), 0)
}

fn ed_backspace(e: mut ref Editor) void = trust {
    if e.pos <= 0 {
        return
    }
    val prev: i64 = u.utf8_prev(e.line, e.pos)
    val count: i64 = e.pos - prev
    if e.pos < e.len {
        u.mem_move(
            @ptradd(e.line, prev) as ref void,
            @ptradd(e.line, e.pos) as ref void,
            e.len - e.pos
        )
    }
    e.len = e.len - count
    e.pos = prev
    @store8(@ptradd(e.line, e.len), 0)
}

fn ed_delete(e: mut ref Editor) void = trust {
    if e.pos >= e.len {
        return
    }
    val next: i64 = u.utf8_next(e.line, e.pos, e.len)
    val count: i64 = next - e.pos
    if next < e.len {
        u.mem_move(
            @ptradd(e.line, e.pos) as ref void,
            @ptradd(e.line, next) as ref void,
            e.len - next
        )
    }
    e.len = e.len - count
    @store8(@ptradd(e.line, e.len), 0)
}

fn ed_kill_to_end(e: mut ref Editor) void = trust {
    if e.pos < e.len {
        e.len = e.pos
        @store8(@ptradd(e.line, e.len), 0)
    }
}

fn ed_kill_word(e: mut ref Editor) void = trust {
    val end: i64 = e.pos
    val i: mut i64 = e.pos
    for {
        if i <= 0 {
            break
        }
        val c: u8 = @load8(@ptradd(e.line, i - 1))
        if c != 32 && c != 9 {
            break
        }
        i--
    }
    for {
        if i <= 0 {
            break
        }
        val c: u8 = @load8(@ptradd(e.line, i - 1))
        if c == 32 || c == 9 {
            break
        }
        i--
    }
    replace_range(e, i, end, c"")
}

fn replace_range(e: mut ref Editor, start: i64, end: i64, repl: ref u8) void = trust {
    val b: mut ref u.Buf = u.buf_new()
    if start > 0 {
        u.buf_addn(b, e.line, start)
    }
    u.buf_add(b, repl)
    if end < e.len {
        u.buf_addn(b, @ptradd(e.line, end), e.len - end)
    }
    val newline: ref u8 = u.buf_take(b)
    val newpos: i64 = start + u.s_len(repl)
    ed_set(e, newline)
    e.pos = newpos
}

fn line_with_prefix(line: ref u8, start: i64, repl: ref u8, end: i64) ref u8 = trust {
    val b: mut ref u.Buf = u.buf_new()
    if start > 0 {
        u.buf_addn(b, line, start)
    }
    u.buf_add(b, repl)
    val n: i64 = u.s_len(line)
    if end < n {
        u.buf_addn(b, @ptradd(line, end), n - end)
    }
    return u.buf_take(b)
}

fn display_width(line: ref u8, start: i64, end: i64) i64 = trust {
    val i: mut i64 = start
    val w: mut i64 = 0
    for {
        if i >= end {
            break
        }
        val c: u8 = @load8(@ptradd(line, i))
        if c == 10 || c == 13 {
            w++
            i++
            continue
        }
        if (c & 192) != 128 {
            w++
        }
        i++
    }
    return w
}

fn emit_display_segment(b: mut ref u.Buf, line: ref u8, start: i64, end: i64) void = trust {
    val i: mut i64 = start
    for {
        if i >= end {
            break
        }
        val c: u8 = @load8(@ptradd(line, i))
        if c == 10 {
            u.buf_add(b, c"\xe2\x8f\x8e")
        } elif c == 13 {
            u.buf_ch(b, 32)
        } else {
            u.buf_ch(b, c)
        }
        i++
    }
}

fn prompt_last_width(prompt: ref u8) i64 = trust {
    val n: i64 = u.s_len(prompt)
    val start: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        if @load8(@ptradd(prompt, i)) == 10 {
            start = i + 1
        }
        i++
    }
    return u.visible_width(u.s_substr(prompt, start, n))
}

fn prompt_rows(prompt: ref u8) i64 = trust {
    val n: i64 = u.s_len(prompt)
    val i: mut i64 = 0
    val r: mut i64 = 1
    for {
        if i >= n {
            break
        }
        if @load8(@ptradd(prompt, i)) == 10 {
            r++
        }
        i++
    }
    return r
}

fn common_prefix(items: ref u.Vec) ref u8 = trust {
    if items.len == 0 {
        return u.s_dup(c"")
    }
    val first: ref u8 = u.vec_p(items, 0) as ref u8
    val n: i64 = u.s_len(first)
    val upto: mut i64 = n
    val i: mut i64 = 1
    for {
        if i >= items.len {
            break
        }
        val s: ref u8 = u.vec_p(items, i) as ref u8
        val m: i64 = u.s_len(s)
        if m < upto {
            upto = m
        }
        val j: mut i64 = 0
        for {
            if j >= upto {
                break
            }
            if @load8(@ptradd(first, j)) != @load8(@ptradd(s, j)) {
                upto = j
                break
            }
            j++
        }
        i++
    }
    return u.s_substr(first, 0, upto)
}

fn menu_label(kind: i64) ref u8 = trust {
    if kind == 2 {
        return c"paths"
    }
    if kind == 3 {
        return c"variables"
    }
    return c"commands"
}

fn buf_spaces(b: mut ref u.Buf, n: i64) void = trust {
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        u.buf_ch(b, 32)
        i++
    }
}

fn buf_rule(b: mut ref u.Buf, n: i64) void = trust {
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        u.buf_add(b, c"─")
        i++
    }
}

fn buf_clipped(b: mut ref u.Buf, s: ref u8, maxw: i64) void = trust {
    if maxw <= 0 {
        return
    }
    val n: i64 = u.s_len(s)
    if n == 0 {
        return
    }
    if u.visible_width(s) <= maxw {
        u.buf_add(b, s)
        return
    }
    val limit: i64 = maxw - 1
    val i: mut i64 = 0
    val w: mut i64 = 0
    for {
        if i >= n || w >= limit {
            break
        }
        val next: i64 = u.utf8_next(s, i, n)
        u.buf_addn(b, @ptradd(s, i), next - i)
        w++
        i = next
    }
    u.buf_add(b, c"…")
}

fn buf_cell(b: mut ref u.Buf, item: ref u8, width: i64, selected: bool) void = trust {
    if selected {
        u.buf_add(b, c"\x1b[7m")
    }
    u.buf_ch(b, 32)
    buf_clipped(b, item, width - 2)
    val used: mut i64 = u.visible_width(item)
    if used > width - 2 {
        used = width - 2
    }
    buf_spaces(b, width - 1 - used)
    if selected {
        u.buf_add(b, c"\x1b[0m")
    }
}

fn draw_menu_box(b: mut ref u.Buf, e: ref Editor, prompt_rows: i64) i64 = trust {
    val total: i64 = e.menu_items.len
    if total == 0 {
        return 0
    }
    val termw: i64 = cols()
    val avail_below: i64 = rows() - prompt_rows - 1
    if termw < 8 || avail_below < 3 {
        return 0
    }
    val max_total: i64 = 10
    val max_inner: i64 = avail_below - 2
    val inner_cap: mut i64 = max_inner
    if inner_cap > max_total - 2 {
        inner_cap = max_total - 2
    }
    if inner_cap < 1 {
        return 0
    }
    val scan: mut i64 = total
    if scan > 512 {
        scan = 512
    }
    val maxw: mut i64 = 1
    val i: mut i64 = 0
    for {
        if i >= scan {
            break
        }
        val item: ref u8 = u.vec_p(e.menu_items, i) as ref u8
        val w: i64 = u.visible_width(item)
        if w > maxw {
            maxw = w
        }
        i++
    }
    val avail_w: i64 = termw - 2
    val colw: mut i64 = maxw + 2
    if colw < 6 {
        colw = 6
    }
    if colw > avail_w {
        colw = avail_w
    }
    val ncols: mut i64 = avail_w / colw
    if ncols < 1 {
        ncols = 1
    }
    if ncols > total {
        ncols = total
    }
    val boxw: i64 = ncols * colw + 2
    val interior: i64 = boxw - 2
    val needed_rows: i64 = (total + ncols - 1) / ncols
    val inner: mut i64 = needed_rows
    if inner > inner_cap {
        inner = inner_cap
    }
    val sel_row: mut i64 = -1
    if e.menu_index >= 0 {
        sel_row = e.menu_index / ncols
    }
    val off: mut i64 = 0
    if sel_row >= 0 {
        if sel_row >= inner {
            off = sel_row - inner + 1
        }
    }
    val maxoff: i64 = needed_rows - inner
    if off > maxoff {
        off = maxoff
    }
    if off < 0 {
        off = 0
    }

    u.buf_add(b, c"\x1b[90m")
    val label: ref u8 = u.s_cat3(menu_label(e.menu_kind), c" ", u.s_int(total))
    val lw: i64 = u.s_len(label)
    if interior >= lw + 4 {
        u.buf_add(b, c"┌─ ")
        u.buf_add(b, label)
        u.buf_ch(b, 32)
        buf_rule(b, interior - 3 - lw)
    } else {
        u.buf_add(b, c"┌")
        buf_rule(b, interior)
    }
    u.buf_add(b, c"┐\x1b[0m")

    val r: mut i64 = 0
    for {
        if r >= inner {
            break
        }
        u.buf_add(b, c"\r\n\x1b[90m│\x1b[0m")
        val row: i64 = off + r
        val cidx: mut i64 = 0
        for {
            if cidx >= ncols {
                break
            }
            val idx: i64 = row * ncols + cidx
            if idx < total {
                val item: ref u8 = u.vec_p(e.menu_items, idx) as ref u8
                buf_cell(b, item, colw, idx == e.menu_index)
            } else {
                buf_spaces(b, colw)
            }
            cidx++
        }
        u.buf_add(b, c"\x1b[90m│\x1b[0m")
        r++
    }

    u.buf_add(b, c"\r\n\x1b[90m└")
    buf_rule(b, interior)
    u.buf_add(b, c"┘\x1b[0m")
    return inner + 2
}

fn display_prompt(e: ref Editor, prompt: ref u8) ref u8 = trust {
    if e.search_active == 0 {
        return prompt
    }
    val b: mut ref u.Buf = u.buf_new()
    u.buf_add(b, c"\x1b[36m(reverse-i-search)\x1b[0m `")
    u.buf_add(b, e.search_query)
    u.buf_add(b, c"': ")
    return u.buf_take(b)
}

fn draw(e: mut ref Editor, prompt: ref u8) void = trust {
    val pr: ref u8 = display_prompt(e, prompt)
    val prompt_row_count: i64 = prompt_rows(pr)
    if e.first_draw == 0 {
        val rows_up: i64 = e.drawn_rows - 1
        if rows_up > 0 {
            write_s(u.s_cat3(c"\x1b[", u.s_int(rows_up), c"A"))
        }
        write_s(c"\r")
    } else {
        e.first_draw = 0
    }
    val pwidth: i64 = prompt_last_width(pr)
    val termw: i64 = cols()
    val rightw: mut i64 = 0
    if e.right_prompt != none {
        rightw = u.visible_width(e.right_prompt)
    }
    if rightw > 0 && termw - pwidth - rightw - 1 < 4 {
        rightw = 0
    }
    val avail: mut i64 = termw - pwidth - 1
    if rightw > 0 {
        avail = termw - pwidth - rightw - 1
    } elif avail < 10 {
        avail = 10
    }
    if e.pos < e.view_start {
        e.view_start = e.pos
    }
    for {
        if display_width(e.line, e.view_start, e.pos) <= avail {
            break
        }
        if e.view_start >= e.len {
            break
        }
        e.view_start = u.utf8_next(e.line, e.view_start, e.len)
    }
    val end: mut i64 = e.view_start
    val w: mut i64 = 0
    for {
        if end >= e.len {
            break
        }
        val nw: i64 = display_width(e.line, end, u.utf8_next(e.line, end, e.len))
        if w + nw > avail {
            break
        }
        w = w + nw
        end = u.utf8_next(e.line, end, e.len)
    }
    val b: mut ref u.Buf = u.buf_new()
    u.buf_add(b, pr)
    emit_display_segment(b, e.line, e.view_start, end)
    u.buf_add(b, c"\x1b[J")
    if rightw > 0 {
        u.buf_add(b, u.s_cat3(c"\x1b[", u.s_int(termw - rightw + 1), c"G"))
        u.buf_add(b, e.right_prompt)
        u.buf_add(b, c"\x1b[0m")
    }
    val menu_rows: mut i64 = 0
    if e.menu_active == 1 && e.menu_items != none && e.menu_items.len > 0 {
        u.buf_add(b, c"\r\n")
        menu_rows = draw_menu_box(b, e, prompt_row_count)
    }
    if menu_rows > 0 {
        u.buf_add(b, u.s_cat3(c"\x1b[", u.s_int(menu_rows), c"A"))
    }
    u.buf_add(b, c"\r")
    val col: mut i64 = pwidth + display_width(e.line, e.view_start, e.pos) + 1
    if col > termw {
        col = termw
    }
    if col < 1 {
        col = 1
    }
    u.buf_add(b, u.s_cat3(c"\x1b[", u.s_int(col), c"G"))
    u.buf_add(b, c"\x1b[0m")
    write_s(u.buf_take(b))
    e.drawn_rows = prompt_row_count
}

fn history_recall(e: mut ref Editor, up: bool) void = trust {
    val total: i64 = e.hist.items.len
    if total == 0 {
        return
    }
    if up {
        if e.hist_index == total {
            e.draft = u.s_dup(e.line)
        }
        if e.hist_index > 0 {
            e.hist_index--
            ed_set(e, u.vec_p(e.hist.items, e.hist_index) as ref u8)
            e.pos = e.len
        }
    } else {
        if e.hist_index < total - 1 {
            e.hist_index++
            ed_set(e, u.vec_p(e.hist.items, e.hist_index) as ref u8)
            e.pos = e.len
        } elif e.hist_index == total - 1 {
            e.hist_index = total
            ed_set(e, e.draft)
            e.pos = e.len
        }
    }
    e.menu_active = 0
}

fn search_find(e: mut ref Editor, from: i64) void = trust {
    val idx: i64 = histmod.history_search(e.hist, e.search_query, from)
    if idx < 0 {
        return
    }
    e.search_index = idx
    ed_set(e, u.vec_p(e.hist.items, idx) as ref u8)
    e.pos = e.len
}

fn open_completion(e: mut ref Editor) void = trust {
    val res: comp.CompResult = comp.complete(e.cfg, e.line, e.pos, e.vars, e.aliases)
    if res.items.len == 0 {
        write_s(c"\x07")
        e.menu_active = 0
        return
    }
    if res.items.len == 1 {
        replace_range(e, res.start, res.end, u.vec_p(res.items, 0) as ref u8)
        e.menu_active = 0
        return
    }
    val word: ref u8 = u.s_substr(e.line, res.start, res.end)
    val common: ref u8 = common_prefix(res.items)
    val start: i64 = res.start
    val end: mut i64 = res.end
    if u.s_len(common) > u.s_len(word) {
        replace_range(e, res.start, res.end, common)
        end = start + u.s_len(common)
    }
    e.menu_active = 1
    e.menu_items = res.items
    e.menu_index = -1
    e.menu_start = start
    e.menu_end = end
    e.menu_base = u.s_dup(e.line)
    e.menu_kind = res.kind
}

fn apply_menu_item(e: mut ref Editor) void = trust {
    if e.menu_active == 0 || e.menu_items == none || e.menu_items.len == 0 {
        return
    }
    val item: ref u8 = u.vec_p(e.menu_items, e.menu_index) as ref u8
    val next: ref u8 = line_with_prefix(e.menu_base, e.menu_start, item, e.menu_end)
    ed_set(e, next)
    e.pos = e.menu_start + u.s_len(item)
}

fn menu_next(e: mut ref Editor, delta: i64) void = trust {
    if e.menu_active == 0 || e.menu_items == none || e.menu_items.len == 0 {
        return
    }
    val n: i64 = e.menu_items.len
    val idx: mut i64 = e.menu_index + delta
    if idx < 0 {
        idx = n - 1
    }
    if idx >= n {
        idx = 0
    }
    e.menu_index = idx
    apply_menu_item(e)
}

fn read_escape(e: mut ref Editor) i64 = trust {
    val c1: i32 = read_key_timeout(25)
    if c1 < 0 {
        return -1
    }
    if c1 == 91 {
        val params: mut ref u8 = u.s_dup(c"")
        val final: mut i32 = -1
        for {
            val k: i32 = read_key()
            if k < 0 {
                break
            }
            if k >= 48 && k <= 63 {
                val cb: u8 = k as u8
                val one: mut u8 = cb
                params = u.s_cat(params, u.s_ndup(@addr(one), 1))
                continue
            }
            final = k
            break
        }
        if final == 65 {
            history_recall(e, true)
            return 1
        }
        if final == 66 {
            history_recall(e, false)
            return 1
        }
        if final == 67 {
            if e.pos < e.len {
                e.pos = u.utf8_next(e.line, e.pos, e.len)
            }
            return 1
        }
        if final == 68 {
            if e.pos > 0 {
                e.pos = u.utf8_prev(e.line, e.pos)
            }
            return 1
        }
        if final == 72 || u.s_eq(params, c"1") || u.s_eq(params, c"7") {
            e.pos = 0
            return 1
        }
        if final == 70 || u.s_eq(params, c"4") || u.s_eq(params, c"8") {
            e.pos = e.len
            return 1
        }
        if final == 90 {
            if e.menu_active == 1 {
                menu_next(e, -1)
            }
            return 1
        }
        if final == 126 {
            if u.s_eq(params, c"3") {
                ed_delete(e)
            }
            return 1
        }
        return 1
    }
    if c1 == 98 {
        if e.pos > 0 {
            e.pos = u.utf8_prev(e.line, e.pos)
        }
        return 1
    }
    if c1 == 102 {
        if e.pos < e.len {
            e.pos = u.utf8_next(e.line, e.pos, e.len)
        }
        return 1
    }
    return 1
}

fn handle_search_key(e: mut ref Editor, k: i32) i64 = trust {
    if k == 3 || k == 27 {
        e.search_active = 0
        ed_set(e, e.search_orig)
        return 1
    }
    if k == 13 || k == 10 {
        e.search_active = 0
        return 2
    }
    if k == 18 {
        if e.search_index > 0 {
            search_find(e, e.search_index - 1)
        }
        return 1
    }
    if k == 127 || k == 8 {
        val n: i64 = u.s_len(e.search_query)
        if n > 0 {
            e.search_query = u.s_substr(e.search_query, 0, u.utf8_prev(e.search_query, n))
            search_find(e, e.hist.items.len - 1)
        }
        return 1
    }
    if k >= 32 && k < 127 {
        val cb: u8 = k as u8
        val one: mut u8 = cb
        e.search_query = u.s_cat(e.search_query, u.s_ndup(@addr(one), 1))
        search_find(e, e.hist.items.len - 1)
        return 1
    }
    return 1
}

fn end_input_line(e: mut ref Editor) void = trust {
    val had_menu: bool = e.menu_active == 1
    e.menu_active = 0
    if had_menu {
        write_s(c"\n\x1b[J")
    } else {
        write_s(c"\n")
    }
}

pub fn readline(e: mut ref Editor, prompt: ref u8, right: ref u8) ref u8 = trust {
    raw_mode()
    e.right_prompt = u.s_dup(right)
    e.first_draw = 1
    e.view_start = 0
    draw(e, prompt)
    for {
        val k: i32 = read_key()
        if k < 0 {
            e.eof = 1
            write_s(c"\n")
            return none
        }
        if e.search_active == 1 {
            val r: i64 = handle_search_key(e, k)
            if r == 2 {
                e.menu_active = 0
                write_s(c"\n")
                return u.s_dup(e.line)
            }
            draw(e, prompt)
            continue
        }
        if k == 13 || k == 10 {
            e.hist_index = e.hist.items.len
            end_input_line(e)
            return u.s_dup(e.line)
        }
        if k == 3 {
            e.cancelled = 1
            write_s(c"^C")
            end_input_line(e)
            return none
        }
        if k == 4 {
            if e.len == 0 {
                e.eof = 1
                end_input_line(e)
                return none
            }
            ed_delete(e)
            e.menu_active = 0
            draw(e, prompt)
            continue
        }
        if k == 1 {
            e.pos = 0
            e.menu_active = 0
            draw(e, prompt)
            continue
        }
        if k == 5 {
            e.pos = e.len
            e.menu_active = 0
            draw(e, prompt)
            continue
        }
        if k == 2 {
            if e.pos > 0 {
                e.pos = u.utf8_prev(e.line, e.pos)
            }
            e.menu_active = 0
            draw(e, prompt)
            continue
        }
        if k == 6 {
            if e.pos < e.len {
                e.pos = u.utf8_next(e.line, e.pos, e.len)
            }
            e.menu_active = 0
            draw(e, prompt)
            continue
        }
        if k == 11 {
            ed_kill_to_end(e)
            e.menu_active = 0
            draw(e, prompt)
            continue
        }
        if k == 21 {
            replace_range(e, 0, e.pos, c"")
            e.menu_active = 0
            draw(e, prompt)
            continue
        }
        if k == 23 {
            ed_kill_word(e)
            e.menu_active = 0
            draw(e, prompt)
            continue
        }
        if k == 12 {
            write_s(c"\x1b[2J\x1b[H")
            e.first_draw = 1
            e.menu_active = 0
            draw(e, prompt)
            continue
        }
        if k == 16 {
            history_recall(e, true)
            draw(e, prompt)
            continue
        }
        if k == 14 {
            history_recall(e, false)
            draw(e, prompt)
            continue
        }
        if k == 18 {
            if e.search_active == 0 {
                e.search_orig = u.s_dup(e.line)
                e.search_query = u.s_dup(c"")
                e.search_index = e.hist.items.len - 1
                e.search_active = 1
                e.menu_active = 0
            }
            draw(e, prompt)
            continue
        }
        if k == 9 {
            if e.menu_active == 1 {
                menu_next(e, 1)
            } else {
                open_completion(e)
            }
            draw(e, prompt)
            continue
        }
        if k == 27 {
            if e.menu_active == 1 {
                e.menu_active = 0
                ed_set(e, e.menu_base)
                e.pos = e.menu_end
                draw(e, prompt)
                continue
            }
            read_escape(e)
            draw(e, prompt)
            continue
        }
        if k == 127 || k == 8 {
            e.menu_active = 0
            ed_backspace(e)
            draw(e, prompt)
            continue
        }
        if k >= 32 && k < 127 {
            e.menu_active = 0
            e.hist_index = e.hist.items.len
            ed_insert_byte(e, k as u8)
            draw(e, prompt)
            continue
        }
        if k >= 128 {
            e.menu_active = 0
            ed_insert_byte(e, k as u8)
            draw(e, prompt)
            continue
        }
    }
    return none
}

/// Read one line from a non-interactive stdin (no prompts, no editing).
pub fn read_plain() ref u8 = trust {
    val b: mut ref u.Buf = u.buf_new()
    for {
        val k: i32 = read_key()
        if k < 0 {
            if b.len == 0 {
                return none
            }
            break
        }
        if k == 10 {
            break
        }
        if k == 13 {
            continue
        }
        val c: u8 = k as u8
        u.buf_ch(b, c)
    }
    return u.buf_take(b)
}
