/// INI configuration for Blood.
///
/// Loaded from `$XDG_CONFIG_HOME/blood/blood.ini`, or
/// `~/.config/blood/blood.ini` when XDG_CONFIG_HOME is unset.

val u = use("util.sx")

pub type Config = {
    path: mut ref u8
    theme: mut ref u8

    show_username: mut i64
    show_hostname: mut i64
    show_directory: mut i64
    show_git: mut i64
    show_time: mut i64
    show_exit_status: mut i64
    show_duration: mut i64
    show_jobs: mut i64
    show_mode: mut i64
    two_line: mut i64
    directory_style: mut ref u8
    prompt_symbol: mut ref u8
    prompt_char: mut ref u8
    separator: mut ref u8

    color_primary: mut ref u8
    color_secondary: mut ref u8
    color_success: mut ref u8
    color_error: mut ref u8
    color_directory: mut ref u8
    color_git_clean: mut ref u8
    color_git_dirty: mut ref u8
    color_muted: mut ref u8
    color_warning: mut ref u8
    color_accent: mut ref u8

    history_enabled: mut i64
    history_file: mut ref u8
    history_max: mut i64
    history_ignore_dups: mut i64

    completion_enabled: mut i64
    completion_case_sensitive: mut i64
    completion_history_suggestions: mut i64

    shell_editor: mut ref u8
    login_message: mut i64
    login: mut i64
    startup_file: mut ref u8

    alias_defs: mut ref u.Vec
    env_defs: mut ref u.Vec
}

fn bool_key(key: ref u8) bool = trust {
    if u.s_eq(
        key,
        c"show_username"
    ) || u.s_eq(
        key,
        c"show_hostname"
    ) || u.s_eq(
        key,
        c"show_directory"
    ) || u.s_eq(
        key,
        c"show_git"
    ) || u.s_eq(
        key,
        c"show_time"
    ) || u.s_eq(
        key,
        c"show_exit_status"
    ) || u.s_eq(
        key,
        c"show_duration"
    ) || u.s_eq(
        key,
        c"show_jobs"
    ) || u.s_eq(
        key,
        c"show_mode"
    ) || u.s_eq(
        key,
        c"two_line"
    ) || u.s_eq(
        key,
        c"enabled"
    ) || u.s_eq(
        key,
        c"ignore_duplicates"
    ) || u.s_eq(
        key,
        c"case_sensitive"
    ) || u.s_eq(
        key,
        c"history_suggestions"
    ) || u.s_eq(
        key,
        c"autosuggestions"
    ) || u.s_eq(
        key,
        c"login_message"
    ) || u.s_eq(key, c"login") || u.s_eq(key, c"git_status") {
        return true
    }
    return false
}

fn cfg_bool(v: ref u8) i64 = trust {
    if u.s_eq(v, c"true") || u.s_eq(v, c"yes") || u.s_eq(v, c"on") || u.s_eq(v, c"1") {
        return 1
    }
    if u.s_eq(v, c"false") || u.s_eq(v, c"no") || u.s_eq(v, c"off") || u.s_eq(v, c"0") {
        return 0
    }
    u.stderr_s(u.s_cat3(c"blood: config: invalid boolean '", v, c"'\n"))
    return 0
}

fn color_ansi(name: ref u8) ref u8 = trust {
    if name == none {
        return c""
    }
    if u.s_eq(name, c"default") {
        return c"\x1b[39m"
    }
    if u.s_eq(name, c"black") {
        return c"\x1b[30m"
    }
    if u.s_eq(name, c"red") {
        return c"\x1b[31m"
    }
    if u.s_eq(name, c"green") {
        return c"\x1b[32m"
    }
    if u.s_eq(name, c"yellow") {
        return c"\x1b[33m"
    }
    if u.s_eq(name, c"blue") {
        return c"\x1b[34m"
    }
    if u.s_eq(name, c"magenta") {
        return c"\x1b[35m"
    }
    if u.s_eq(name, c"cyan") {
        return c"\x1b[36m"
    }
    if u.s_eq(name, c"white") {
        return c"\x1b[37m"
    }
    if u.s_eq(name, c"bright_black") || u.s_eq(name, c"gray") || u.s_eq(name, c"grey") {
        return c"\x1b[90m"
    }
    if u.s_eq(name, c"bright_red") {
        return c"\x1b[91m"
    }
    if u.s_eq(name, c"bright_green") {
        return c"\x1b[92m"
    }
    if u.s_eq(name, c"bright_yellow") {
        return c"\x1b[93m"
    }
    if u.s_eq(name, c"bright_blue") {
        return c"\x1b[94m"
    }
    if u.s_eq(name, c"bright_magenta") {
        return c"\x1b[95m"
    }
    if u.s_eq(name, c"bright_cyan") {
        return c"\x1b[96m"
    }
    if u.s_eq(name, c"bright_white") {
        return c"\x1b[97m"
    }
    if u.s_len(name) > 0 && @load8(name) == 35 {
        val hex: ref u8 = @ptradd(name, 1)
        val r: i64 = parse_hex2(hex, 0)
        val g: i64 = parse_hex2(hex, 2)
        val b: i64 = parse_hex2(hex, 4)
        return u.s_format_perm(c"\x1b[38;2;{d};{d};{d}m", {r as i64, g as i64, b as i64})
    }
    val n: i64 = u.s_len(name)
    val i: mut i64 = 0
    val all_digits: mut bool = n > 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(name, i))
        if c < 48 || c > 57 {
            all_digits = false
            break
        }
        i++
    }
    if all_digits {
        match u.parse_int(name) {
            some idx => {
                return u.s_format_perm(c"\x1b[38;5;{d}m", {idx})
            }
            none => {
                return c""
            }
        }
    }
    return c""
}

fn parse_hex2(s: ref u8, off: i64) i64 = trust {
    if u.s_len(s) < off + 2 {
        return 0
    }
    val a: u8 = @load8(@ptradd(s, off))
    val b: u8 = @load8(@ptradd(s, off + 1))
    return (hexval(a) * 16 + hexval(b)) as i64
}

fn hexval(c: u8) i64 = trust {
    if c >= 48 && c <= 57 {
        return (c - 48) as i64
    }
    if c >= 97 && c <= 102 {
        return (c - 87) as i64
    }
    if c >= 65 && c <= 70 {
        return (c - 55) as i64
    }
    return 0
}

pub fn config_path() ref u8 = trust {
    val xdg: ref u8 = u.env_get(c"XDG_CONFIG_HOME")
    if xdg != none && u.s_len(xdg) > 0 {
        return u.path_join(u.path_join(xdg, c"blood"), c"blood.ini")
    }
    return u.path_join(u.path_join(u.home_dir(), c".config/blood"), c"blood.ini")
}

pub fn default_config() ref Config = trust {
    val c: mut ref Config = u.xalloc_perm(@sizeof(Config) as i64) as ref Config
    c.path = u.s_dup_perm(config_path())
    c.theme = c"default"
    c.show_username = 1
    c.show_hostname = 1
    c.show_directory = 1
    c.show_git = 1
    c.show_time = 0
    c.show_exit_status = 1
    c.show_duration = 1
    c.show_jobs = 1
    c.show_mode = 0
    c.two_line = 1
    c.directory_style = c"full"
    c.prompt_symbol = c"❯"
    c.prompt_char = c"❯"
    c.separator = c"─"
    c.color_primary = c"\x1b[38;5;124m"
    c.color_secondary = c"\x1b[38;5;88m"
    c.color_success = c"\x1b[32m"
    c.color_error = c"\x1b[31m"
    c.color_directory = c"\x1b[38;5;88m"
    c.color_git_clean = c"\x1b[32m"
    c.color_git_dirty = c"\x1b[38;5;88m"
    c.color_muted = c"\x1b[90m"
    c.color_warning = c"\x1b[33m"
    c.color_accent = c"\x1b[96m"
    c.history_enabled = 1
    c.history_file = u.s_dup_perm(u.path_join(
            u.path_join(u.home_dir(), c".local/share/blood"),
            c"history"
        ))
    c.history_max = 10000
    c.history_ignore_dups = 1
    c.completion_enabled = 1
    c.completion_case_sensitive = 0
    c.completion_history_suggestions = 0
    c.shell_editor = c"nano"
    c.login_message = 1
    c.login = 0
    c.startup_file = c""
    c.alias_defs = u.vec_new_perm()
    c.env_defs = u.vec_new_perm()
    return c
}

fn set_bool_field(c: mut ref Config, section: ref u8, key: ref u8, value: ref u8) void = trust {
    if !bool_key(key) {
        return
    }
    val b: i64 = cfg_bool(value)
    if u.s_eq(key, c"show_username") {
        c.show_username = b
    } elif u.s_eq(key, c"show_hostname") {
        c.show_hostname = b
    } elif u.s_eq(key, c"show_directory") {
        c.show_directory = b
    } elif u.s_eq(key, c"show_git") {
        c.show_git = b
    } elif u.s_eq(key, c"show_time") {
        c.show_time = b
    } elif u.s_eq(key, c"show_exit_status") {
        c.show_exit_status = b
    } elif u.s_eq(key, c"show_duration") {
        c.show_duration = b
    } elif u.s_eq(key, c"show_jobs") {
        c.show_jobs = b
    } elif u.s_eq(key, c"show_mode") {
        c.show_mode = b
    } elif u.s_eq(key, c"two_line") {
        c.two_line = b
    } elif u.s_eq(key, c"enabled") {
        if u.s_eq(section, c"completion") {
            c.completion_enabled = b
        } else {
            c.history_enabled = b
        }
    } elif u.s_eq(key, c"ignore_duplicates") {
        c.history_ignore_dups = b
    } elif u.s_eq(key, c"case_sensitive") {
        c.completion_case_sensitive = b
    } elif u.s_eq(key, c"history_suggestions") || u.s_eq(key, c"autosuggestions") {
        c.completion_history_suggestions = b
    } elif u.s_eq(key, c"login_message") {
        c.login_message = b
    } elif u.s_eq(key, c"login") {
        c.login = b
    } elif u.s_eq(key, c"git_status") {
        c.show_git = b
    }
}

fn set_string_field(c: mut ref Config, key: ref u8, value: ref u8) void = trust {
    if u.s_eq(key, c"theme") {
        c.theme = u.s_dup_perm(value)
    } elif u.s_eq(key, c"symbol") {
        c.prompt_symbol = u.s_dup_perm(value)
        c.prompt_char = u.s_dup_perm(value)
    } elif u.s_eq(key, c"prompt_symbol") {
        c.prompt_symbol = u.s_dup_perm(value)
        c.prompt_char = u.s_dup_perm(value)
    } elif u.s_eq(key, c"prompt_char") {
        c.prompt_char = u.s_dup_perm(value)
    } elif u.s_eq(key, c"separator") {
        c.separator = u.s_dup_perm(value)
    } elif u.s_eq(key, c"directory_style") {
        c.directory_style = u.s_dup_perm(value)
    } elif u.s_eq(key, c"file") {
        c.history_file = u.s_dup_perm(u.expand_tilde(value))
    } elif u.s_eq(key, c"history_file") {
        c.history_file = u.s_dup_perm(u.expand_tilde(value))
    } elif u.s_eq(key, c"default_editor") || u.s_eq(key, c"editor") {
        c.shell_editor = u.s_dup_perm(value)
    } elif u.s_eq(key, c"startup_file") {
        c.startup_file = u.s_dup_perm(u.expand_tilde(value))
    } elif u.s_eq(key, c"primary") {
        c.color_primary = color_ansi(value)
    } elif u.s_eq(key, c"secondary") {
        c.color_secondary = color_ansi(value)
    } elif u.s_eq(key, c"success") {
        c.color_success = color_ansi(value)
    } elif u.s_eq(key, c"error") {
        c.color_error = color_ansi(value)
    } elif u.s_eq(key, c"directory") {
        c.color_directory = color_ansi(value)
    } elif u.s_eq(key, c"git_clean") {
        c.color_git_clean = color_ansi(value)
    } elif u.s_eq(key, c"git_dirty") {
        c.color_git_dirty = color_ansi(value)
    } elif u.s_eq(key, c"muted") {
        c.color_muted = color_ansi(value)
    } elif u.s_eq(key, c"warning") {
        c.color_warning = color_ansi(value)
    } elif u.s_eq(key, c"accent") {
        c.color_accent = color_ansi(value)
    }
}

fn set_int_field(c: mut ref Config, key: ref u8, value: ref u8) void = trust {
    if !(u.s_eq(key, c"max_entries") || u.s_eq(key, c"history_max")) {
        return
    }
    match u.parse_int(value) {
        some n => {
            c.history_max = n
        }
        none => {
            u.stderr_s(u.s_cat3(c"blood: config: invalid integer for ", key, c"\n"))
        }
    }
}

fn apply(c: mut ref Config, section: ref u8, key: ref u8, value: ref u8) void = trust {
    if u.s_eq(section, c"aliases") {
        u.vec_pushp(c.alias_defs, u.s_cat3_perm(key, c"=", value) as ref void)
        return
    }
    if u.s_eq(section, c"env") {
        u.vec_pushp(c.env_defs, u.s_cat3_perm(key, c"=", value) as ref void)
        return
    }
    set_bool_field(c, section, key, value)
    set_string_field(c, key, value)
    set_int_field(c, key, value)
}

pub fn known_key(section: ref u8, key: ref u8) bool = trust {
    if u.s_eq(section, c"prompt") {
        if u.s_eq(
            key,
            c"show_username"
        ) || u.s_eq(
            key,
            c"show_hostname"
        ) || u.s_eq(
            key,
            c"show_directory"
        ) || u.s_eq(
            key,
            c"show_git"
        ) || u.s_eq(
            key,
            c"show_time"
        ) || u.s_eq(
            key,
            c"show_exit_status"
        ) || u.s_eq(
            key,
            c"show_duration"
        ) || u.s_eq(
            key,
            c"show_jobs"
        ) || u.s_eq(key, c"show_mode") || u.s_eq(key, c"two_line") || u.s_eq(key, c"git_status") {
            return true
        }
        return u.s_eq(
            key,
            c"theme"
        ) || u.s_eq(
            key,
            c"symbol"
        ) || u.s_eq(
            key,
            c"prompt_symbol"
        ) || u.s_eq(
            key,
            c"prompt_char"
        ) || u.s_eq(key, c"separator") || u.s_eq(key, c"directory_style")
    }
    if u.s_eq(section, c"colors") {
        return u.s_eq(
            key,
            c"primary"
        ) || u.s_eq(
            key,
            c"secondary"
        ) || u.s_eq(
            key,
            c"success"
        ) || u.s_eq(
            key,
            c"error"
        ) || u.s_eq(
            key,
            c"directory"
        ) || u.s_eq(
            key,
            c"git_clean"
        ) || u.s_eq(
            key,
            c"git_dirty"
        ) || u.s_eq(key, c"muted") || u.s_eq(key, c"warning") || u.s_eq(key, c"accent")
    }
    if u.s_eq(section, c"history") {
        return u.s_eq(
            key,
            c"enabled"
        ) || u.s_eq(
            key,
            c"file"
        ) || u.s_eq(
            key,
            c"history_file"
        ) || u.s_eq(
            key,
            c"max_entries"
        ) || u.s_eq(key, c"history_max") || u.s_eq(key, c"ignore_duplicates")
    }
    if u.s_eq(section, c"completion") {
        return u.s_eq(
            key,
            c"enabled"
        ) || u.s_eq(
            key,
            c"case_sensitive"
        ) || u.s_eq(key, c"history_suggestions") || u.s_eq(key, c"autosuggestions")
    }
    if u.s_eq(section, c"shell") {
        return u.s_eq(
            key,
            c"default_editor"
        ) || u.s_eq(
            key,
            c"editor"
        ) || u.s_eq(
            key,
            c"login_message"
        ) || u.s_eq(key, c"login") || u.s_eq(key, c"startup_file")
    }
    return false
}

fn bool_value(v: ref u8) bool = trust {
    return u.s_eq(
        v,
        c"true"
    ) || u.s_eq(
        v,
        c"yes"
    ) || u.s_eq(
        v,
        c"on"
    ) || u.s_eq(
        v,
        c"1"
    ) || u.s_eq(v, c"false") || u.s_eq(v, c"no") || u.s_eq(v, c"off") || u.s_eq(v, c"0")
}

fn needs_bool(section: ref u8, key: ref u8) bool = trust {
    if u.s_eq(section, c"prompt") {
        return u.s_eq(
            key,
            c"show_username"
        ) || u.s_eq(
            key,
            c"show_hostname"
        ) || u.s_eq(
            key,
            c"show_directory"
        ) || u.s_eq(
            key,
            c"show_git"
        ) || u.s_eq(
            key,
            c"show_time"
        ) || u.s_eq(
            key,
            c"show_exit_status"
        ) || u.s_eq(
            key,
            c"show_duration"
        ) || u.s_eq(
            key,
            c"show_jobs"
        ) || u.s_eq(key, c"show_mode") || u.s_eq(key, c"two_line") || u.s_eq(key, c"git_status")
    }
    if u.s_eq(section, c"history") {
        return u.s_eq(key, c"enabled") || u.s_eq(key, c"ignore_duplicates")
    }
    if u.s_eq(section, c"completion") {
        return u.s_eq(
            key,
            c"enabled"
        ) || u.s_eq(
            key,
            c"case_sensitive"
        ) || u.s_eq(key, c"history_suggestions") || u.s_eq(key, c"autosuggestions")
    }
    if u.s_eq(section, c"shell") {
        return u.s_eq(key, c"login_message") || u.s_eq(key, c"login")
    }
    return false
}

fn needs_int(section: ref u8, key: ref u8) bool = trust {
    return u.s_eq(
        section,
        c"history"
    ) && (u.s_eq(key, c"max_entries") || u.s_eq(key, c"history_max"))
}

pub fn set_value(c: mut ref Config, section: ref u8, key: ref u8, value: ref u8) bool = trust {
    if !known_key(section, key) {
        return false
    }
    if needs_bool(section, key) && !bool_value(value) {
        return false
    }
    if needs_int(section, key) {
        match u.parse_int(value) {
            some _ => {}
            none => {
                return false
            }
        }
    }
    apply(c, section, key, value)
    return true
}

pub fn possible_values(section: ref u8, key: ref u8) ref u8 = trust {
    if u.s_eq(section, c"prompt") {
        if u.s_eq(key, c"theme") {
            return c"default, plain, lambda, powerline, right (right1, right_aligned), right_time (right2, right_aligned_time), hacker, dots, compact (compact_path), iconified (icons), timestamped (timestamp), doubleline (double)"
        }
        if u.s_eq(key, c"directory_style") {
            return c"full, short, basename"
        }
    }
    if needs_bool(section, key) {
        return c"true (yes, on, 1), false (no, off, 0)"
    }
    if u.s_eq(section, c"colors") {
        return c"default, black, red, green, yellow, blue, magenta, cyan, white, bright_black (gray, grey), bright_red, bright_green, bright_yellow, bright_blue, bright_magenta, bright_cyan, bright_white, 0-255, #RRGGBB"
    }
    return c""
}

fn bool_text(v: i64) ref u8 = trust {
    if v != 0 {
        return c"true"
    }
    return c"false"
}

fn color_name(color: ref u8) ref u8 = trust {
    val n: i64 = u.s_len(color)
    if n == 0 || u.s_eq(color, c"\x1b[39m") {
        return c"default"
    }
    if u.s_eq(color, c"\x1b[30m") {
        return c"black"
    }
    if u.s_eq(color, c"\x1b[31m") {
        return c"red"
    }
    if u.s_eq(color, c"\x1b[32m") {
        return c"green"
    }
    if u.s_eq(color, c"\x1b[33m") {
        return c"yellow"
    }
    if u.s_eq(color, c"\x1b[34m") {
        return c"blue"
    }
    if u.s_eq(color, c"\x1b[35m") {
        return c"magenta"
    }
    if u.s_eq(color, c"\x1b[36m") {
        return c"cyan"
    }
    if u.s_eq(color, c"\x1b[37m") {
        return c"white"
    }
    if u.s_eq(color, c"\x1b[90m") {
        return c"bright_black"
    }
    if u.s_eq(color, c"\x1b[91m") {
        return c"bright_red"
    }
    if u.s_eq(color, c"\x1b[92m") {
        return c"bright_green"
    }
    if u.s_eq(color, c"\x1b[93m") {
        return c"bright_yellow"
    }
    if u.s_eq(color, c"\x1b[94m") {
        return c"bright_blue"
    }
    if u.s_eq(color, c"\x1b[95m") {
        return c"bright_magenta"
    }
    if u.s_eq(color, c"\x1b[96m") {
        return c"bright_cyan"
    }
    if u.s_eq(color, c"\x1b[97m") {
        return c"bright_white"
    }
    if n > 7 && u.s_starts(color, c"\x1b[38;5;") {
        return u.s_cat(c"256:", u.s_substr(color, 7, n - 1))
    }
    return c"custom"
}

pub fn current_value(c: ref Config, section: ref u8, key: ref u8) ref u8 = trust {
    if u.s_eq(section, c"prompt") {
        if u.s_eq(key, c"theme") {
            return c.theme
        }
        if u.s_eq(key, c"directory_style") {
            return c.directory_style
        }
        if u.s_eq(key, c"symbol") || u.s_eq(key, c"prompt_symbol") {
            return c.prompt_symbol
        }
        if u.s_eq(key, c"prompt_char") {
            return c.prompt_char
        }
        if u.s_eq(key, c"separator") {
            return c.separator
        }
        if u.s_eq(key, c"show_username") {
            return bool_text(c.show_username)
        }
        if u.s_eq(key, c"show_hostname") {
            return bool_text(c.show_hostname)
        }
        if u.s_eq(key, c"show_directory") {
            return bool_text(c.show_directory)
        }
        if u.s_eq(key, c"show_git") || u.s_eq(key, c"git_status") {
            return bool_text(c.show_git)
        }
        if u.s_eq(key, c"show_time") {
            return bool_text(c.show_time)
        }
        if u.s_eq(key, c"show_exit_status") {
            return bool_text(c.show_exit_status)
        }
        if u.s_eq(key, c"show_duration") {
            return bool_text(c.show_duration)
        }
        if u.s_eq(key, c"show_jobs") {
            return bool_text(c.show_jobs)
        }
        if u.s_eq(key, c"show_mode") {
            return bool_text(c.show_mode)
        }
        if u.s_eq(key, c"two_line") {
            return bool_text(c.two_line)
        }
    }
    if u.s_eq(section, c"colors") {
        if u.s_eq(key, c"primary") {
            return color_name(c.color_primary)
        }
        if u.s_eq(key, c"secondary") {
            return color_name(c.color_secondary)
        }
        if u.s_eq(key, c"success") {
            return color_name(c.color_success)
        }
        if u.s_eq(key, c"error") {
            return color_name(c.color_error)
        }
        if u.s_eq(key, c"directory") {
            return color_name(c.color_directory)
        }
        if u.s_eq(key, c"git_clean") {
            return color_name(c.color_git_clean)
        }
        if u.s_eq(key, c"git_dirty") {
            return color_name(c.color_git_dirty)
        }
        if u.s_eq(key, c"muted") {
            return color_name(c.color_muted)
        }
        if u.s_eq(key, c"warning") {
            return color_name(c.color_warning)
        }
        if u.s_eq(key, c"accent") {
            return color_name(c.color_accent)
        }
    }
    if u.s_eq(section, c"history") {
        if u.s_eq(key, c"enabled") {
            return bool_text(c.history_enabled)
        }
        if u.s_eq(key, c"file") || u.s_eq(key, c"history_file") {
            return c.history_file
        }
        if u.s_eq(key, c"max_entries") || u.s_eq(key, c"history_max") {
            return u.s_int(c.history_max)
        }
        if u.s_eq(key, c"ignore_duplicates") {
            return bool_text(c.history_ignore_dups)
        }
    }
    if u.s_eq(section, c"completion") {
        if u.s_eq(key, c"enabled") {
            return bool_text(c.completion_enabled)
        }
        if u.s_eq(key, c"case_sensitive") {
            return bool_text(c.completion_case_sensitive)
        }
        if u.s_eq(key, c"history_suggestions") || u.s_eq(key, c"autosuggestions") {
            return bool_text(c.completion_history_suggestions)
        }
    }
    if u.s_eq(section, c"shell") {
        if u.s_eq(key, c"default_editor") || u.s_eq(key, c"editor") {
            return c.shell_editor
        }
        if u.s_eq(key, c"login_message") {
            return bool_text(c.login_message)
        }
        if u.s_eq(key, c"login") {
            return bool_text(c.login)
        }
        if u.s_eq(key, c"startup_file") {
            return c.startup_file
        }
    }
    return c""
}

pub fn bloodrc_path(c: ref Config) ref u8 = trust {
    return u.path_join(u.path_dir(c.path), c".bloodrc")
}

pub fn init_bloodrc(c: ref Config) bool = trust {
    val path: ref u8 = bloodrc_path(c)
    if u.file_exists(path) {
        return true
    }
    u.mkdir_p(u.path_dir(path))
    val text: ref u8 = c"# Blood startup file.\n# Run at the start of every interactive session.\n\n# Aliases:\n# alias ll='ls -l'\n# alias gs='git status'\n\nfn prelude() {\n    # Session setup goes here.\n}\n\nprelude()\n"
    return u.write_file(path, text)
}

pub fn reload_into(c: mut ref Config) void = trust {
    val d: ref Config = load_config_from(c.path)
    c.path = d.path
    c.theme = d.theme
    c.show_username = d.show_username
    c.show_hostname = d.show_hostname
    c.show_directory = d.show_directory
    c.show_git = d.show_git
    c.show_time = d.show_time
    c.show_exit_status = d.show_exit_status
    c.show_duration = d.show_duration
    c.show_jobs = d.show_jobs
    c.show_mode = d.show_mode
    c.two_line = d.two_line
    c.directory_style = d.directory_style
    c.prompt_symbol = d.prompt_symbol
    c.prompt_char = d.prompt_char
    c.separator = d.separator
    c.color_primary = d.color_primary
    c.color_secondary = d.color_secondary
    c.color_success = d.color_success
    c.color_error = d.color_error
    c.color_directory = d.color_directory
    c.color_git_clean = d.color_git_clean
    c.color_git_dirty = d.color_git_dirty
    c.color_muted = d.color_muted
    c.color_warning = d.color_warning
    c.color_accent = d.color_accent
    c.history_enabled = d.history_enabled
    c.history_file = d.history_file
    c.history_max = d.history_max
    c.history_ignore_dups = d.history_ignore_dups
    c.completion_enabled = d.completion_enabled
    c.completion_case_sensitive = d.completion_case_sensitive
    c.completion_history_suggestions = d.completion_history_suggestions
    c.shell_editor = d.shell_editor
    c.login_message = d.login_message
    c.login = d.login
    c.startup_file = d.startup_file
    c.alias_defs = d.alias_defs
    c.env_defs = d.env_defs
}

pub fn persist_value(path: ref u8, section: ref u8, key: ref u8, value: ref u8) bool = trust {
    val data: ref u8 = u.read_file(path)
    val out: mut ref u.Buf = u.buf_new()
    val cursec: mut ref u8 = u.s_dup(c"prompt")
    val found_section: mut i64 = 0
    val have_section: mut i64 = 0
    val wrote: mut i64 = 0
    if data != none {
        val n: i64 = u.s_len(data)
        val start: mut i64 = 0
        val i: mut i64 = 0
        for {
            if i > n {
                break
            }
            if i == n || @load8(@ptradd(data, i)) == 10 {
                if i == n && start == n {
                    break
                }
                val line: ref u8 = u.s_substr(data, start, i)
                val t: ref u8 = u.s_trim(line)
                if u.s_len(t) > 0 && @load8(t) == 91 {
                    if wrote == 0 && have_section == 1 && u.s_eq(cursec, section) {
                        u.buf_add(out, key)
                        u.buf_add(out, c" = ")
                        u.buf_add(out, value)
                        u.buf_ch(out, 10)
                        wrote = 1
                    }
                    val close: i64 = u.s_index_of_char(t, 93, 0)
                    if close > 0 {
                        cursec = u.s_substr(t, 1, close)
                    }
                    have_section = 1
                    if u.s_eq(cursec, section) {
                        found_section = 1
                    }
                    u.buf_add(out, line)
                    u.buf_ch(out, 10)
                } else {
                    val eq: i64 = u.s_index_of_char(t, 61, 0)
                    if u.s_eq(cursec, section) && eq > 0 {
                        found_section = 1
                        if wrote == 0 && u.s_eq(u.s_trim(u.s_substr(t, 0, eq)), key) {
                            u.buf_add(out, key)
                            u.buf_add(out, c" = ")
                            u.buf_add(out, value)
                            u.buf_ch(out, 10)
                            wrote = 1
                        } else {
                            u.buf_add(out, line)
                            u.buf_ch(out, 10)
                        }
                    } else {
                        u.buf_add(out, line)
                        u.buf_ch(out, 10)
                    }
                }
                start = i + 1
            }
            i++
        }
    }
    if wrote == 0 {
        if found_section == 0 {
            if out.len > 0 {
                u.buf_ch(out, 10)
            }
            u.buf_ch(out, 91)
            u.buf_add(out, section)
            u.buf_ch(out, 93)
            u.buf_ch(out, 10)
        }
        u.buf_add(out, key)
        u.buf_add(out, c" = ")
        u.buf_add(out, value)
        u.buf_ch(out, 10)
    }
    u.mkdir_p(u.path_dir(path))
    return u.write_file(path, u.buf_take(out))
}

pub fn load_config() ref Config = trust {
    return load_config_from(config_path())
}

pub fn load_config_from(path: ref u8) ref Config = trust {
    val c: mut ref Config = default_config()
    c.path = u.s_dup_perm(path)
    val data: ref u8 = u.read_file(c.path)
    if data == none {
        return c
    }
    val section: mut ref u8 = u.s_dup(c"prompt")
    val line: mut ref u8 = u.s_dup(c"")
    val lineno: mut i64 = 1
    val i: mut i64 = 0
    val n: i64 = u.s_len(data)
    for {
        if i > n {
            break
        }
        if i == n || @load8(@ptradd(data, i)) == 10 {
            val piece: ref u8 = u.s_ndup(line, u.s_len(line))
            val t: ref u8 = u.s_trim(piece)
            if u.s_len(t) > 0 && @load8(t) != 35 && @load8(t) != 59 {
                if @load8(t) == 91 {
                    val close: i64 = u.s_index_of_char(t, 93, 0)
                    if close > 0 {
                        section = u.s_substr(t, 1, close)
                    }
                } else {
                    val eq: i64 = u.s_index_of_char(t, 61, 0)
                    if eq > 0 {
                        val key: ref u8 = u.s_trim(u.s_substr(t, 0, eq))
                        val value: ref u8 = u.s_trim(u.s_substr(t, eq + 1, u.s_len(t)))
                        val vv: ref u8 = strip_quotes(value)
                        apply(c, section, key, vv)
                    } else {
                        u.stderr_s(u.s_cat3(c"blood: config: ", c.path, c"\n"))
                        u.stderr_s(u.s_cat3(
                                c"  line ",
                                u.s_int(lineno),
                                c": expected key = value\n"
                            ))
                    }
                }
            }
            line = u.s_dup(c"")
            lineno++
        } else {
            val ch: u8 = @load8(@ptradd(data, i))
            if ch != 13 {
                val cbuf: mut u8 = ch
                line = u.s_cat(line, u.s_ndup(@addr(cbuf), 1))
            }
        }
        i++
    }
    if c.history_max < 0 {
        c.history_max = 0
    }
    return c
}

fn strip_quotes(v: ref u8) ref u8 = trust {
    val n: i64 = u.s_len(v)
    if n >= 2 {
        val a: u8 = @load8(v)
        val b: u8 = @load8(@ptradd(v, n - 1))
        if (a == 34 && b == 34) || (a == 39 && b == 39) {
            return u.s_substr(v, 1, n - 1)
        }
    }
    return v
}

pub fn init_config_file(path: ref u8) bool = trust {
    val dir: ref u8 = u.path_dir(path)
    u.mkdir_p(dir)
    if u.file_exists(path) {
        return true
    }
    val text: ref u8 = c"# Blood shell configuration\n# See `blood help config` for the available keys.\n# Startup file: .bloodrc (aliases and prelude).\n# Prompt themes: default, plain, lambda, powerline, right, right_time,\n# hacker, dots, compact, iconified, timestamped, doubleline.\n\n[prompt]\ntheme = default\nshow_username = true\nshow_hostname = true\nshow_directory = true\nshow_git = true\nshow_time = false\nshow_exit_status = true\nshow_duration = true\ntwo_line = true\n\n[colors]\nprimary = red\nsecondary = red\nsuccess = green\nerror = red\ndirectory = blue\ngit_clean = green\ngit_dirty = yellow\nmuted = white\n\n[history]\nenabled = true\nfile = ~/.local/share/blood/history\nmax_entries = 10000\nignore_duplicates = true\n\n[completion]\nenabled = true\ncase_sensitive = false\nhistory_suggestions = false\n\n[shell]\ndefault_editor = nano\nlogin_message = true\nlogin = false\n"
    return u.write_file(path, text)
}
