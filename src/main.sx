/// Blood — an interactive shell and small brace-delimited scripting language.

val u        = use("util.sx")
val cfgmod   = use("config.sx")
val histmod  = use("history.sx")
val prompt   = use("prompt.sx")
val term     = use("terminal.sx")
val ex       = use("exec.sx")
val shell    = use("shell.sx")
val script   = use("script.sx")
val escape   = use("escape.sx")
val loginmod = use("login.sx")
val flags    = use("std/flags")
val env      = use("std/env")

val VERSION: ref u8 = c"0.1.0"

fn arg_at(av: list[ref u8], i: i64) ref u8 = trust {
    val n: i64 = @len(av) as i64
    if i < 0 || i >= n {
        return none
    }
    match @get(av, i as usize) {
        some p => {
            return p
        }
        none => {
            return none
        }
    }
}

fn on_interrupt(sig: i32) void = trust {
    if sig == -1 {
        return
    }
    u.interrupt_flag = 1
}

/// A login shell is traditionally invoked with argv[0] prefixed by '-'.
fn login_argv(av: list[ref u8]) bool = trust {
    val prog: ref u8 = arg_at(av, 0)
    if prog == none || u.s_len(prog) == 0 {
        return false
    }
    val base: ref u8 = u.path_base(prog)
    if u.s_len(base) == 0 {
        return false
    }
    return @load8(base) == 45
}

fn install_hooks() void = trust {
    u.run_shell_hook = shell.run_line
    u.run_capture_hook = shell.capture_text
    u.run_script_file_hook = script.run_file
    u.hooks_ready = 1
}

fn print_version() void = trust {
    u.stdout_ln(u.s_cat4(c"blood ", env.get(c"SPECTRE_MOD_VERSION"), c" ", env.get(c"GIT_HASH")))
}

fn print_help() void = trust {
    val text: ref u8 = c"usage: blood [options] [script.blood|script.bx [args...]]\n\noptions:\n  -c COMMAND       execute a command or script and exit\n  -init            write a default configuration file\n  -login           initialize a login-shell environment\n  -version, -v     print the version\n  -help, -h        show this help\n\nenvironment:\n  XDG_CONFIG_HOME  config root (default ~/.config)\n\nconfiguration:\n  ~/.config/blood/blood.ini\n\ninteractive help:\n  help             builtins and key bindings\n  help config      configuration keys\n  help script      the scripting language\n"
    u.write_fd(1, text)
}

fn list_to_vec(src: list[ref u8], start: i64) ref u.Vec = trust {
    val out: mut ref u.Vec = u.vec_new()
    val n: i64 = @len(src) as i64
    val i: mut i64 = start
    for {
        if i >= n {
            break
        }
        if @get(src, i as usize) is some p {
            u.vec_pushp(out, p as ref void)
        }
        i++
    }
    return out
}

fn vec_slice(src: ref u.Vec, start: i64) ref u.Vec = trust {
    val out: mut ref u.Vec = u.vec_new()
    val i: mut i64 = start
    for {
        if i >= src.len {
            break
        }
        u.vec_pushp(out, u.vec_p(src, i))
        i++
    }
    return out
}

fn ensure_config_dirs(c: ref cfgmod.Config) void = trust {
    u.mkdir_p(u.path_dir(c.path))
    u.mkdir_p(u.path_dir(c.history_file))
}

fn banner(c: ref cfgmod.Config) void = trust {
    if c.login_message == 0 {
        return
    }
    val b: mut ref u.Buf = u.buf_new()
    u.buf_add(b, c"\x1b[0m")
    u.buf_add(b, c.color_primary)
    u.buf_add(b, c"╭─ ")
    u.buf_add(b, c"blood ")
    u.buf_add(b, VERSION)
    u.buf_add(b, c"\x1b[0m")
    u.buf_add(b, c.color_muted)
    u.buf_add(b, c" — type ")
    u.buf_add(b, c"\x1b[0m")
    u.buf_add(b, c.color_accent)
    u.buf_add(b, c"help")
    u.buf_add(b, c"\x1b[0m")
    u.buf_add(b, c.color_muted)
    u.buf_add(b, c" for commands, ")
    u.buf_add(b, c"\x1b[0m")
    u.buf_add(b, c.color_accent)
    u.buf_add(b, c"help script")
    u.buf_add(b, c"\x1b[0m")
    u.buf_add(b, c.color_muted)
    u.buf_add(b, c" for the language.\n")
    u.buf_add(b, c"\x1b[0m")
    u.write_fd(1, u.buf_take(b))
}

fn read_all_stdin() ref u8 = trust {
    val b: mut ref u.Buf = u.buf_new()
    val first: mut bool = true
    for {
        val line: ref u8 = term.read_plain()
        if line == none {
            break
        }
        if !first {
            u.buf_ch(b, 10)
        }
        first = false
        u.buf_add(b, line)
    }
    return u.buf_take(b)
}

fn first_line(src: ref u8) ref u8 = trust {
    val n: i64 = u.s_len(src)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        if @load8(@ptradd(src, i)) == 10 {
            return u.s_substr(src, 0, i)
        }
        i++
    }
    return src
}

fn strip_shebang(src: ref u8) ref u8 = trust {
    if u.s_starts(src, c"#!") {
        val n: i64 = u.s_len(src)
        val i: mut i64 = 0
        for {
            if i >= n {
                break
            }
            if @load8(@ptradd(src, i)) == 10 {
                return u.s_substr(src, i + 1, n)
            }
            i++
        }
        return u.s_dup(c"")
    }
    return src
}

fn startup_files(c: ref cfgmod.Config) ref u.Vec = trust {
    val out: mut ref u.Vec = u.vec_new()
    if u.s_len(c.startup_file) > 0 {
        u.vec_pushp(out, c.startup_file as ref void)
    }
    val default_path: ref u8 = u.path_join(u.path_dir(c.path), c"init.blood")
    if u.file_exists(default_path) {
        u.vec_pushp(out, default_path)
    }
    return out
}

fn run_startup(c: ref cfgmod.Config) void = trust {
    u.scratch_begin()
    val files: ref u.Vec = startup_files(c)
    val i: mut i64 = 0
    for {
        if i >= files.len {
            break
        }
        val path: ref u8 = u.vec_p(files, i) as ref u8
        val st: i32 = script.run_file(path)
        if st != 0 {
            u.write_fd(2, u.s_cat3(c"blood: startup: ", path, c" failed\n"))
        }
        i++
    }
    u.scratch_end()
}

fn run_bloodrc(c: ref cfgmod.Config) void = trust {
    u.scratch_begin()
    if !cfgmod.init_bloodrc(c) {
        u.write_fd(2, c"blood: cannot create .bloodrc\n")
        u.scratch_end()
        return
    }
    val path: ref u8 = cfgmod.bloodrc_path(c)
    if u.file_exists(path) {
        script.run_file(path)
    }
    u.scratch_end()
}

fn prompt_continuation() ref u8 = trust {
    return c"\x1b[90m  … \x1b[0m"
}

fn interactive_loop(c: mut ref cfgmod.Config, h: mut ref histmod.History) i32 = trust {
    val status: mut i64 = 0
    val duration: mut i64 = 0
    val code: mut i32 = 0
    banner(c)
    for {
        if shell.exit_requested() {
            code = shell.exit_code()
            break
        }
        u.scratch_begin()
        shell.reap_jobs()
        val p: prompt.PromptParts = prompt.render_parts(
            c,
            status as i32,
            duration,
            shell.job_count()
        )
        val ed: mut ref term.Editor = term.editor_new(c, h, shell.vars(), shell.aliases())
        val line: ref u8 = term.readline(ed, p.left, p.right)
        term.cooked_mode()
        if line == none {
            if term.was_cancelled(ed) {
                u.interrupt_flag = 0
                u.scratch_end()
                continue
            }
            u.scratch_end()
            break
        }
        if u.s_len(u.s_trim(line)) == 0 {
            u.scratch_end()
            continue
        }
        val trimmed: ref u8 = u.s_trim(line)
        if escape.is_command(trimmed) {
            histmod.history_add(h, trimmed)
            u.interrupt_flag = 0
            val st: i32 = escape.handle(trimmed, c, h)
            status = st as i64
            script.set_external_status(status)
            duration = 0
            if u.script_exit_code >= 0 {
                code = u.script_exit_code as i32
                u.scratch_end()
                break
            }
            if shell.exit_requested() {
                code = shell.exit_code()
                u.scratch_end()
                break
            }
            u.scratch_end()
            continue
        }
        val full: mut ref u8 = u.s_dup(line)
        val is_script: bool = script.looks_like_script(line)
        val block_mode: mut bool = false
        if is_script {
            val t: ref u8 = u.s_trim(line)
            if u.s_len(t) > 0 && @load8(@ptradd(t, u.s_len(t) - 1)) == 58 {
                block_mode = true
            }
        }
        if block_mode {
            for {
                val ced: mut ref term.Editor = term.editor_new(c, h, shell.vars(), shell.aliases())
                val next: ref u8 = term.readline(ced, prompt_continuation(), c"")
                term.cooked_mode()
                if next == none {
                    if term.was_cancelled(ced) {
                        full = u.s_dup(c"")
                    }
                    break
                }
                if u.s_len(u.s_trim(next)) == 0 {
                    break
                }
                full = u.s_cat3(full, c"\n", next)
            }
        } else {
            for {
                if !script.needs_continuation(full) {
                    break
                }
                val ced: mut ref term.Editor = term.editor_new(c, h, shell.vars(), shell.aliases())
                val next: ref u8 = term.readline(ced, prompt_continuation(), c"")
                term.cooked_mode()
                if next == none {
                    if term.was_cancelled(ced) {
                        full = u.s_dup(c"")
                    }
                    break
                }
                if u.s_len(next) == 0 {
                    full = u.s_cat3(full, c"\n", c"")
                } else {
                    full = u.s_cat3(full, c"\n", next)
                }
            }
        }
        if u.s_len(u.s_trim(full)) == 0 {
            u.scratch_end()
            continue
        }
        histmod.history_add(h, full)
        u.interrupt_flag = 0
        val started: i64 = u.now_ms()
        if script.looks_like_script(full) {
            val st: i32 = script.run_interactive(full)
            if st != 0 {
                status = st as i64
            } elif u.script_exit_code >= 0 {
                status = u.script_exit_code
            } else {
                status = script.status_value()
            }
            shell.set_last_status(status as i32)
        } else {
            val st: i32 = shell.run_line(full)
            u.interrupt_flag = 0
            status = st as i64
            script.set_external_status(status)
            if u.script_exit_code >= 0 {
                code = u.script_exit_code as i32
                u.scratch_end()
                break
            }
        }
        duration = u.now_ms() - started
        if shell.exit_requested() {
            code = shell.exit_code()
            u.scratch_end()
            break
        }
        if u.script_exit_code >= 0 {
            code = u.script_exit_code as i32
            u.scratch_end()
            break
        }
        u.scratch_end()
    }
    histmod.history_save(h)
    return code
}

pub fn main() i32 = trust {
    val av: list[ref u8] = @args()
    val fs_result = flags.new(c"blood", c"Blood shell and scripting language")
    val fs: mut flags.FlagSet = @zeroed
    match fs_result {
        ok v => {
            fs = v
        }
        err _ => {
            u.write_fd(2, c"blood: cannot initialize flags\n")
            return 1
        }
    }
    val show_version: mut bool = false
    val do_init: mut bool = false
    val do_login: mut bool = false
    val command: mut ref u8 = none
    flags.bool_var(fs, c"version", c"v", @addr(show_version), c"print the version")
    flags.bool_var(fs, c"init", none, @addr(do_init), c"write a default configuration file")
    flags.bool_var(fs, c"login", none, @addr(do_login), c"initialize a login-shell environment")
    flags.string_var(fs, c"c", none, @addr(command), c"execute a command or script and exit")
    flags.stop_at_positional(fs, true)
    match flags.parse(fs, av) {
        ok _ => {}
        err e => {
            if flags.is_help(e) {
                print_help()
                flags.destroy(fs)
                return 0
            }
            u.write_fd(2, u.s_cat3(c"blood: ", flags.message(e), c"\n"))
            flags.usage_err(fs)
            flags.destroy(fs)
            return 2
        }
    }
    val positional: list[ref u8] = flags.args(fs)
    val first: ref u8 = arg_at(positional, 0)
    val all_args: ref u.Vec = list_to_vec(positional, 0)
    flags.destroy(fs)
    if show_version {
        print_version()
        return 0
    }
    val early_login: bool = do_login || login_argv(av)
    if early_login {
        u.scratch_begin()
        loginmod.init(true)
        u.scratch_end()
    }
    u.scratch_begin()
    val c: mut ref cfgmod.Config = cfgmod.load_config()
    u.scratch_end()
    if do_init {
        if cfgmod.init_config_file(c.path) {
            u.stdout_ln(u.s_cat(c"wrote ", c.path))
            return 0
        }
        u.write_fd(2, u.s_cat3(c"blood: cannot write ", c.path, c"\n"))
        return 1
    }
    if !early_login {
        u.scratch_begin()
        loginmod.init(c.login != 0)
        u.scratch_end()
    }
    u.scratch_begin()
    ensure_config_dirs(c)
    u.scratch_end()
    ex.signal_ignore(3)
    ex.signal_handler(2, on_interrupt)
    ex.signal_ignore(15)
    ex.signal_ignore(ex.sig_tstp())
    val h: mut ref histmod.History = histmod.history_new(c)
    u.scratch_begin()
    histmod.history_load(h)
    u.scratch_end()
    shell.shell_init(c, h, false)
    script.script_init()
    install_hooks()
    term.init_terminal()
    if command != none {
        val rest: ref u.Vec = vec_slice(all_args, 0)
        script.set_args(rest)
        u.scratch_begin()
        val st: mut i32 = 0
        if script.looks_like_script(command) {
            st = script.run_text(strip_shebang(command), false, c"-c")
        } else {
            st = shell.run_line(command)
        }
        term.cooked_mode()
        if u.script_exit_code >= 0 {
            val rc: i32 = u.script_exit_code as i32
            u.scratch_end()
            return rc
        }
        u.scratch_end()
        return st
    }
    if first != none {
        val rest: ref u.Vec = vec_slice(all_args, 1)
        script.set_args(rest)
        u.scratch_begin()
        val src: ref u8 = u.read_file(first)
        if src == none {
            u.write_fd(2, u.s_cat3(c"blood: ", first, c": no such script\n"))
            u.scratch_end()
            return 1
        }
        val st: i32 = script.run_file(first)
        if u.script_exit_code >= 0 {
            val rc: i32 = u.script_exit_code as i32
            u.scratch_end()
            return rc
        }
        u.scratch_end()
        return st
    }
    val interactive: bool = term.have_tty()
    if !interactive {
        u.scratch_begin()
        val src: ref u8 = read_all_stdin()
        if u.s_len(u.s_trim(src)) == 0 {
            u.scratch_end()
            return 0
        }
        if script.looks_like_script(first_line(src)) {
            val st: i32 = script.run_text(strip_shebang(src), false, c"stdin")
            u.scratch_end()
            return st
        }
        val st: i32 = shell.run_line(src)
        u.scratch_end()
        return st
    }
    histmod.history_ensure_file(h)
    shell.shell_init(c, h, true)
    run_bloodrc(c)
    run_startup(c)
    val code: i32 = interactive_loop(c, h)
    term.cooked_mode()
    ex.signal_default(2)
    ex.signal_default(3)
    ex.signal_default(15)
    ex.signal_default(ex.sig_tstp())
    return code
}
