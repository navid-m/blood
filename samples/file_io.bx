# Blood sample: read, write and append text files.

var path = "/tmp/blood_sample_file_io.txt"
std.write_file(path, "first line\nsecond line\n")

say("contents:")
say(std.read_file(path).strip())

std.append_file(path, "third line\n")
var lines = std.read_file(path).strip().split("\n")
say("lines: " + std.str(std.len(lines)))
