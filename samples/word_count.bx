# Blood sample: count word frequencies with a dictionary.

var text   = "the quick brown fox jumps over the lazy dog the fox"
var counts = {}

for word in text.split(" ") {
    word = word.strip()
    if word == "" {
        continue
    }
    if word in counts {
        counts[word] += 1
    } else {
        counts[word] = 1
    }
}

var keys = counts.keys()
keys.sort()
for key in keys {
    say(key + ": " + str(counts[key]))
}
